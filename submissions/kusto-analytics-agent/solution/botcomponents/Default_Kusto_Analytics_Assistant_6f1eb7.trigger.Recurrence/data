kind: ExternalTriggerConfiguration
externalTriggerSource:
  kind: AgentRecurrenceTrigger
  callbackMessage:
    segments:
      - kind: StaticSegment
        value: |-
          Mail me summary of top 10 rows for:
          Cluster: https://<cluster>.<region>.kusto.windows.net
          Database: <database>
          Table: <table>

      - kind: StaticSegment
        value: "@{triggerBody()}"

  inputs:
    - name: frequency
      displayName: Frequency
      description: How often the trigger fires (e.g., Hour, Day, Week).
      value:
        kind: ValueReference
        type: "{\"type\":\"string\"}"
        defaultValue: "\"Day\""

      isValueOverridable: true

    - name: interval
      displayName: Interval
      description: The number of frequency units between each firing.
      value:
        kind: ValueReference
        type: "{\"type\":\"string\"}"
        defaultValue: "\"1\""

      isValueOverridable: true

    - name: startTime
      displayName: Start time
      description: When the recurrence begins.
      value:
        kind: ValueReference
        type: "{\"type\":\"string\"}"
        defaultValue: "\"2026-10-21T16:52:00Z\""

      isValueOverridable: true

    - name: timeZone
      displayName: Time zone
      description: Windows time zone id used to interpret start time and schedule.
      value:
        kind: ValueReference
        type: "{\"type\":\"string\"}"
        defaultValue: "\"India Standard Time\""

      isValueOverridable: true

  authMode: Invoker