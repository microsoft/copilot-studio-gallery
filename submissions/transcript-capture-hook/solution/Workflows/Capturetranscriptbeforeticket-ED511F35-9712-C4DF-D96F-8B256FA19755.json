                          "body/timerangetype": "3",
                          "body/query": "let ConversationId = base64_decode_tostring(\"@{base64(coalesce(triggerBody()?['metadata']?['conversationId'],''))}\");\nlet HookAgentId = base64_decode_tostring(\"@{base64(coalesce(triggerBody()?['metadata']?['agentId'],''))}\");\nlet HookEvent = base64_decode_tostring(\"@{base64(coalesce(triggerBody()?['event'],''))}\");\nlet CaptureTime = todatetime(base64_decode_tostring(\"@{base64(coalesce(triggerBody()?['timestamp'],''))}\"));\nlet Events = dependencies\n| where isnotempty(ConversationId) and HookEvent == 'PreTool' and isnotempty(HookAgentId)\n| where timestamp > ago(90d) and timestamp <= CaptureTime\n| where tostring(customDimensions['env.id']) == 'REPLACE_WITH_ENVIRONMENT_ID'\n| where tostring(customDimensions['gen_ai.conversation.id']) == ConversationId\n| extend InputMessages = parse_json(tostring(customDimensions['gen_ai.input.messages'])), OutputMessages = parse_json(tostring(customDimensions['gen_ai.output.messages']))\n| project Timestamp=timestamp, TraceId=operation_Id, SpanId=id, InputMessages, OutputMessages;\nunion\n(Events | mv-expand with_itemindex=MessageIndex Message=InputMessages | extend Sequence=0),\n(Events | mv-expand with_itemindex=MessageIndex Message=OutputMessages | extend Sequence=1)\n| mv-expand with_itemindex=PartIndex Part=Message.parts\n| extend Role=tostring(Message.role), Content=tostring(Part.content)\n| where Role in ('user','assistant') and tostring(Part.type) == 'text' and isnotempty(Content)\n| order by Timestamp asc, Sequence asc, TraceId asc, SpanId asc, MessageIndex asc, PartIndex asc\n| take 501\n| project Timestamp, Role, Content, ConversationId, TraceId"
