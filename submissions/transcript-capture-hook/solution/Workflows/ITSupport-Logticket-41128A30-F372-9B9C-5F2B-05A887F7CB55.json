                          "body": {
                            "ticketId": "@concat('DEMO-',substring(guid(),0,8))",
                            "status": "Simulated",
                            "transcriptAttached": "@and(not(empty(triggerBody()?['transcript'])),not(equals(triggerBody()?['transcript'],'[]')),not(empty(triggerBody()?['conversationId'])))",
                            "message": "@if(and(not(empty(triggerBody()?['transcript'])),not(equals(triggerBody()?['transcript'],'[]')),not(empty(triggerBody()?['conversationId']))),'Demo ticket logged with a best-effort telemetry transcript; completeness is not guaranteed. No internal ticketing system was called.','Demo ticket logged. Transcript was not captured or could not be associated with a conversation ID. No internal ticketing system was called.')"
