kind: WorkflowTool
workflowId: 41128a30-f372-9b9c-5f2b-05a887f7cb55
toolInputs:
  - name: title
    displayName: title
    description: Short summary of the IT issue.

  - name: description
    displayName: description
    description: Affected device or service, impact, and troubleshooting attempted.

  - name: transcript
    displayName: transcript
    description: Hook-provided telemetry transcript as JSON text. Leave empty. Never reconstruct or invent it.

  - name: conversationId
    displayName: conversationId
    description: Conversation ID provided by the hook. Leave empty.

toolOutputs:
  - name: ticketId
    displayName: ticketId

  - name: status
    displayName: status

  - name: transcriptAttached
    displayName: transcriptAttached

  - name: message
    displayName: message

connectionProperties:
  $kind: ConnectionProperties
  diagnostics:
  mode: Invoker