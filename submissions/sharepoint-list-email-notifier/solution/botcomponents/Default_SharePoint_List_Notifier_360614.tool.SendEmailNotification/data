kind: TaskDialog
modelDisplayName: Send email notification
modelDescription: Sends an HTML email about the retrieved SharePoint item to the resolved current user.
inputs:
  - kind: AutomaticTaskInput
    propertyName: To
    description: The email address returned by Resolve current user.
    entity: StringPrebuiltEntity
    shouldPromptUser: false
  - kind: AutomaticTaskInput
    propertyName: Subject
    description: A concise subject with the item status and title.
    entity: StringPrebuiltEntity
    shouldPromptUser: false
  - kind: AutomaticTaskInput
    propertyName: Body
    description: The HTML item summary, including non-empty fields and the direct SharePoint link.
    entity: StringPrebuiltEntity
    shouldPromptUser: false
outputs:
  - propertyName: Response
action:
  kind: InvokeConnectorTaskAction
  connectionReference: a3p_sharedoffice365_360614
  connectionProperties:
    mode: Invoker
  operationId: SendEmailV2
outputMode: All
