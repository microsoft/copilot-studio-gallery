kind: TaskDialog
modelDisplayName: Get SharePoint list item
modelDescription: Retrieves the authoritative current values for one SharePoint list item. Use the configured site URL, list ID, and triggering item ID.
inputs:
  - kind: AutomaticTaskInput
    propertyName: dataset
    description: The configured SharePoint site URL from the trigger context.
    entity: StringPrebuiltEntity
    shouldPromptUser: false
  - kind: AutomaticTaskInput
    propertyName: table
    description: The configured SharePoint list ID from the trigger context.
    entity: StringPrebuiltEntity
    shouldPromptUser: false
  - kind: AutomaticTaskInput
    propertyName: id
    description: The numeric ID of the item from the trigger context.
    entity: NumberPrebuiltEntity
    shouldPromptUser: false
outputs:
  - propertyName: Response
action:
  kind: InvokeConnectorTaskAction
  connectionReference: a3p_sharedsharepointonline_b880e
  connectionProperties:
    mode: Invoker
  operationId: GetItem
outputMode: All
