kind: TaskDialog
modelDisplayName: Send Teams notification
modelDescription: Posts an HTML notification about the retrieved SharePoint item in a one-to-one chat with the resolved current user.
inputs:
  - kind: ManualTaskInput
    propertyName: poster
    value: Flow bot
  - kind: ManualTaskInput
    propertyName: location
    value: Chat with Flow bot
  - kind: AutomaticTaskInput
    propertyName: body/recipient
    description: The email address or user principal name returned by Resolve current user.
    entity: StringPrebuiltEntity
    shouldPromptUser: false
  - kind: AutomaticTaskInput
    propertyName: body/messageBody
    description: The HTML notification body with the item summary and direct SharePoint link.
    entity: StringPrebuiltEntity
    shouldPromptUser: false
outputs:
  - propertyName: Response
action:
  kind: InvokeConnectorTaskAction
  connectionReference: a3p_sharedteams_360614
  connectionProperties:
    mode: Invoker
  operationId: PostMessageToConversation
outputMode: All
