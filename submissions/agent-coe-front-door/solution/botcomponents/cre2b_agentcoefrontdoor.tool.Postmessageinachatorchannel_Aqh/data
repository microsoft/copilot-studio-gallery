kind: ConnectorTool
authMode: Invoker
connectionReference: cre2b_agentcoefrontdoor.cr.shared_teams
connectorId: /providers/Microsoft.PowerApps/apis/shared_teams
operationId: PostMessageToConversation
toolInputs:
  - name: poster
    value:
      kind: ValueReference
      type: "{\"type\":\"string\"}"
      defaultValue: "\"Flow bot\""

  - name: location
    value:
      kind: ValueReference
      type: "{\"type\":\"string\"}"
      defaultValue: "\"Chat with Flow bot\""

  - name: body.recipient
    displayName: Recipient
    description: Enter a name or email address

  - name: body.messageBody
    displayName: Message
    description: Add message

  - name: body.isAlert
    displayName: IsAlert
    description: If the message will be shown in the activity feed

  - name: body.feedbackLoopEnabled
    displayName: FeedbackLoopEnabled
    description: If the message will have feedback loop enabled.