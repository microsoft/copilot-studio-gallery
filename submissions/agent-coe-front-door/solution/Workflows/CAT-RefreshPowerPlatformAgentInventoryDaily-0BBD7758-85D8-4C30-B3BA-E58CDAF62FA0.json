      "actions": {
        "Initialize_RefreshStarted": {
          "runAfter": {},
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "RefreshStarted",
                "type": "string",
                "value": "@utcNow()"
              }
            ]
          }
        },
        "Initialize_SkipToken": {
          "runAfter": {
            "Initialize_RefreshStarted": [
