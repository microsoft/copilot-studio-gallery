            ]
          },
          "type": "Until",
          "expression": "@empty(variables('SkipToken'))",
          "limit": {
            "count": 1000,
            "timeout": "P1D"
          },
          "actions": {
            "Query_agent_page": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "api-version": "2024-10-01",
                  "body/TableName": "PowerPlatformResources",
                  "body/Clauses": [
                    {
                      "$type": "where",
                      "FieldName": "type",
                      "Operator": "in~",
                      "Values": [
                        "'microsoft.copilotstudio/agents'"
                      ]
                    }
                  ],
                  "body/Options/Top": 100,
                  "body/Options/SkipToken": "@variables('SkipToken')"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_cat-ppinventory",
                  "operationId": "QueryCopilotStudioAgents",
                  "connectionName": "shared_cat-ppinventory"
                }
              }
            },
            "Validate_page": {
              "runAfter": {
                "Query_agent_page": [
                  "Succeeded"
                ]
              },
              "type": "ParseJson",
              "inputs": {
                "content": "@body('Query_agent_page')",
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "name",
                          "properties"
                        ],
                        "properties": {
                          "name": {
                            "type": "string",
                            "minLength": 1
                          },
                          "properties": {
                            "type": "object",
                            "required": [
                              "environmentId"
                            ],
                            "properties": {
                              "environmentId": {
                                "type": "string",
                                "minLength": 1
                              }
                            }
                          }
                        }
                      }
                    },
                    "skipToken": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              }
            },
            "Upsert_agent_page": {
              "runAfter": {
                "Validate_page": [
                  "Succeeded"
                ]
              },
              "type": "Foreach",
              "foreach": "@body('Validate_page')?['data']",
              "actions": {
                "Find_existing_agent": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "parameters": {
                      "entityName": "cat_tenantagentinventories",
                      "$select": "cat_tenantagentinventoryid",
                      "$filter": "@concat('cat_resourceid eq ''', replace(concat('pp:', item()?['properties']?['environmentId'], ':', item()?['name']), '''', ''''''), '''')",
                      "$top": 1
                    },
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                      "operationId": "ListRecords",
                      "connectionName": "shared_commondataserviceforapps"
                    }
                  }
                },
                "Create_or_update_agent": {
                  "runAfter": {
                    "Find_existing_agent": [
                      "Succeeded"
                    ]
                  },
                  "type": "If",
                  "expression": {
                    "and": [
                      {
                        "equals": [
                          "@length(body('Find_existing_agent')?['value'])",
                          0
                        ]
                      }
                    ]
                  },
                  "actions": {
                    "Create_agent": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "parameters": {
                          "entityName": "cat_tenantagentinventories",
                          "item/cat_agentname": "@substring(coalesce(item()?['properties']?['displayName'], item()?['name']), 0, if(greater(length(coalesce(item()?['properties']?['displayName'], item()?['name'])), 850), 850, length(coalesce(item()?['properties']?['displayName'], item()?['name']))))",
                          "item/cat_resourceid": "@concat('pp:', item()?['properties']?['environmentId'], ':', item()?['name'])",
                          "item/cat_agenttype": "Power Platform Inventory API",
                          "item/cat_lastseenon": "@utcNow()",
                          "item/cat_environmentid": "@item()?['properties']?['environmentId']",
                          "item/cat_location": "@item()?['location']",
                          "item/cat_platform": "@item()?['properties']?['createdIn']",
                          "item/cat_schemaname": "@item()?['properties']?['schemaName']",
                          "item/cat_sourcecreatedon": "@item()?['properties']?['createdAt']",
                          "item/cat_appid": "@item()?['properties']?['entraAppId']",
                          "item/cat_isquarantined": "@not(equals(item()?['properties']?['isQuarantined'], false))",
                          "item/cat_authentication": "@item()?['properties']?['authentication']",
                          "item/cat_channels": "@if(empty(item()?['properties']?['channels']), '', join(item()?['properties']?['channels'], '; '))",
                          "item/cat_publicationstatus": "@if(empty(item()?['properties']?['lastPublishedAt']), 'Draft', 'Published')",
                          "item/cat_searchtext": "@toLower(concat(coalesce(item()?['properties']?['displayName'], ''), ' ', coalesce(item()?['properties']?['schemaName'], ''), ' ', coalesce(item()?['properties']?['createdIn'], '')))"
                        },
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                          "operationId": "CreateRecord",
                          "connectionName": "shared_commondataserviceforapps"
                        }
                      }
                    }
                  },
                  "else": {
                    "actions": {
                      "Update_agent": {
                        "type": "OpenApiConnection",
                        "inputs": {
                          "parameters": {
                            "entityName": "cat_tenantagentinventories",
                            "recordId": "@first(body('Find_existing_agent')?['value'])?['cat_tenantagentinventoryid']",
                            "item/cat_agentname": "@substring(coalesce(item()?['properties']?['displayName'], item()?['name']), 0, if(greater(length(coalesce(item()?['properties']?['displayName'], item()?['name'])), 850), 850, length(coalesce(item()?['properties']?['displayName'], item()?['name']))))",
                            "item/cat_agenttype": "Power Platform Inventory API",
                            "item/cat_lastseenon": "@utcNow()",
                            "item/cat_environmentid": "@item()?['properties']?['environmentId']",
                            "item/cat_location": "@item()?['location']",
                            "item/cat_platform": "@item()?['properties']?['createdIn']",
                            "item/cat_schemaname": "@item()?['properties']?['schemaName']",
                            "item/cat_sourcecreatedon": "@item()?['properties']?['createdAt']",
                            "item/cat_appid": "@item()?['properties']?['entraAppId']",
                            "item/cat_isquarantined": "@not(equals(item()?['properties']?['isQuarantined'], false))",
                            "item/cat_authentication": "@item()?['properties']?['authentication']",
                            "item/cat_channels": "@if(empty(item()?['properties']?['channels']), '', join(item()?['properties']?['channels'], '; '))",
                            "item/cat_publicationstatus": "@if(empty(item()?['properties']?['lastPublishedAt']), 'Draft', 'Published')",
                            "item/cat_searchtext": "@toLower(concat(coalesce(item()?['properties']?['displayName'], ''), ' ', coalesce(item()?['properties']?['schemaName'], ''), ' ', coalesce(item()?['properties']?['createdIn'], '')))"
                          },
                          "host": {
                            "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                            "operationId": "UpdateRecord",
                            "connectionName": "shared_commondataserviceforapps"
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "Set_SkipToken": {
              "runAfter": {
                "Upsert_agent_page": [
                  "Succeeded"
                ]
              },
              "type": "SetVariable",
              "inputs": {
                "name": "SkipToken",
                "value": "@coalesce(body('Validate_page')?['skipToken'], '')"
              }
            }
          }
        },
        "Check_complete": {
          "runAfter": {
            "Process_All_Power_Platform_Pages": [
              "Succeeded"
            ]
          },
          "type": "If",
          "expression": {
            "and": [
              {
                "equals": [
                  "@empty(variables('SkipToken'))",
                  true
                ]
              }
            ]
          },
          "actions": {},
          "else": {
            "actions": {
              "Incomplete_inventory": {
                "type": "Terminate",
                "inputs": {
                  "runStatus": "Failed",
                  "runError": {
                    "code": "IncompleteInventory",
                    "message": "Pagination limit reached; stale cleanup skipped."
                  }
                }
              }
            }
          }
        },
        "Find_stale_Power_Platform_agents": {
          "runAfter": {
            "Check_complete": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "entityName": "cat_tenantagentinventories",
              "$select": "cat_tenantagentinventoryid",
              "$filter": "@concat('cat_agenttype eq ''Power Platform Inventory API'' and cat_lastseenon lt ', variables('RefreshStarted'))"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "connectionName": "shared_commondataserviceforapps"
            }
          },
          "runtimeConfiguration": {
            "paginationPolicy": {
              "minimumItemCount": 100000
            }
          }
        },
        "Remove_stale_Power_Platform_agents": {
          "runAfter": {
            "Find_stale_Power_Platform_agents": [
              "Succeeded"
            ]
          },
          "type": "Foreach",
          "foreach": "@body('Find_stale_Power_Platform_agents')?['value']",
          "actions": {
            "Delete_stale_agent": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "entityName": "cat_tenantagentinventories",
                  "recordId": "@item()?['cat_tenantagentinventoryid']"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                  "operationId": "DeleteRecord",
                  "connectionName": "shared_commondataserviceforapps"
                }
              }
            }
          }
        }
      }
    },
