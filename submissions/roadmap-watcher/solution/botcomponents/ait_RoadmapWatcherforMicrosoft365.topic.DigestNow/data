kind: AdaptiveDialog
beginDialog:
  kind: OnRedirect
  id: main
  actions:
    - kind: SendActivity
      id: sendWorking
      activity: Building your digest. This can take a few seconds.

    - kind: InvokeFlowAction
      id: callDigestNow
      input:
        binding:
          aadObjectId: =System.User.Id
          displayName: =System.User.DisplayName
          upn: =System.User.PrincipalName

      output:
        binding:
          message: Topic.Message

      flowId: d7666ac8-cde8-f111-84ea-000d3ad895be

    - kind: SendActivity
      id: sendDigestResult
      activity: "{Topic.Message}"

inputType: {}
outputType: {}