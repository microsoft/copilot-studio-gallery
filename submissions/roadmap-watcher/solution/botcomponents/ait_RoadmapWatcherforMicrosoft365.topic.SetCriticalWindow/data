kind: AdaptiveDialog
beginDialog:
  kind: OnRedirect
  id: main
  actions:
    - kind: ConditionGroup
      id: checkArgs
      conditions:
        - id: badArgs
          condition: =Not(IsMatch(Topic.Args, "^\d{1,2}$")) || Value(Topic.Args) < 1 || Value(Topic.Args) > 24
          actions:
            - kind: SendActivity
              id: usage
              activity: "Usage: `/critical <months>`, a whole number from 1 to 24. Retirements within this many months show as Critical. Example: /critical 3"

            - kind: EndDialog
              id: endBadArgs

    - kind: InvokeFlowAction
      id: callSetCritical
      input:
        binding:
          aadObjectId: =System.User.Id
          displayName: =System.User.DisplayName
          months: =Value(Topic.Args)
          upn: =System.User.PrincipalName

      output:
        binding:
          message: Topic.Message

      flowId: bbf65cf4-4ec7-f111-a05a-000d3ad895be

    - kind: SendActivity
      id: sendResult
      activity: "{Topic.Message}"

inputType:
  properties:
    Args:
      displayName: Args
      description: Months after /critical
      type: String

outputType: {}