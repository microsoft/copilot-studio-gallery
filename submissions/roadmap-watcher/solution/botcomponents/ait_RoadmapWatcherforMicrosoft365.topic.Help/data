kind: AdaptiveDialog
beginDialog:
  kind: OnRedirect
  id: main
  actions:
    - kind: SendActivity
      id: sendHelp
      activity: |-
        **Roadmap Watcher commands** (the / is optional)
        - /mysettings: your settings card: pick packs and products, schedule, look-ahead, pause
        - /help: this list
        - /products [text]: catalog products, filtered by text; /products azure lists the Azure products
        - /packs: product packs and their codes
        - /add [names]: follow products or packs, comma-separated (also /subscribe)
        - /remove [names] or /remove all: stop following (also /unsubscribe)
        - /mysubs: what you follow
        - /lookahead [1-24]: how many months ahead your digest looks
        - /critical [1-24]: retirements within this many months count as Critical
        - /frequency daily, /frequency weekly [day], /frequency monthly: digest schedule
        - /pause and /resume: stop or restart digests; subscriptions are kept
        - /digest: send your digest now
        - /details [id]: the full Microsoft 365 roadmap item or Azure update

        Example: /add security, teams

inputType: {}
outputType: {}