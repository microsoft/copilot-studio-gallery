kind: AdaptiveDialog
beginDialog:
  kind: OnRedirect
  id: main
  actions:
    - kind: InvokeFlowAction
      id: callProducts
      input:
        binding:
          args: =Topic.Args

      output:
        binding:
          message: Topic.Message

      flowId: d19024ca-dee8-f111-84ea-000d3ad895be

    - kind: SendActivity
      id: sendProducts
      activity: "{Topic.Message}"

inputType:
  properties:
    Args:
      displayName: Args
      description: Filter text after /products; may be empty
      type: String

outputType: {}