{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "ait_Dataverse"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "type": "Object",
          "defaultValue": {}
        },
        "$authentication": {
          "type": "SecureObject",
          "defaultValue": {}
        }
      },
      "triggers": {
        "manual": {
          "type": "Request",
          "kind": "Skills",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "aadObjectId": {
                  "title": "aadObjectId",
                  "type": "string",
                  "description": "Entra object ID of the user (System.User.Id)",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                },
                "upn": {
                  "title": "upn",
                  "type": "string",
                  "description": "User principal name (System.User.PrincipalName)",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                },
                "displayName": {
                  "title": "displayName",
                  "type": "string",
                  "description": "Display name (System.User.DisplayName)",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                },
                "frequency": {
                  "title": "frequency",
                  "type": "string",
                  "description": "Daily, Weekly or Monthly",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                },
                "weekday": {
                  "title": "weekday",
                  "type": "number",
                  "description": "0 = Monday ... 6 = Sunday; used when frequency is Weekly",
                  "x-ms-content-hint": "NUMBER",
                  "x-ms-dynamically-added": true
                }
              },
              "required": [
                "aadObjectId",
                "frequency",
                "weekday"
              ]
            }
          }
        }
      },
      "actions": {
        "Get_settings": {
          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "environmentvariabledefinitions",
              "$select": "schemaname,defaultvalue",
              "$filter": "startswith(schemaname, 'ait_')",
              "$expand": "environmentvariabledefinition_environmentvariablevalue($select=value)"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Select_settings": {
          "runAfter": {
            "Get_settings": [
              "Succeeded"
            ]
          },
          "type": "Select",
          "inputs": {
            "from": "@body('Get_settings')?['value']",
            "select": "@concat('\"', item()?['schemaname'], '\":\"', replace(replace(coalesce(first(item()?['environmentvariabledefinition_environmentvariablevalue'])?['value'], item()?['defaultvalue'], ''), '\\', '\\\\'), '\"', '\\\"'), '\"')"
          }
        },
        "Settings": {
          "runAfter": {
            "Select_settings": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@json(concat('{', join(body('Select_settings'), ','), '}'))"
        },
        "Init_subscriber": {
          "runAfter": {
            "Settings": [
              "Succeeded"
            ]
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "Subscriber",
                "type": "object",
                "value": {}
              },
              {
                "name": "IsNewSubscriber",
                "type": "boolean",
                "value": false
              }
            ]
          }
        },
        "Find_subscriber": {
          "runAfter": {
            "Init_subscriber": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "ait_subscribers",
              "$filter": "ait_aadobjectid eq '@{replace(triggerBody()?['aadObjectId'], '''', '''''')}'",
              "$top": 1
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Check_subscriber": {
          "runAfter": {
            "Find_subscriber": [
              "Succeeded"
            ]
          },
          "type": "If",
          "expression": "@empty(body('Find_subscriber')?['value'])",
          "actions": {
            "Create_subscriber": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "CreateRecord",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "ait_subscribers",
                  "item/ait_displayname": "@{take(if(empty(triggerBody()?['displayName']), if(empty(triggerBody()?['upn']), triggerBody()?['aadObjectId'], triggerBody()?['upn']), triggerBody()?['displayName']), 100)}",
                  "item/ait_aadobjectid": "@triggerBody()?['aadObjectId']",
                  "item/ait_upn": "@triggerBody()?['upn']",
                  "item/ait_lookaheadmonths": "@int(outputs('Settings')?['ait_DefaultLookaheadMonths'])",
                  "item/ait_criticalwindowmonths": "@int(outputs('Settings')?['ait_DefaultCriticalWindowMonths'])",
                  "item/ait_frequency": 748120001,
                  "item/ait_weekday": 748120000,
                  "item/ait_ispaused": false,
                  "item/ait_sendemptydigest": "@contains(createArray('yes', 'true', '1'), toLower(string(outputs('Settings')?['ait_SendEmptyDigest'])))"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Set_new_subscriber": {
              "runAfter": {
                "Create_subscriber": [
                  "Succeeded"
                ]
              },
              "type": "SetVariable",
              "inputs": {
                "name": "Subscriber",
                "value": "@body('Create_subscriber')"
              }
            },
            "Set_is_new": {
              "runAfter": {
                "Set_new_subscriber": [
                  "Succeeded"
                ]
              },
              "type": "SetVariable",
              "inputs": {
                "name": "IsNewSubscriber",
                "value": true
              }
            }
          },
          "else": {
            "actions": {
              "Set_existing_subscriber": {
                "runAfter": {},
                "type": "SetVariable",
                "inputs": {
                  "name": "Subscriber",
                  "value": "@first(body('Find_subscriber')?['value'])"
                }
              }
            }
          }
        },
        "Followed_condition": {
          "runAfter": {
            "Check_subscriber": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "(ait_product_subscription/any(s: s/_ait_subscriberid_value eq @{variables('Subscriber')?['ait_subscriberid']}) or ait_pack_product/any(p: p/ait_isactive eq true and p/ait_pack_subscription/any(s: s/_ait_subscriberid_value eq @{variables('Subscriber')?['ait_subscriberid']})))"
        },
        "Next_due_base": {
          "runAfter": {
            "Due_from": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@if(equals(outputs('Frequency'), 'Daily'), addHours(startOfDay(outputs('Due_from')), outputs('Hour')), if(equals(outputs('Frequency'), 'Weekly'), addHours(addDays(startOfDay(outputs('Due_from')), mod(add(sub(mod(add(outputs('Weekday'), 1), 7), dayOfWeek(outputs('Due_from'))), 7), 7)), outputs('Hour')), addHours(startOfMonth(outputs('Due_from')), outputs('Hour'))))"
        },
        "Next_due": {
          "runAfter": {
            "Next_due_base": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@if(greater(ticks(outputs('Next_due_base')), ticks(outputs('Due_from'))), outputs('Next_due_base'), if(equals(outputs('Frequency'), 'Daily'), addDays(outputs('Next_due_base'), 1), if(equals(outputs('Frequency'), 'Weekly'), addDays(outputs('Next_due_base'), 7), addHours(startOfMonth(addDays(startOfMonth(outputs('Due_from')), 32)), outputs('Hour')))))"
        },
        "Frequency": {
          "runAfter": {
            "Followed_condition": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@if(equals(triggerBody()?['frequency'], 'Daily'), 'Daily', if(equals(triggerBody()?['frequency'], 'Monthly'), 'Monthly', 'Weekly'))"
        },
        "Weekday": {
          "runAfter": {
            "Frequency": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@if(equals(outputs('Frequency'), 'Weekly'), min(max(int(coalesce(triggerBody()?['weekday'], 0)), 0), 6), sub(coalesce(variables('Subscriber')?['ait_weekday'], 748120000), 748120000))"
        },
        "Hour": {
          "runAfter": {
            "Weekday": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@int(outputs('Settings')?['ait_DeliveryHourUtc'])"
        },
        "Due_from": {
          "runAfter": {
            "Hour": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@utcNow()"
        },
        "Update_subscriber": {
          "runAfter": {
            "Next_due": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "UpdateRecord",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "ait_subscribers",
              "recordId": "@variables('Subscriber')?['ait_subscriberid']",
              "item/ait_frequency": "@if(equals(outputs('Frequency'), 'Daily'), 748120000, if(equals(outputs('Frequency'), 'Monthly'), 748120002, 748120001))",
              "item/ait_weekday": "@add(748120000, outputs('Weekday'))",
              "item/ait_nextdueon": "@outputs('Next_due')"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Reply": {
          "runAfter": {
            "Update_subscriber": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": {
            "message": "Digests now arrive @{if(equals(outputs('Frequency'), 'Daily'), 'daily', if(equals(outputs('Frequency'), 'Monthly'), 'monthly on the 1st', concat('weekly on ', createArray('Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday')[outputs('Weekday')])))} at @{formatNumber(outputs('Hour'), '00')}:00 UTC. Next one: @{formatDateTime(outputs('Next_due'), 'yyyy-MM-dd HH:mm')} UTC.@{if(equals(variables('Subscriber')?['ait_ispaused'], true), ' Your digests are paused; type /resume to restart them.', '')}"
          }
        },
        "Respond_to_the_agent": {
          "runAfter": {
            "Reply": [
              "Succeeded"
            ]
          },
          "type": "Response",
          "kind": "Skills",
          "inputs": {
            "statusCode": 200,
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "title": "message",
                  "description": "",
                  "type": "string",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                }
              },
              "additionalProperties": {}
            },
            "body": {
              "message": "@{outputs('Reply')?['message']}"
            }
          }
        },
        "Respond_with_error": {
          "runAfter": {
            "Reply": [
              "Failed",
              "Skipped",
              "TimedOut"
            ]
          },
          "type": "Response",
          "kind": "Skills",
          "inputs": {
            "statusCode": 200,
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "title": "message",
                  "description": "",
                  "type": "string",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                }
              },
              "additionalProperties": {}
            },
            "body": {
              "message": "Sorry, something went wrong on my side. Please try again in a few minutes."
            }
          }
        }
      }
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}