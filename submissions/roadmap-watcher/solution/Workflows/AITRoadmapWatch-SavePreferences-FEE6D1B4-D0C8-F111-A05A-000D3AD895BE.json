{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "ait_Dataverse"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "type": "Object",
          "defaultValue": {}
        },
        "$authentication": {
          "type": "SecureObject",
          "defaultValue": {}
        }
      },
      "triggers": {
        "manual": {
          "type": "Request",
          "kind": "Skills",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "aadObjectId": {
                  "title": "aadObjectId",
                  "type": "string",
                  "description": "Entra object ID of the user (System.User.Id)",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                },
                "upn": {
                  "title": "upn",
                  "type": "string",
                  "description": "User principal name (System.User.PrincipalName)",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                },
                "displayName": {
                  "title": "displayName",
                  "type": "string",
                  "description": "Display name (System.User.DisplayName)",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                },
                "packs": {
                  "title": "packs",
                  "type": "string",
                  "description": "Card inputs packs and azurePacks: comma-separated pack codes",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                },
                "products": {
                  "title": "products",
                  "type": "string",
                  "description": "Card inputs products and azureProducts: comma-separated product IDs",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                },
                "frequency": {
                  "title": "frequency",
                  "type": "string",
                  "description": "Card input frequency: Daily, Weekly or Monthly",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                },
                "weekday": {
                  "title": "weekday",
                  "type": "string",
                  "description": "Card input weekday: 0 = Monday ... 6 = Sunday",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                },
                "lookahead": {
                  "title": "lookahead",
                  "type": "string",
                  "description": "Card input lookahead: months, 1-24",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                },
                "critical": {
                  "title": "critical",
                  "type": "string",
                  "description": "Card input critical: months, 1-24",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                },
                "paused": {
                  "title": "paused",
                  "type": "string",
                  "description": "Card input paused: true or false",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                },
                "sendEmpty": {
                  "title": "sendEmpty",
                  "type": "string",
                  "description": "Card input sendEmpty: true or false",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                },
                "stamp": {
                  "title": "stamp",
                  "type": "string",
                  "description": "Card data stamp: the state the card was built from",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                }
              },
              "required": [
                "aadObjectId"
              ]
            }
          }
        }
      },
      "actions": {
        "Get_settings": {
          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "environmentvariabledefinitions",
              "$select": "schemaname,defaultvalue",
              "$filter": "startswith(schemaname, 'ait_')",
              "$expand": "environmentvariabledefinition_environmentvariablevalue($select=value)"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Select_settings": {
          "runAfter": {
            "Get_settings": [
              "Succeeded"
            ]
          },
          "type": "Select",
          "inputs": {
            "from": "@body('Get_settings')?['value']",
            "select": "@concat('\"', item()?['schemaname'], '\":\"', replace(replace(coalesce(first(item()?['environmentvariabledefinition_environmentvariablevalue'])?['value'], item()?['defaultvalue'], ''), '\\', '\\\\'), '\"', '\\\"'), '\"')"
          }
        },
        "Settings": {
          "runAfter": {
            "Select_settings": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@json(concat('{', join(body('Select_settings'), ','), '}'))"
        },
        "Init_subscriber": {
          "runAfter": {
            "Settings": [
              "Succeeded"
            ]
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "Subscriber",
                "type": "object",
                "value": {}
              },
              {
                "name": "IsNewSubscriber",
                "type": "boolean",
                "value": false
              }
            ]
          }
        },
        "Find_subscriber": {
          "runAfter": {
            "Init_subscriber": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "ait_subscribers",
              "$filter": "ait_aadobjectid eq '@{replace(triggerBody()?['aadObjectId'], '''', '''''')}'",
              "$top": 1
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Check_subscriber": {
          "runAfter": {
            "Find_subscriber": [
              "Succeeded"
            ]
          },
          "type": "If",
          "expression": "@empty(body('Find_subscriber')?['value'])",
          "actions": {
            "Create_subscriber": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "CreateRecord",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "ait_subscribers",
                  "item/ait_displayname": "@{take(if(empty(triggerBody()?['displayName']), if(empty(triggerBody()?['upn']), triggerBody()?['aadObjectId'], triggerBody()?['upn']), triggerBody()?['displayName']), 100)}",
                  "item/ait_aadobjectid": "@triggerBody()?['aadObjectId']",
                  "item/ait_upn": "@triggerBody()?['upn']",
                  "item/ait_lookaheadmonths": "@int(outputs('Settings')?['ait_DefaultLookaheadMonths'])",
                  "item/ait_criticalwindowmonths": "@int(outputs('Settings')?['ait_DefaultCriticalWindowMonths'])",
                  "item/ait_frequency": 748120001,
                  "item/ait_weekday": 748120000,
                  "item/ait_ispaused": false,
                  "item/ait_sendemptydigest": "@contains(createArray('yes', 'true', '1'), toLower(string(outputs('Settings')?['ait_SendEmptyDigest'])))"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Set_new_subscriber": {
              "runAfter": {
                "Create_subscriber": [
                  "Succeeded"
                ]
              },
              "type": "SetVariable",
              "inputs": {
                "name": "Subscriber",
                "value": "@body('Create_subscriber')"
              }
            },
            "Set_is_new": {
              "runAfter": {
                "Set_new_subscriber": [
                  "Succeeded"
                ]
              },
              "type": "SetVariable",
              "inputs": {
                "name": "IsNewSubscriber",
                "value": true
              }
            }
          },
          "else": {
            "actions": {
              "Set_existing_subscriber": {
                "runAfter": {},
                "type": "SetVariable",
                "inputs": {
                  "name": "Subscriber",
                  "value": "@first(body('Find_subscriber')?['value'])"
                }
              }
            }
          }
        },
        "Followed_condition": {
          "runAfter": {
            "Check_subscriber": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "(ait_product_subscription/any(s: s/_ait_subscriberid_value eq @{variables('Subscriber')?['ait_subscriberid']}) or ait_pack_product/any(p: p/ait_isactive eq true and p/ait_pack_subscription/any(s: s/_ait_subscriberid_value eq @{variables('Subscriber')?['ait_subscriberid']})))"
        },
        "Get_pref_packs": {
          "runAfter": {
            "Followed_condition": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "ait_packs",
              "$select": "ait_packid,ait_code,ait_name,ait_source",
              "$filter": "ait_isactive eq true",
              "$orderby": "ait_name asc",
              "$expand": "ait_pack_product($select=ait_productid;$filter=ait_isactive eq true)"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Get_pref_products": {
          "runAfter": {
            "Get_pref_packs": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "ait_products",
              "$select": "ait_productid,ait_name,ait_displayname,ait_source",
              "$filter": "ait_isactive eq true",
              "$orderby": "ait_name asc"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Get_pref_subscriptions": {
          "runAfter": {
            "Get_pref_products": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "ait_subscriptions",
              "$select": "ait_subscriptionid,ait_targetkey,createdon",
              "$filter": "_ait_subscriberid_value eq @{variables('Subscriber')?['ait_subscriberid']}",
              "$orderby": "createdon desc"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Subscribed_keys": {
          "runAfter": {
            "Get_pref_subscriptions": [
              "Succeeded"
            ]
          },
          "type": "Select",
          "inputs": {
            "from": "@body('Get_pref_subscriptions')?['value']",
            "select": "@toLower(item()?['ait_targetkey'])"
          }
        },
        "Stamp": {
          "runAfter": {
            "Subscribed_keys": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@{variables('Subscriber')?['modifiedon']}|@{length(body('Subscribed_keys'))}|@{first(body('Get_pref_subscriptions')?['value'])?['createdon']}"
        },
        "Next_due_base": {
          "runAfter": {
            "Due_from": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@if(equals(outputs('Frequency'), 'Daily'), addHours(startOfDay(outputs('Due_from')), outputs('Hour')), if(equals(outputs('Frequency'), 'Weekly'), addHours(addDays(startOfDay(outputs('Due_from')), mod(add(sub(mod(add(outputs('Weekday'), 1), 7), dayOfWeek(outputs('Due_from'))), 7), 7)), outputs('Hour')), addHours(startOfMonth(outputs('Due_from')), outputs('Hour'))))"
        },
        "Next_due": {
          "runAfter": {
            "Next_due_base": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@if(greater(ticks(outputs('Next_due_base')), ticks(outputs('Due_from'))), outputs('Next_due_base'), if(equals(outputs('Frequency'), 'Daily'), addDays(outputs('Next_due_base'), 1), if(equals(outputs('Frequency'), 'Weekly'), addDays(outputs('Next_due_base'), 7), addHours(startOfMonth(addDays(startOfMonth(outputs('Due_from')), 32)), outputs('Hour')))))"
        },
        "Picked_packs": {
          "runAfter": {
            "Stamp": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@split(toLower(coalesce(triggerBody()?['packs'], '')), ',')"
        },
        "Picked_products": {
          "runAfter": {
            "Picked_packs": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@split(toLower(coalesce(triggerBody()?['products'], '')), ',')"
        },
        "Wanted_packs": {
          "runAfter": {
            "Picked_products": [
              "Succeeded"
            ]
          },
          "type": "Query",
          "inputs": {
            "from": "@body('Get_pref_packs')?['value']",
            "where": "@contains(outputs('Picked_packs'), toLower(item()?['ait_code']))"
          }
        },
        "Wanted_products": {
          "runAfter": {
            "Wanted_packs": [
              "Succeeded"
            ]
          },
          "type": "Query",
          "inputs": {
            "from": "@body('Get_pref_products')?['value']",
            "where": "@contains(outputs('Picked_products'), toLower(item()?['ait_productid']))"
          }
        },
        "Pack_targets": {
          "runAfter": {
            "Wanted_products": [
              "Succeeded"
            ]
          },
          "type": "Select",
          "inputs": {
            "from": "@body('Wanted_packs')",
            "select": {
              "kind": "pack",
              "id": "@item()?['ait_packid']",
              "key": "@concat('pack:', item()?['ait_code'])",
              "label": "@concat('pack ', item()?['ait_code'], ' (', item()?['ait_name'], ')')"
            }
          }
        },
        "Product_targets": {
          "runAfter": {
            "Pack_targets": [
              "Succeeded"
            ]
          },
          "type": "Select",
          "inputs": {
            "from": "@body('Wanted_products')",
            "select": {
              "kind": "product",
              "id": "@item()?['ait_productid']",
              "key": "@concat('product:', item()?['ait_name'])",
              "label": "@item()?['ait_name']"
            }
          }
        },
        "Wanted_targets": {
          "runAfter": {
            "Product_targets": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@union(body('Pack_targets'), body('Product_targets'))"
        },
        "Wanted_keys": {
          "runAfter": {
            "Wanted_targets": [
              "Succeeded"
            ]
          },
          "type": "Select",
          "inputs": {
            "from": "@outputs('Wanted_targets')",
            "select": "@toLower(item()?['key'])"
          }
        },
        "All_pack_keys": {
          "runAfter": {
            "Wanted_keys": [
              "Succeeded"
            ]
          },
          "type": "Select",
          "inputs": {
            "from": "@body('Get_pref_packs')?['value']",
            "select": "@toLower(concat('pack:', item()?['ait_code']))"
          }
        },
        "All_product_keys": {
          "runAfter": {
            "All_pack_keys": [
              "Succeeded"
            ]
          },
          "type": "Select",
          "inputs": {
            "from": "@body('Get_pref_products')?['value']",
            "select": "@toLower(concat('product:', item()?['ait_name']))"
          }
        },
        "To_add": {
          "runAfter": {
            "All_product_keys": [
              "Succeeded"
            ]
          },
          "type": "Query",
          "inputs": {
            "from": "@outputs('Wanted_targets')",
            "where": "@not(contains(body('Subscribed_keys'), toLower(item()?['key'])))"
          }
        },
        "To_remove": {
          "runAfter": {
            "To_add": [
              "Succeeded"
            ]
          },
          "type": "Query",
          "inputs": {
            "from": "@body('Get_pref_subscriptions')?['value']",
            "where": "@and(contains(union(body('All_pack_keys'), body('All_product_keys')), toLower(item()?['ait_targetkey'])), not(contains(body('Wanted_keys'), toLower(item()?['ait_targetkey']))))"
          }
        },
        "Follow_conditions": {
          "runAfter": {
            "To_remove": [
              "Succeeded"
            ]
          },
          "type": "Select",
          "inputs": {
            "from": "@outputs('Wanted_targets')",
            "select": "@if(equals(item()?['kind'], 'pack'), concat('ait_pack_product/any(p: p/ait_packid eq ', item()?['id'], ')'), concat('ait_productid eq ', item()?['id']))"
          }
        },
        "Count_after": {
          "runAfter": {
            "Follow_conditions": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "ait_products",
              "$select": "ait_productid",
              "$filter": "ait_isactive eq true and (@{if(empty(body('Follow_conditions')), 'ait_productid eq null', join(body('Follow_conditions'), ' or '))})"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Cap": {
          "runAfter": {
            "Count_after": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@int(coalesce(outputs('Settings')?['ait_MaxProductsPerUser'], '0'))"
        },
        "Lookahead": {
          "runAfter": {
            "Cap": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@if(isInt(trim(coalesce(triggerBody()?['lookahead'], ''))), int(trim(coalesce(triggerBody()?['lookahead'], ''))), 0)"
        },
        "Critical": {
          "runAfter": {
            "Lookahead": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@if(isInt(trim(coalesce(triggerBody()?['critical'], ''))), int(trim(coalesce(triggerBody()?['critical'], ''))), 0)"
        },
        "Pause": {
          "runAfter": {
            "Critical": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@equals(toLower(trim(coalesce(triggerBody()?['paused'], 'false'))), 'true')"
        },
        "Send_empty": {
          "runAfter": {
            "Pause": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@equals(toLower(trim(coalesce(triggerBody()?['sendEmpty'], if(equals(variables('Subscriber')?['ait_sendemptydigest'], true), 'true', 'false')))), 'true')"
        },
        "Frequency": {
          "runAfter": {
            "Send_empty": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@if(equals(triggerBody()?['frequency'], 'Daily'), 'Daily', if(equals(triggerBody()?['frequency'], 'Monthly'), 'Monthly', 'Weekly'))"
        },
        "Weekday": {
          "runAfter": {
            "Frequency": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@if(and(equals(outputs('Frequency'), 'Weekly'), isInt(trim(coalesce(triggerBody()?['weekday'], '')))), min(max(int(trim(coalesce(triggerBody()?['weekday'], ''))), 0), 6), sub(coalesce(variables('Subscriber')?['ait_weekday'], 748120000), 748120000))"
        },
        "Hour": {
          "runAfter": {
            "Weekday": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@int(outputs('Settings')?['ait_DeliveryHourUtc'])"
        },
        "Due_from": {
          "runAfter": {
            "Hour": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@utcNow()"
        },
        "Frequency_option": {
          "runAfter": {
            "Next_due": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@if(equals(outputs('Frequency'), 'Daily'), 748120000, if(equals(outputs('Frequency'), 'Monthly'), 748120002, 748120001))"
        },
        "Schedule_changed": {
          "runAfter": {
            "Frequency_option": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@or(not(equals(outputs('Frequency_option'), variables('Subscriber')?['ait_frequency'])), and(equals(outputs('Frequency'), 'Weekly'), not(equals(add(748120000, outputs('Weekday')), coalesce(variables('Subscriber')?['ait_weekday'], 748120000)))))"
        },
        "Was_paused": {
          "runAfter": {
            "Schedule_changed": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@equals(variables('Subscriber')?['ait_ispaused'], true)"
        },
        "Was_send_empty": {
          "runAfter": {
            "Was_paused": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@equals(variables('Subscriber')?['ait_sendemptydigest'], true)"
        },
        "Problem": {
          "runAfter": {
            "Was_send_empty": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@{if(not(equals(coalesce(triggerBody()?['stamp'], ''), outputs('Stamp'))), 'This card is out of date: your settings changed after it was sent. Nothing was saved. Type /mysettings for a new card.', if(or(less(outputs('Lookahead'), 1), greater(outputs('Lookahead'), 24), less(outputs('Critical'), 1), greater(outputs('Critical'), 24)), 'Look-ahead and critical window must be whole numbers from 1 to 24. Nothing was saved.', if(and(greater(length(body('To_add')), 0), greater(outputs('Cap'), 0), greater(length(body('Count_after')?['value']), outputs('Cap'))), concat('That would bring you to ', length(body('Count_after')?['value']), ' products, and the limit is ', outputs('Cap'), '. Nothing was saved. Pick fewer packs or products.'), '')))}"
        },
        "Changed": {
          "runAfter": {
            "Problem": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@or(greater(length(body('To_add')), 0), greater(length(body('To_remove')), 0), outputs('Schedule_changed'), not(equals(outputs('Lookahead'), variables('Subscriber')?['ait_lookaheadmonths'])), not(equals(outputs('Critical'), variables('Subscriber')?['ait_criticalwindowmonths'])), not(equals(outputs('Pause'), outputs('Was_paused'))), not(equals(outputs('Send_empty'), outputs('Was_send_empty'))))"
        },
        "Check_apply": {
          "runAfter": {
            "Changed": [
              "Succeeded"
            ]
          },
          "type": "If",
          "expression": "@and(empty(outputs('Problem')), outputs('Changed'))",
          "actions": {
            "Each_remove": {
              "runAfter": {},
              "type": "Foreach",
              "foreach": "@body('To_remove')",
              "runtimeConfiguration": {
                "concurrency": {
                  "repetitions": 1
                }
              },
              "actions": {
                "Delete_subscription": {
                  "runAfter": {},
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "DeleteRecord",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "entityName": "ait_subscriptions",
                      "recordId": "@items('Each_remove')?['ait_subscriptionid']"
                    },
                    "authentication": "@parameters('$authentication')"
                  }
                }
              }
            },
            "Each_add": {
              "runAfter": {
                "Each_remove": [
                  "Succeeded"
                ]
              },
              "type": "Foreach",
              "foreach": "@body('To_add')",
              "runtimeConfiguration": {
                "concurrency": {
                  "repetitions": 1
                }
              },
              "actions": {
                "Is_pack": {
                  "runAfter": {},
                  "type": "If",
                  "expression": "@equals(items('Each_add')?['kind'], 'pack')",
                  "actions": {
                    "Create_pack_subscription": {
                      "runAfter": {},
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "connectionName": "shared_commondataserviceforapps",
                          "operationId": "CreateRecord",
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                        },
                        "parameters": {
                          "entityName": "ait_subscriptions",
                          "item/ait_name": "@{take(concat(variables('Subscriber')?['ait_displayname'], ' · ', items('Each_add')?['key']), 100)}",
                          "item/ait_targetkey": "@items('Each_add')?['key']",
                          "item/ait_subscriberid@odata.bind": "/ait_subscribers(@{variables('Subscriber')?['ait_subscriberid']})",
                          "item/ait_packid@odata.bind": "/ait_packs(@{items('Each_add')?['id']})"
                        },
                        "authentication": "@parameters('$authentication')"
                      }
                    }
                  },
                  "else": {
                    "actions": {
                      "Create_product_subscription": {
                        "runAfter": {},
                        "type": "OpenApiConnection",
                        "inputs": {
                          "host": {
                            "connectionName": "shared_commondataserviceforapps",
                            "operationId": "CreateRecord",
                            "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                          },
                          "parameters": {
                            "entityName": "ait_subscriptions",
                            "item/ait_name": "@{take(concat(variables('Subscriber')?['ait_displayname'], ' · ', items('Each_add')?['key']), 100)}",
                            "item/ait_targetkey": "@items('Each_add')?['key']",
                            "item/ait_subscriberid@odata.bind": "/ait_subscribers(@{variables('Subscriber')?['ait_subscriberid']})",
                            "item/ait_productid@odata.bind": "/ait_products(@{items('Each_add')?['id']})"
                          },
                          "authentication": "@parameters('$authentication')"
                        }
                      }
                    }
                  }
                }
              }
            },
            "Update_subscriber": {
              "runAfter": {
                "Each_add": [
                  "Succeeded"
                ]
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "UpdateRecord",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "ait_subscribers",
                  "recordId": "@variables('Subscriber')?['ait_subscriberid']",
                  "item/ait_lookaheadmonths": "@outputs('Lookahead')",
                  "item/ait_criticalwindowmonths": "@outputs('Critical')",
                  "item/ait_frequency": "@outputs('Frequency_option')",
                  "item/ait_weekday": "@add(748120000, outputs('Weekday'))",
                  "item/ait_ispaused": "@outputs('Pause')",
                  "item/ait_sendemptydigest": "@outputs('Send_empty')",
                  "item/ait_nextdueon": "@if(outputs('Schedule_changed'), outputs('Next_due'), variables('Subscriber')?['ait_nextdueon'])"
                },
                "authentication": "@parameters('$authentication')"
              }
            }
          },
          "else": {
            "actions": {}
          }
        },
        "Removed_labels": {
          "runAfter": {
            "Check_apply": [
              "Succeeded"
            ]
          },
          "type": "Select",
          "inputs": {
            "from": "@body('To_remove')",
            "select": "@if(startsWith(toLower(item()?['ait_targetkey']), 'pack:'), concat('pack ', substring(item()?['ait_targetkey'], 5)), substring(item()?['ait_targetkey'], 8))"
          }
        },
        "Added_labels": {
          "runAfter": {
            "Removed_labels": [
              "Succeeded"
            ]
          },
          "type": "Select",
          "inputs": {
            "from": "@body('To_add')",
            "select": "@item()?['label']"
          }
        },
        "Lines": {
          "runAfter": {
            "Added_labels": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": [
            "@{if(not(empty(outputs('Problem'))), outputs('Problem'), if(outputs('Changed'), 'Saved.', 'Nothing to save: the card matches your current settings.'))}",
            "@{if(or(not(empty(outputs('Problem'))), empty(body('Added_labels'))), '', concat('Added: ', join(body('Added_labels'), ', '), '.'))}",
            "@{if(or(not(empty(outputs('Problem'))), empty(body('Removed_labels'))), '', concat('Removed: ', join(body('Removed_labels'), ', '), '.'))}",
            "@{if(or(not(empty(outputs('Problem'))), not(outputs('Schedule_changed'))), '', concat('Digests now arrive ', if(equals(outputs('Frequency'), 'Daily'), 'daily', if(equals(outputs('Frequency'), 'Monthly'), 'monthly on the 1st', concat('weekly on ', createArray('Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday')[outputs('Weekday')]))), ' at ', formatNumber(outputs('Hour'), '00'), ':00 UTC. Next one: ', formatDateTime(outputs('Next_due'), 'yyyy-MM-dd HH:mm'), ' UTC.'))}",
            "@{if(or(not(empty(outputs('Problem'))), equals(outputs('Lookahead'), variables('Subscriber')?['ait_lookaheadmonths'])), '', concat('Look-ahead: ', outputs('Lookahead'), ' months.'))}",
            "@{if(or(not(empty(outputs('Problem'))), equals(outputs('Critical'), variables('Subscriber')?['ait_criticalwindowmonths'])), '', concat('Critical window: ', outputs('Critical'), ' months.'))}",
            "@{if(or(not(empty(outputs('Problem'))), equals(outputs('Pause'), outputs('Was_paused'))), '', if(outputs('Pause'), 'Digests paused. Your subscriptions are kept.', 'Digests resumed.'))}",
            "@{if(or(not(empty(outputs('Problem'))), equals(outputs('Send_empty'), outputs('Was_send_empty'))), '', if(outputs('Send_empty'), 'Scheduled digests now arrive even when there are no new items.', 'Scheduled digests with no new items are now skipped.'))}",
            "@{if(or(not(empty(outputs('Problem'))), not(outputs('Changed'))), '', concat('You follow ', length(body('Count_after')?['value']), ' products.'))}"
          ]
        },
        "Message_lines": {
          "runAfter": {
            "Lines": [
              "Succeeded"
            ]
          },
          "type": "Query",
          "inputs": {
            "from": "@outputs('Lines')",
            "where": "@not(empty(item()))"
          }
        },
        "Reply": {
          "runAfter": {
            "Message_lines": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": {
            "message": "@{join(body('Message_lines'), decodeUriComponent('%0A%0A'))}"
          }
        },
        "Respond_to_the_agent": {
          "runAfter": {
            "Reply": [
              "Succeeded"
            ]
          },
          "type": "Response",
          "kind": "Skills",
          "inputs": {
            "statusCode": 200,
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "title": "message",
                  "description": "",
                  "type": "string",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                }
              },
              "additionalProperties": {}
            },
            "body": {
              "message": "@{outputs('Reply')?['message']}"
            }
          }
        },
        "Respond_with_error": {
          "runAfter": {
            "Reply": [
              "Failed",
              "Skipped",
              "TimedOut"
            ]
          },
          "type": "Response",
          "kind": "Skills",
          "inputs": {
            "statusCode": 200,
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "title": "message",
                  "description": "",
                  "type": "string",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                }
              },
              "additionalProperties": {}
            },
            "body": {
              "message": "Sorry, something went wrong on my side. Please try again in a few minutes."
            }
          }
        }
      }
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}