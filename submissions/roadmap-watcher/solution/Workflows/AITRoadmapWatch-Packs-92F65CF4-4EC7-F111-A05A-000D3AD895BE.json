{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "api": {
          "name": "shared_commondataserviceforapps"
        },
        "connection": {
          "connectionReferenceLogicalName": "ait_Dataverse"
        },
        "runtimeSource": "embedded"
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        }
      },
      "triggers": {
        "manual": {
          "type": "Request",
          "kind": "Skills",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {},
              "required": []
            }
          }
        }
      },
      "actions": {
        "Get_packs": {
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "entityName": "ait_packs",
              "$select": "ait_code,ait_name,ait_description",
              "$filter": "ait_isactive eq true",
              "$orderby": "ait_name asc",
              "$expand": "ait_pack_product($select=ait_productid;$filter=ait_isactive eq true)"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "connectionName": "shared_commondataserviceforapps"
            }
          },
          "runAfter": {}
        },
        "Pack_lines": {
          "type": "Select",
          "inputs": {
            "from": "@body('Get_packs')?['value']",
            "select": "@concat('- `', item()?['ait_code'], '` **', item()?['ait_name'], '** · ', length(coalesce(item()?['ait_pack_product'], json('[]'))), ' products', if(empty(item()?['ait_description']), '', concat(' · ', item()?['ait_description'])))"
          },
          "runAfter": {
            "Get_packs": [
              "Succeeded"
            ]
          }
        },
        "Reply": {
          "type": "Compose",
          "inputs": {
            "message": "@{if(empty(body('Pack_lines')), 'No packs are set up yet. Ask your admin, or use /products.', concat('**Packs**', decodeUriComponent('%0A%0A'), join(body('Pack_lines'), decodeUriComponent('%0A')), decodeUriComponent('%0A%0A'), 'Follow a pack with `/add <code>`, for example /add security.'))}"
          },
          "runAfter": {
            "Pack_lines": [
              "Succeeded"
            ]
          }
        },
        "Respond_to_the_agent": {
          "type": "Response",
          "kind": "Skills",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "title": "message",
                  "description": "",
                  "type": "string",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                }
              },
              "additionalProperties": {}
            },
            "statusCode": 200,
            "body": {
              "message": "@{outputs('Reply')?['message']}"
            }
          },
          "runAfter": {
            "Reply": [
              "Succeeded"
            ]
          }
        },
        "Respond_with_error": {
          "type": "Response",
          "kind": "Skills",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "title": "message",
                  "description": "",
                  "type": "string",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                }
              },
              "additionalProperties": {}
            },
            "statusCode": 200,
            "body": {
              "message": "Sorry, something went wrong on my side. Please try again in a few minutes."
            }
          },
          "runAfter": {
            "Reply": [
              "Failed",
              "Skipped",
              "TimedOut"
            ]
          }
        }
      },
      "description": "Agent flow for /packs: lists active packs with their number of active products.",
      "metadata": {
        "defaultToEmbeddedConnections": true
      }
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}