{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "ait_Dataverse"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      },
      "shared_teams": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "ait_Teams"
        },
        "api": {
          "name": "shared_teams"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "type": "Object",
          "defaultValue": {}
        },
        "$authentication": {
          "type": "SecureObject",
          "defaultValue": {}
        }
      },
      "triggers": {
        "manual": {
          "type": "Request",
          "kind": "Button",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "text": {
                  "title": "subscriberId",
                  "type": "string",
                  "description": "ait_subscriberid of the subscriber",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                },
                "boolean": {
                  "title": "scheduled",
                  "type": "boolean",
                  "description": "true for the daily run: also advances ait_nextdueon",
                  "x-ms-content-hint": "BOOLEAN",
                  "x-ms-dynamically-added": true
                }
              },
              "required": [
                "text",
                "boolean"
              ]
            }
          }
        }
      },
      "actions": {
        "Get_settings": {
          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "environmentvariabledefinitions",
              "$select": "schemaname,defaultvalue",
              "$filter": "startswith(schemaname, 'ait_')",
              "$expand": "environmentvariabledefinition_environmentvariablevalue($select=value)"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Select_settings": {
          "runAfter": {
            "Get_settings": [
              "Succeeded"
            ]
          },
          "type": "Select",
          "inputs": {
            "from": "@body('Get_settings')?['value']",
            "select": "@concat('\"', item()?['schemaname'], '\":\"', replace(replace(coalesce(first(item()?['environmentvariabledefinition_environmentvariablevalue'])?['value'], item()?['defaultvalue'], ''), '\\', '\\\\'), '\"', '\\\"'), '\"')"
          }
        },
        "Settings": {
          "runAfter": {
            "Select_settings": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@json(concat('{', join(body('Select_settings'), ','), '}'))"
        },
        "Next_due_base": {
          "runAfter": {
            "Due_from": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@if(equals(outputs('Frequency'), 'Daily'), addHours(startOfDay(outputs('Due_from')), outputs('Hour')), if(equals(outputs('Frequency'), 'Weekly'), addHours(addDays(startOfDay(outputs('Due_from')), mod(add(sub(mod(add(outputs('Weekday'), 1), 7), dayOfWeek(outputs('Due_from'))), 7), 7)), outputs('Hour')), addHours(startOfMonth(outputs('Due_from')), outputs('Hour'))))"
        },
        "Next_due": {
          "runAfter": {
            "Next_due_base": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@if(greater(ticks(outputs('Next_due_base')), ticks(outputs('Due_from'))), outputs('Next_due_base'), if(equals(outputs('Frequency'), 'Daily'), addDays(outputs('Next_due_base'), 1), if(equals(outputs('Frequency'), 'Weekly'), addDays(outputs('Next_due_base'), 7), addHours(startOfMonth(addDays(startOfMonth(outputs('Due_from')), 32)), outputs('Hour')))))"
        },
        "Get_subscriber": {
          "runAfter": {
            "Digest_input": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "GetItem",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "ait_subscribers",
              "recordId": "@outputs('Digest_input')?['subscriberId']"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Frequency": {
          "runAfter": {
            "Get_subscriber": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@if(equals(body('Get_subscriber')?['ait_frequency'], 748120000), 'Daily', if(equals(body('Get_subscriber')?['ait_frequency'], 748120002), 'Monthly', 'Weekly'))"
        },
        "Weekday": {
          "runAfter": {
            "Frequency": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@sub(coalesce(body('Get_subscriber')?['ait_weekday'], 748120000), 748120000)"
        },
        "Hour": {
          "runAfter": {
            "Weekday": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@int(outputs('Settings')?['ait_DeliveryHourUtc'])"
        },
        "Due_from": {
          "runAfter": {
            "Hour": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@addDays(startOfDay(utcNow()), 1)"
        },
        "Init_variables": {
          "runAfter": {
            "Next_due": [
              "Succeeded"
            ]
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "Result",
                "type": "object",
                "value": {
                  "status": "failed",
                  "itemCount": 0,
                  "message": ""
                }
              },
              {
                "name": "Pack_clauses",
                "type": "array",
                "value": []
              }
            ]
          }
        },
        "Try": {
          "runAfter": {
            "Init_variables": [
              "Succeeded"
            ]
          },
          "type": "Scope",
          "actions": {
            "Sub_id": {
              "runAfter": {},
              "type": "Compose",
              "inputs": "@body('Get_subscriber')?['ait_subscriberid']"
            },
            "Run_stamp": {
              "runAfter": {
                "Sub_id": [
                  "Succeeded"
                ]
              },
              "type": "Compose",
              "inputs": "@utcNow('yyyy-MM-ddTHH:mm:ssZ')"
            },
            "Backfill": {
              "runAfter": {
                "Run_stamp": [
                  "Succeeded"
                ]
              },
              "type": "Compose",
              "inputs": "@mul(-1, int(outputs('Settings')?['ait_BackfillDays']))"
            },
            "Lookahead": {
              "runAfter": {
                "Backfill": [
                  "Succeeded"
                ]
              },
              "type": "Compose",
              "inputs": "@int(coalesce(body('Get_subscriber')?['ait_lookaheadmonths'], outputs('Settings')?['ait_DefaultLookaheadMonths']))"
            },
            "Critical_window": {
              "runAfter": {
                "Lookahead": [
                  "Succeeded"
                ]
              },
              "type": "Compose",
              "inputs": "@int(coalesce(body('Get_subscriber')?['ait_criticalwindowmonths'], outputs('Settings')?['ait_DefaultCriticalWindowMonths']))"
            },
            "Lookahead_end": {
              "runAfter": {
                "Critical_window": [
                  "Succeeded"
                ]
              },
              "type": "Compose",
              "inputs": "@formatDateTime(addToTime(startOfMonth(utcNow()), outputs('Lookahead'), 'Month'), 'yyyy-MM-dd')"
            },
            "Critical_end": {
              "runAfter": {
                "Lookahead_end": [
                  "Succeeded"
                ]
              },
              "type": "Compose",
              "inputs": "@formatDateTime(addToTime(startOfMonth(utcNow()), outputs('Critical_window'), 'Month'), 'yyyy-MM-dd')"
            },
            "List_followed": {
              "runAfter": {
                "Critical_end": [
                  "Succeeded"
                ]
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "ListRecords",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "ait_products",
                  "$select": "ait_name",
                  "$filter": "ait_isactive eq true and (ait_product_subscription/any(s: s/_ait_subscriberid_value eq @{outputs('Sub_id')}) or ait_pack_product/any(p: p/ait_isactive eq true and p/ait_pack_subscription/any(s: s/_ait_subscriberid_value eq @{outputs('Sub_id')})))",
                  "$expand": "ait_product_subscription($select=createdon;$filter=_ait_subscriberid_value eq @{outputs('Sub_id')})"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Direct_followed": {
              "runAfter": {
                "List_followed": [
                  "Succeeded"
                ]
              },
              "type": "Query",
              "inputs": {
                "from": "@body('List_followed')?['value']",
                "where": "@not(empty(item()?['ait_product_subscription']))"
              }
            },
            "Direct_clauses": {
              "runAfter": {
                "Direct_followed": [
                  "Succeeded"
                ]
              },
              "type": "Select",
              "inputs": {
                "from": "@body('Direct_followed')",
                "select": "((ait_products eq '@{replace(item()?['ait_name'], '''', '''''')}' or startswith(ait_products, '@{replace(item()?['ait_name'], '''', '''''')}|') or endswith(ait_products, '|@{replace(item()?['ait_name'], '''', '''''')}') or contains(ait_products, '|@{replace(item()?['ait_name'], '''', '''''')}|')) and ait_modifiedon_src ge @{formatDateTime(addDays(first(item()?['ait_product_subscription'])?['createdon'], outputs('Backfill')), 'yyyy-MM-ddTHH:mm:ssZ')})"
              }
            },
            "List_packs": {
              "runAfter": {
                "Direct_clauses": [
                  "Succeeded"
                ]
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "ListRecords",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "ait_packs",
                  "$select": "ait_code",
                  "$filter": "ait_isactive eq true and ait_pack_subscription/any(s: s/_ait_subscriberid_value eq @{outputs('Sub_id')})",
                  "$expand": "ait_pack_subscription($select=createdon;$filter=_ait_subscriberid_value eq @{outputs('Sub_id')}),ait_pack_product($select=ait_name;$filter=ait_isactive eq true)"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Each_pack": {
              "runAfter": {
                "List_packs": [
                  "Succeeded"
                ]
              },
              "type": "Foreach",
              "foreach": "@body('List_packs')?['value']",
              "runtimeConfiguration": {
                "concurrency": {
                  "repetitions": 1
                }
              },
              "actions": {
                "Pack_since": {
                  "runAfter": {},
                  "type": "Compose",
                  "inputs": "@formatDateTime(addDays(first(items('Each_pack')?['ait_pack_subscription'])?['createdon'], outputs('Backfill')), 'yyyy-MM-ddTHH:mm:ssZ')"
                },
                "Pack_product_clauses": {
                  "runAfter": {
                    "Pack_since": [
                      "Succeeded"
                    ]
                  },
                  "type": "Select",
                  "inputs": {
                    "from": "@items('Each_pack')?['ait_pack_product']",
                    "select": "((ait_products eq '@{replace(item()?['ait_name'], '''', '''''')}' or startswith(ait_products, '@{replace(item()?['ait_name'], '''', '''''')}|') or endswith(ait_products, '|@{replace(item()?['ait_name'], '''', '''''')}') or contains(ait_products, '|@{replace(item()?['ait_name'], '''', '''''')}|')) and ait_modifiedon_src ge @{outputs('Pack_since')})"
                  }
                },
                "Append_pack_clauses": {
                  "runAfter": {
                    "Pack_product_clauses": [
                      "Succeeded"
                    ]
                  },
                  "type": "AppendToArrayVariable",
                  "inputs": {
                    "name": "Pack_clauses",
                    "value": "@join(body('Pack_product_clauses'), ' or ')"
                  }
                }
              }
            },
            "All_clauses": {
              "runAfter": {
                "Each_pack": [
                  "Succeeded"
                ]
              },
              "type": "Query",
              "inputs": {
                "from": "@union(body('Direct_clauses'), variables('Pack_clauses'))",
                "where": "@not(empty(item()))"
              }
            },
            "Has_subscriptions": {
              "runAfter": {
                "All_clauses": [
                  "Succeeded"
                ]
              },
              "type": "If",
              "expression": "@not(empty(body('All_clauses')))",
              "actions": {
                "List_items": {
                  "runAfter": {},
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "ListRecords",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "entityName": "ait_roadmapitems",
                      "$select": "ait_roadmapitemid,ait_roadmapid,ait_title,ait_url,ait_products,ait_status,ait_gamonth,ait_previewmonth,ait_issecurity,ait_isactionrequired,ait_isretirement,ait_retirementmonth",
                      "$filter": "(@{join(body('All_clauses'), ' or ')}) and (ait_gamonth le @{outputs('Lookahead_end')} or (ait_gamonth eq null and (ait_previewmonth le @{outputs('Lookahead_end')} or ait_previewmonth eq null))) and not ait_roadmapitem_notification/any(n: n/_ait_subscriberid_value eq @{outputs('Sub_id')})"
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runtimeConfiguration": {
                    "paginationPolicy": {
                      "minimumItemCount": 5000
                    }
                  }
                },
                "Item_facts": {
                  "runAfter": {
                    "List_items": [
                      "Succeeded"
                    ]
                  },
                  "type": "Select",
                  "inputs": {
                    "from": "@body('List_items')?['value']",
                    "select": {
                      "id": "@item()?['ait_roadmapitemid']",
                      "roadmapId": "@item()?['ait_roadmapid']",
                      "title": "@replace(replace(coalesce(item()?['ait_title'], ''), '[', '('), ']', ')')",
                      "url": "@if(empty(item()?['ait_url']), concat('https://www.microsoft.com/microsoft-365/roadmap?id=', item()?['ait_roadmapid']), item()?['ait_url'])",
                      "products": "@concat(if(startsWith(coalesce(item()?['ait_roadmapid'], ''), 'azure-'), 'Azure · ', ''), replace(coalesce(item()?['ait_products'], ''), '|', ', '))",
                      "status": "@coalesce(item()?['ait_status'], '')",
                      "ga": "@coalesce(item()?['ait_gamonth'], '')",
                      "preview": "@coalesce(item()?['ait_previewmonth'], '')",
                      "security": "@equals(item()?['ait_issecurity'], true)",
                      "action": "@equals(item()?['ait_isactionrequired'], true)",
                      "retirement": "@equals(item()?['ait_isretirement'], true)",
                      "retirementMonth": "@coalesce(item()?['ait_retirementmonth'], '')",
                      "inWindow": "@or(empty(item()?['ait_retirementmonth']), lessOrEquals(ticks(coalesce(item()?['ait_retirementmonth'], '1900-01-01')), ticks(outputs('Critical_end'))))"
                    }
                  }
                },
                "Ranked": {
                  "runAfter": {
                    "Item_facts": [
                      "Succeeded"
                    ]
                  },
                  "type": "Select",
                  "inputs": {
                    "from": "@body('Item_facts')",
                    "select": {
                      "id": "@item()?['id']",
                      "roadmapId": "@item()?['roadmapId']",
                      "title": "@item()?['title']",
                      "url": "@item()?['url']",
                      "products": "@item()?['products']",
                      "status": "@item()?['status']",
                      "meta": "@{item()?['products']}@{if(empty(item()?['status']), '', concat(' · ', item()?['status']))} · @{if(not(empty(item()?['ga'])), concat('GA ', substring(concat(item()?['ga'], '0000000'), 0, 7)), if(not(empty(item()?['preview'])), concat('Preview ', substring(concat(item()?['preview'], '0000000'), 0, 7)), if(not(empty(item()?['retirementMonth'])), concat('Retires ', substring(concat(item()?['retirementMonth'], '0000000'), 0, 7)), 'No date announced')))}",
                      "rank": "@if(or(item()?['security'], item()?['action'], and(item()?['retirement'], item()?['inWindow'])), 1, if(item()?['retirement'], 2, 3))",
                      "when": "@if(not(empty(item()?['ga'])), concat('GA ', substring(concat(item()?['ga'], '0000000'), 0, 7)), if(not(empty(item()?['preview'])), concat('Preview ', substring(concat(item()?['preview'], '0000000'), 0, 7)), if(not(empty(item()?['retirementMonth'])), concat('Retires ', substring(concat(item()?['retirementMonth'], '0000000'), 0, 7)), 'No date announced')))",
                      "reason": "@trim(concat(if(item()?['security'], 'Security issue. ', ''), if(item()?['action'], 'Action required. ', ''), if(item()?['retirement'], if(empty(item()?['retirementMonth']), 'Retirement, month not announced. ', concat('Retirement in ', substring(concat(item()?['retirementMonth'], '0000000'), 0, 7), if(item()?['inWindow'], ', inside your ', ', after your '), outputs('Critical_window'), '-month window. ')), '')))",
                      "sortKey": "@concat(if(or(item()?['security'], item()?['action'], and(item()?['retirement'], item()?['inWindow'])), '1', if(item()?['retirement'], '2', '3')), '|', if(empty(item()?['ga']), if(empty(item()?['preview']), if(empty(item()?['retirementMonth']), '9999-12-31', item()?['retirementMonth']), item()?['preview']), item()?['ga']), '|', toLower(item()?['title']), '|', item()?['roadmapId'])"
                    }
                  }
                },
                "Top": {
                  "runAfter": {
                    "Ranked": [
                      "Succeeded"
                    ]
                  },
                  "type": "Compose",
                  "inputs": "@take(sort(body('Ranked'), 'sortKey'), int(outputs('Settings')?['ait_MaxItemsPerDigest']))"
                },
                "Has_items": {
                  "runAfter": {
                    "Top": [
                      "Succeeded"
                    ]
                  },
                  "type": "If",
                  "expression": "@not(empty(outputs('Top')))",
                  "actions": {
                    "Critical_items": {
                      "runAfter": {},
                      "type": "Query",
                      "inputs": {
                        "from": "@outputs('Top')",
                        "where": "@equals(item()?['rank'], 1)"
                      }
                    },
                    "Deprecation_items": {
                      "runAfter": {
                        "Critical_items": [
                          "Succeeded"
                        ]
                      },
                      "type": "Query",
                      "inputs": {
                        "from": "@outputs('Top')",
                        "where": "@equals(item()?['rank'], 2)"
                      }
                    },
                    "New_feature_items": {
                      "runAfter": {
                        "Deprecation_items": [
                          "Succeeded"
                        ]
                      },
                      "type": "Query",
                      "inputs": {
                        "from": "@outputs('Top')",
                        "where": "@equals(item()?['rank'], 3)"
                      }
                    },
                    "Critical_cards": {
                      "runAfter": {
                        "New_feature_items": [
                          "Succeeded"
                        ]
                      },
                      "type": "Select",
                      "inputs": {
                        "from": "@body('Critical_items')",
                        "select": {
                          "type": "Container",
                          "separator": true,
                          "items": [
                            {
                              "type": "TextBlock",
                              "text": "[@{item()?['title']}](@{item()?['url']})",
                              "wrap": true
                            },
                            {
                              "type": "TextBlock",
                              "text": "@{item()?['meta']}",
                              "isSubtle": true,
                              "size": "Small",
                              "wrap": true
                            },
                            {
                              "type": "TextBlock",
                              "text": "@{item()?['reason']}",
                              "size": "Small",
                              "wrap": true,
                              "isVisible": "@not(empty(item()?['reason']))"
                            }
                          ]
                        }
                      }
                    },
                    "Deprecation_cards": {
                      "runAfter": {
                        "Critical_cards": [
                          "Succeeded"
                        ]
                      },
                      "type": "Select",
                      "inputs": {
                        "from": "@body('Deprecation_items')",
                        "select": {
                          "type": "Container",
                          "separator": true,
                          "items": [
                            {
                              "type": "TextBlock",
                              "text": "[@{item()?['title']}](@{item()?['url']})",
                              "wrap": true
                            },
                            {
                              "type": "TextBlock",
                              "text": "@{item()?['meta']}",
                              "isSubtle": true,
                              "size": "Small",
                              "wrap": true
                            },
                            {
                              "type": "TextBlock",
                              "text": "@{item()?['reason']}",
                              "size": "Small",
                              "wrap": true,
                              "isVisible": "@not(empty(item()?['reason']))"
                            }
                          ]
                        }
                      }
                    },
                    "New_feature_cards": {
                      "runAfter": {
                        "Deprecation_cards": [
                          "Succeeded"
                        ]
                      },
                      "type": "Select",
                      "inputs": {
                        "from": "@body('New_feature_items')",
                        "select": {
                          "type": "Container",
                          "separator": true,
                          "items": [
                            {
                              "type": "TextBlock",
                              "text": "[@{item()?['title']}](@{item()?['url']})",
                              "wrap": true
                            },
                            {
                              "type": "TextBlock",
                              "text": "@{item()?['meta']}",
                              "isSubtle": true,
                              "size": "Small",
                              "wrap": true
                            },
                            {
                              "type": "TextBlock",
                              "text": "@{item()?['reason']}",
                              "size": "Small",
                              "wrap": true,
                              "isVisible": "@not(empty(item()?['reason']))"
                            }
                          ]
                        }
                      }
                    },
                    "Card_header": {
                      "runAfter": {
                        "New_feature_cards": [
                          "Succeeded"
                        ]
                      },
                      "type": "Compose",
                      "inputs": [
                        {
                          "type": "TextBlock",
                          "text": "Roadmap digest · @{formatDateTime(utcNow(), 'yyyy-MM-dd')}",
                          "weight": "Bolder",
                          "size": "Large",
                          "wrap": true
                        },
                        {
                          "type": "TextBlock",
                          "text": "@{length(outputs('Top'))} updates for @{length(body('List_followed')?['value'])} products · look-ahead @{outputs('Lookahead')} months",
                          "isSubtle": true,
                          "wrap": true
                        }
                      ]
                    },
                    "Critical_section": {
                      "runAfter": {
                        "Card_header": [
                          "Succeeded"
                        ]
                      },
                      "type": "Compose",
                      "inputs": {
                        "type": "Container",
                        "items": "@union(createArray(json(concat('{\"type\":\"TextBlock\",\"text\":\"Critical (', length(body('Critical_cards')), ')\",\"weight\":\"Bolder\",\"color\":\"Attention\"}'))), body('Critical_cards'))"
                      }
                    },
                    "Deprecation_section": {
                      "runAfter": {
                        "Critical_section": [
                          "Succeeded"
                        ]
                      },
                      "type": "Compose",
                      "inputs": {
                        "type": "Container",
                        "items": "@union(createArray(json(concat('{\"type\":\"TextBlock\",\"text\":\"Deprecation (', length(body('Deprecation_cards')), ')\",\"weight\":\"Bolder\",\"color\":\"Warning\"}'))), body('Deprecation_cards'))"
                      }
                    },
                    "New_feature_section": {
                      "runAfter": {
                        "Deprecation_section": [
                          "Succeeded"
                        ]
                      },
                      "type": "Compose",
                      "inputs": {
                        "type": "Container",
                        "items": "@union(createArray(json(concat('{\"type\":\"TextBlock\",\"text\":\"New feature (', length(body('New_feature_cards')), ')\",\"weight\":\"Bolder\",\"color\":\"Good\"}'))), body('New_feature_cards'))"
                      }
                    },
                    "Card": {
                      "runAfter": {
                        "New_feature_section": [
                          "Succeeded"
                        ]
                      },
                      "type": "Compose",
                      "inputs": {
                        "type": "AdaptiveCard",
                        "version": "1.5",
                        "body": "@union(outputs('Card_header'), if(empty(body('Critical_cards')), json('[]'), createArray(outputs('Critical_section'))), if(empty(body('Deprecation_cards')), json('[]'), createArray(outputs('Deprecation_section'))), if(empty(body('New_feature_cards')), json('[]'), createArray(outputs('New_feature_section'))))",
                        "actions": [
                          {
                            "type": "Action.Submit",
                            "title": "My subscriptions",
                            "data": {
                              "msteams": {
                                "type": "imBack",
                                "value": "/mysubs"
                              }
                            }
                          },
                          {
                            "type": "Action.Submit",
                            "title": "Manage digest",
                            "data": {
                              "msteams": {
                                "type": "imBack",
                                "value": "/mysettings"
                              }
                            }
                          }
                        ]
                      }
                    },
                    "Each_notification": {
                      "runAfter": {
                        "Card": [
                          "Succeeded"
                        ]
                      },
                      "type": "Foreach",
                      "foreach": "@outputs('Top')",
                      "runtimeConfiguration": {
                        "concurrency": {
                          "repetitions": 10
                        }
                      },
                      "actions": {
                        "Create_notification": {
                          "runAfter": {},
                          "type": "OpenApiConnection",
                          "inputs": {
                            "host": {
                              "connectionName": "shared_commondataserviceforapps",
                              "operationId": "CreateRecord",
                              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                            },
                            "parameters": {
                              "entityName": "ait_notifications",
                              "item/ait_name": "@{take(concat(items('Each_notification')?['roadmapId'], ' · ', body('Get_subscriber')?['ait_displayname']), 100)}",
                              "item/ait_subscriberid@odata.bind": "/ait_subscribers(@{outputs('Sub_id')})",
                              "item/ait_roadmapitemid@odata.bind": "/ait_roadmapitems(@{items('Each_notification')?['id']})",
                              "item/ait_category": "@if(equals(items('Each_notification')?['rank'], 1), 748120000, if(equals(items('Each_notification')?['rank'], 2), 748120001, 748120002))",
                              "item/ait_senton": "@outputs('Run_stamp')"
                            },
                            "authentication": "@parameters('$authentication')"
                          }
                        }
                      }
                    },
                    "Post_card": {
                      "runAfter": {
                        "Each_notification": [
                          "Succeeded"
                        ]
                      },
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "connectionName": "shared_teams",
                          "operationId": "PostCardToConversation",
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams"
                        },
                        "parameters": {
                          "poster": "Power Virtual Agents",
                          "location": "powerva",
                          "body/bot": "ait_RoadmapWatcherforMicrosoft365",
                          "body/recipient": "@{body('Get_subscriber')?['ait_upn']};",
                          "body/messageBody": "@{string(outputs('Card'))}",
                          "body/attribution": true,
                          "body/activeChat": "Send",
                          "body/installedError": "Fail"
                        },
                        "authentication": "@parameters('$authentication')"
                      }
                    },
                    "Update_last_digest": {
                      "runAfter": {
                        "Post_card": [
                          "Succeeded"
                        ]
                      },
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "connectionName": "shared_commondataserviceforapps",
                          "operationId": "UpdateRecord",
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                        },
                        "parameters": {
                          "entityName": "ait_subscribers",
                          "recordId": "@outputs('Sub_id')",
                          "item/ait_lastdigeston": "@outputs('Run_stamp')"
                        },
                        "authentication": "@parameters('$authentication')"
                      }
                    },
                    "Set_sent": {
                      "runAfter": {
                        "Update_last_digest": [
                          "Succeeded"
                        ]
                      },
                      "type": "SetVariable",
                      "inputs": {
                        "name": "Result",
                        "value": {
                          "status": "sent",
                          "itemCount": "@length(outputs('Top'))",
                          "message": "Your digest is in this chat: @{length(outputs('Top'))} @{if(equals(length(outputs('Top')), 1), 'item', 'items')}."
                        }
                      }
                    },
                    "Rollback": {
                      "runAfter": {
                        "Post_card": [
                          "Failed",
                          "Skipped",
                          "TimedOut"
                        ]
                      },
                      "type": "Scope",
                      "actions": {
                        "List_written": {
                          "runAfter": {},
                          "type": "OpenApiConnection",
                          "inputs": {
                            "host": {
                              "connectionName": "shared_commondataserviceforapps",
                              "operationId": "ListRecords",
                              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                            },
                            "parameters": {
                              "entityName": "ait_notifications",
                              "$select": "ait_notificationid",
                              "$filter": "_ait_subscriberid_value eq @{outputs('Sub_id')} and ait_senton ge @{outputs('Run_stamp')}"
                            },
                            "authentication": "@parameters('$authentication')"
                          }
                        },
                        "Each_written": {
                          "runAfter": {
                            "List_written": [
                              "Succeeded"
                            ]
                          },
                          "type": "Foreach",
                          "foreach": "@body('List_written')?['value']",
                          "runtimeConfiguration": {
                            "concurrency": {
                              "repetitions": 10
                            }
                          },
                          "actions": {
                            "Delete_written": {
                              "runAfter": {},
                              "type": "OpenApiConnection",
                              "inputs": {
                                "host": {
                                  "connectionName": "shared_commondataserviceforapps",
                                  "operationId": "DeleteRecord",
                                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                                },
                                "parameters": {
                                  "entityName": "ait_notifications",
                                  "recordId": "@items('Each_written')?['ait_notificationid']"
                                },
                                "authentication": "@parameters('$authentication')"
                              }
                            }
                          }
                        },
                        "Set_post_failed": {
                          "runAfter": {
                            "Each_written": [
                              "Succeeded"
                            ]
                          },
                          "type": "SetVariable",
                          "inputs": {
                            "name": "Result",
                            "value": {
                              "status": "failed",
                              "itemCount": 0,
                              "message": "@{if(equals(actions('Post_card')?['status'], 'Skipped'), 'Writing the notification rows failed.', concat('Posting the card failed: ', take(string(coalesce(outputs('Post_card')?['body'], actions('Post_card')?['error'], 'no error text')), 500)))} The items stay queued for the next digest."
                            }
                          }
                        }
                      }
                    }
                  },
                  "else": {
                    "actions": {
                      "Send_empty_card": {
                        "runAfter": {},
                        "type": "If",
                        "expression": "@and(equals(outputs('Digest_input')?['scheduled'], true), equals(body('Get_subscriber')?['ait_sendemptydigest'], true))",
                        "actions": {
                          "Post_empty_card": {
                            "runAfter": {},
                            "type": "OpenApiConnection",
                            "inputs": {
                              "host": {
                                "connectionName": "shared_teams",
                                "operationId": "PostCardToConversation",
                                "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams"
                              },
                              "parameters": {
                                "poster": "Power Virtual Agents",
                                "location": "powerva",
                                "body/bot": "ait_RoadmapWatcherforMicrosoft365",
                                "body/recipient": "@{body('Get_subscriber')?['ait_upn']};",
                                "body/messageBody": "{\"type\":\"AdaptiveCard\",\"version\":\"1.5\",\"body\":[{\"type\":\"TextBlock\",\"text\":\"Roadmap digest · @{formatDateTime(utcNow(), 'yyyy-MM-dd')}\",\"weight\":\"Bolder\",\"size\":\"Large\",\"wrap\":true},{\"type\":\"TextBlock\",\"text\":\"No new roadmap items for the products you follow.\",\"wrap\":true}]}",
                                "body/attribution": true,
                                "body/activeChat": "Send",
                                "body/installedError": "Fail"
                              },
                              "authentication": "@parameters('$authentication')"
                            }
                          }
                        }
                      },
                      "Set_empty": {
                        "runAfter": {
                          "Send_empty_card": [
                            "Succeeded",
                            "Failed"
                          ]
                        },
                        "type": "SetVariable",
                        "inputs": {
                          "name": "Result",
                          "value": {
                            "status": "empty",
                            "itemCount": 0,
                            "message": "No new roadmap items for the products you follow. Type /mysubs to check them, or /lookahead to look further ahead."
                          }
                        }
                      }
                    }
                  }
                }
              },
              "else": {
                "actions": {
                  "Set_no_subscriptions": {
                    "runAfter": {},
                    "type": "SetVariable",
                    "inputs": {
                      "name": "Result",
                      "value": {
                        "status": "nosubs",
                        "itemCount": 0,
                        "message": "You don't follow any products yet. Type /packs or /products to find some, then /add <names>."
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "Catch": {
          "runAfter": {
            "Try": [
              "Failed",
              "Skipped",
              "TimedOut"
            ]
          },
          "type": "Scope",
          "actions": {
            "Failed_actions": {
              "runAfter": {},
              "type": "Query",
              "inputs": {
                "from": "@result('Try')",
                "where": "@equals(item()?['status'], 'Failed')"
              }
            },
            "Error_text": {
              "runAfter": {
                "Failed_actions": [
                  "Succeeded"
                ]
              },
              "type": "Select",
              "inputs": {
                "from": "@body('Failed_actions')",
                "select": "@concat(item()?['name'], ': ', coalesce(item()?['error']?['message'], string(item()?['outputs']?['body']), 'failed'))"
              }
            },
            "Previous_result": {
              "runAfter": {
                "Error_text": [
                  "Succeeded"
                ]
              },
              "type": "Compose",
              "inputs": "@variables('Result')"
            },
            "Set_failed": {
              "runAfter": {
                "Previous_result": [
                  "Succeeded"
                ]
              },
              "type": "SetVariable",
              "inputs": {
                "name": "Result",
                "value": {
                  "status": "failed",
                  "itemCount": 0,
                  "message": "@{if(empty(outputs('Previous_result')?['message']), take(if(empty(body('Error_text')), 'The digest could not be built.', join(body('Error_text'), ' | ')), 2000), outputs('Previous_result')?['message'])}"
                }
              }
            }
          }
        },
        "Advance_next_due": {
          "runAfter": {
            "Catch": [
              "Succeeded",
              "Skipped"
            ]
          },
          "type": "If",
          "expression": "@and(equals(outputs('Digest_input')?['scheduled'], true), equals(actions('Get_subscriber')?['status'], 'Succeeded'))",
          "actions": {
            "Update_next_due": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "UpdateRecord",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "ait_subscribers",
                  "recordId": "@body('Get_subscriber')?['ait_subscriberid']",
                  "item/ait_nextdueon": "@outputs('Next_due')"
                },
                "authentication": "@parameters('$authentication')"
              }
            }
          }
        },
        "Digest_done": {
          "runAfter": {
            "Advance_next_due": [
              "Succeeded",
              "Failed",
              "Skipped",
              "TimedOut"
            ]
          },
          "type": "Compose",
          "inputs": "@variables('Result')"
        },
        "Digest_input": {
          "runAfter": {
            "Settings": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": {
            "subscriberId": "@triggerBody()?['text']",
            "scheduled": "@equals(triggerBody()?['boolean'], true)"
          }
        },
        "Respond": {
          "runAfter": {
            "Digest_done": [
              "Succeeded"
            ]
          },
          "type": "Response",
          "kind": "PowerApp",
          "inputs": {
            "statusCode": 200,
            "body": {
              "status": "@{outputs('Digest_done')?['status']}",
              "itemcount": "@{outputs('Digest_done')?['itemCount']}",
              "message": "@{outputs('Digest_done')?['message']}"
            },
            "schema": {
              "type": "object",
              "properties": {
                "status": {
                  "title": "status",
                  "type": "string",
                  "x-ms-dynamically-added": true
                },
                "itemcount": {
                  "title": "itemcount",
                  "type": "string",
                  "x-ms-dynamically-added": true
                },
                "message": {
                  "title": "message",
                  "type": "string",
                  "x-ms-dynamically-added": true
                }
              }
            }
          }
        }
      }
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}