{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "ait_Dataverse"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "type": "Object",
          "defaultValue": {}
        },
        "$authentication": {
          "type": "SecureObject",
          "defaultValue": {}
        }
      },
      "triggers": {
        "manual": {
          "type": "Request",
          "kind": "Skills",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "aadObjectId": {
                  "title": "aadObjectId",
                  "type": "string",
                  "description": "Entra object ID of the user (System.User.Id)",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                },
                "upn": {
                  "title": "upn",
                  "type": "string",
                  "description": "User principal name (System.User.PrincipalName)",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                },
                "displayName": {
                  "title": "displayName",
                  "type": "string",
                  "description": "Display name (System.User.DisplayName)",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                }
              },
              "required": [
                "aadObjectId"
              ]
            }
          }
        }
      },
      "actions": {
        "Get_settings": {
          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "environmentvariabledefinitions",
              "$select": "schemaname,defaultvalue",
              "$filter": "startswith(schemaname, 'ait_')",
              "$expand": "environmentvariabledefinition_environmentvariablevalue($select=value)"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Select_settings": {
          "runAfter": {
            "Get_settings": [
              "Succeeded"
            ]
          },
          "type": "Select",
          "inputs": {
            "from": "@body('Get_settings')?['value']",
            "select": "@concat('\"', item()?['schemaname'], '\":\"', replace(replace(coalesce(first(item()?['environmentvariabledefinition_environmentvariablevalue'])?['value'], item()?['defaultvalue'], ''), '\\', '\\\\'), '\"', '\\\"'), '\"')"
          }
        },
        "Settings": {
          "runAfter": {
            "Select_settings": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@json(concat('{', join(body('Select_settings'), ','), '}'))"
        },
        "Init_subscriber": {
          "runAfter": {
            "Settings": [
              "Succeeded"
            ]
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "Subscriber",
                "type": "object",
                "value": {}
              },
              {
                "name": "IsNewSubscriber",
                "type": "boolean",
                "value": false
              }
            ]
          }
        },
        "Find_subscriber": {
          "runAfter": {
            "Init_subscriber": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "ait_subscribers",
              "$filter": "ait_aadobjectid eq '@{replace(triggerBody()?['aadObjectId'], '''', '''''')}'",
              "$top": 1
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Check_subscriber": {
          "runAfter": {
            "Find_subscriber": [
              "Succeeded"
            ]
          },
          "type": "If",
          "expression": "@empty(body('Find_subscriber')?['value'])",
          "actions": {
            "Create_subscriber": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "CreateRecord",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "ait_subscribers",
                  "item/ait_displayname": "@{take(if(empty(triggerBody()?['displayName']), if(empty(triggerBody()?['upn']), triggerBody()?['aadObjectId'], triggerBody()?['upn']), triggerBody()?['displayName']), 100)}",
                  "item/ait_aadobjectid": "@triggerBody()?['aadObjectId']",
                  "item/ait_upn": "@triggerBody()?['upn']",
                  "item/ait_lookaheadmonths": "@int(outputs('Settings')?['ait_DefaultLookaheadMonths'])",
                  "item/ait_criticalwindowmonths": "@int(outputs('Settings')?['ait_DefaultCriticalWindowMonths'])",
                  "item/ait_frequency": 748120001,
                  "item/ait_weekday": 748120000,
                  "item/ait_ispaused": false,
                  "item/ait_sendemptydigest": "@contains(createArray('yes', 'true', '1'), toLower(string(outputs('Settings')?['ait_SendEmptyDigest'])))"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Set_new_subscriber": {
              "runAfter": {
                "Create_subscriber": [
                  "Succeeded"
                ]
              },
              "type": "SetVariable",
              "inputs": {
                "name": "Subscriber",
                "value": "@body('Create_subscriber')"
              }
            },
            "Set_is_new": {
              "runAfter": {
                "Set_new_subscriber": [
                  "Succeeded"
                ]
              },
              "type": "SetVariable",
              "inputs": {
                "name": "IsNewSubscriber",
                "value": true
              }
            }
          },
          "else": {
            "actions": {
              "Set_existing_subscriber": {
                "runAfter": {},
                "type": "SetVariable",
                "inputs": {
                  "name": "Subscriber",
                  "value": "@first(body('Find_subscriber')?['value'])"
                }
              }
            }
          }
        },
        "Followed_condition": {
          "runAfter": {
            "Check_subscriber": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "(ait_product_subscription/any(s: s/_ait_subscriberid_value eq @{variables('Subscriber')?['ait_subscriberid']}) or ait_pack_product/any(p: p/ait_isactive eq true and p/ait_pack_subscription/any(s: s/_ait_subscriberid_value eq @{variables('Subscriber')?['ait_subscriberid']})))"
        },
        "Get_subscriptions": {
          "runAfter": {
            "Followed_condition": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "ait_subscriptions",
              "$select": "ait_targetkey",
              "$filter": "_ait_subscriberid_value eq @{variables('Subscriber')?['ait_subscriberid']}",
              "$orderby": "ait_targetkey asc",
              "$expand": "ait_productid($select=ait_name,ait_isactive),ait_packid($select=ait_code,ait_name,ait_isactive)"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Get_followed": {
          "runAfter": {
            "Get_subscriptions": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "ait_products",
              "$select": "ait_name",
              "$filter": "ait_isactive eq true and @{outputs('Followed_condition')}",
              "$orderby": "ait_name asc"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Pack_subscriptions": {
          "runAfter": {
            "Get_followed": [
              "Succeeded"
            ]
          },
          "type": "Query",
          "inputs": {
            "from": "@body('Get_subscriptions')?['value']",
            "where": "@not(empty(item()?['ait_packid']))"
          }
        },
        "Pack_labels": {
          "runAfter": {
            "Pack_subscriptions": [
              "Succeeded"
            ]
          },
          "type": "Select",
          "inputs": {
            "from": "@body('Pack_subscriptions')",
            "select": "@concat('`', item()?['ait_packid']?['ait_code'], '` ', item()?['ait_packid']?['ait_name'], if(equals(item()?['ait_packid']?['ait_isactive'], false), ' (retired by your admin)', ''))"
          }
        },
        "Product_subscriptions": {
          "runAfter": {
            "Pack_labels": [
              "Succeeded"
            ]
          },
          "type": "Query",
          "inputs": {
            "from": "@body('Get_subscriptions')?['value']",
            "where": "@not(empty(item()?['ait_productid']))"
          }
        },
        "Product_labels": {
          "runAfter": {
            "Product_subscriptions": [
              "Succeeded"
            ]
          },
          "type": "Select",
          "inputs": {
            "from": "@body('Product_subscriptions')",
            "select": "@concat(item()?['ait_productid']?['ait_name'], if(equals(item()?['ait_productid']?['ait_isactive'], false), ' (retired by your admin)', ''))"
          }
        },
        "Followed_names": {
          "runAfter": {
            "Product_labels": [
              "Succeeded"
            ]
          },
          "type": "Select",
          "inputs": {
            "from": "@body('Get_followed')?['value']",
            "select": "@item()?['ait_name']"
          }
        },
        "Cap": {
          "runAfter": {
            "Followed_names": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@int(coalesce(outputs('Settings')?['ait_MaxProductsPerUser'], '0'))"
        },
        "Lines": {
          "runAfter": {
            "Cap": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": [
            "@{if(empty(body('Get_subscriptions')?['value']), 'You do not follow anything yet. Type /packs or /products to look around, then `/add <name>`.', '')}",
            "@{if(empty(body('Pack_labels')), '', concat('**Packs:** ', join(body('Pack_labels'), ', ')))}",
            "@{if(empty(body('Product_labels')), '', concat('**Products:** ', join(body('Product_labels'), ', ')))}",
            "@{if(empty(body('Followed_names')), '', concat('**', length(body('Followed_names')), ' products in total', if(greater(outputs('Cap'), 0), concat(' (limit ', outputs('Cap'), ')'), ''), ':** ', join(body('Followed_names'), ', ')))}",
            "@{if(equals(variables('Subscriber')?['ait_ispaused'], true), 'Your digests are paused. Type /resume to restart them.', '')}"
          ]
        },
        "Message_lines": {
          "runAfter": {
            "Lines": [
              "Succeeded"
            ]
          },
          "type": "Query",
          "inputs": {
            "from": "@outputs('Lines')",
            "where": "@not(empty(item()))"
          }
        },
        "Reply": {
          "runAfter": {
            "Message_lines": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": {
            "message": "@{join(body('Message_lines'), decodeUriComponent('%0A%0A'))}"
          }
        },
        "Respond_to_the_agent": {
          "runAfter": {
            "Reply": [
              "Succeeded"
            ]
          },
          "type": "Response",
          "kind": "Skills",
          "inputs": {
            "statusCode": 200,
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "title": "message",
                  "description": "",
                  "type": "string",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                }
              },
              "additionalProperties": {}
            },
            "body": {
              "message": "@{outputs('Reply')?['message']}"
            }
          }
        },
        "Respond_with_error": {
          "runAfter": {
            "Reply": [
              "Failed",
              "Skipped",
              "TimedOut"
            ]
          },
          "type": "Response",
          "kind": "Skills",
          "inputs": {
            "statusCode": 200,
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "title": "message",
                  "description": "",
                  "type": "string",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                }
              },
              "additionalProperties": {}
            },
            "body": {
              "message": "Sorry, something went wrong on my side. Please try again in a few minutes."
            }
          }
        }
      }
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}