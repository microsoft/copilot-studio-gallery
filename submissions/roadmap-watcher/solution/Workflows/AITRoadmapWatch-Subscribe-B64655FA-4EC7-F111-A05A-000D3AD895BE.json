{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "ait_Dataverse"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "type": "Object",
          "defaultValue": {}
        },
        "$authentication": {
          "type": "SecureObject",
          "defaultValue": {}
        }
      },
      "triggers": {
        "manual": {
          "type": "Request",
          "kind": "Skills",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "aadObjectId": {
                  "title": "aadObjectId",
                  "type": "string",
                  "description": "Entra object ID of the user (System.User.Id)",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                },
                "upn": {
                  "title": "upn",
                  "type": "string",
                  "description": "User principal name (System.User.PrincipalName)",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                },
                "displayName": {
                  "title": "displayName",
                  "type": "string",
                  "description": "Display name (System.User.DisplayName)",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                },
                "args": {
                  "title": "args",
                  "type": "string",
                  "description": "Comma-separated pack codes, product names or aliases",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                }
              },
              "required": [
                "aadObjectId",
                "args"
              ]
            }
          }
        }
      },
      "actions": {
        "Get_settings": {
          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "environmentvariabledefinitions",
              "$select": "schemaname,defaultvalue",
              "$filter": "startswith(schemaname, 'ait_')",
              "$expand": "environmentvariabledefinition_environmentvariablevalue($select=value)"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Select_settings": {
          "runAfter": {
            "Get_settings": [
              "Succeeded"
            ]
          },
          "type": "Select",
          "inputs": {
            "from": "@body('Get_settings')?['value']",
            "select": "@concat('\"', item()?['schemaname'], '\":\"', replace(replace(coalesce(first(item()?['environmentvariabledefinition_environmentvariablevalue'])?['value'], item()?['defaultvalue'], ''), '\\', '\\\\'), '\"', '\\\"'), '\"')"
          }
        },
        "Settings": {
          "runAfter": {
            "Select_settings": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@json(concat('{', join(body('Select_settings'), ','), '}'))"
        },
        "Init_subscriber": {
          "runAfter": {
            "Settings": [
              "Succeeded"
            ]
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "Subscriber",
                "type": "object",
                "value": {}
              },
              {
                "name": "IsNewSubscriber",
                "type": "boolean",
                "value": false
              }
            ]
          }
        },
        "Find_subscriber": {
          "runAfter": {
            "Init_subscriber": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "ait_subscribers",
              "$filter": "ait_aadobjectid eq '@{replace(triggerBody()?['aadObjectId'], '''', '''''')}'",
              "$top": 1
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Check_subscriber": {
          "runAfter": {
            "Find_subscriber": [
              "Succeeded"
            ]
          },
          "type": "If",
          "expression": "@empty(body('Find_subscriber')?['value'])",
          "actions": {
            "Create_subscriber": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "CreateRecord",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "ait_subscribers",
                  "item/ait_displayname": "@{take(if(empty(triggerBody()?['displayName']), if(empty(triggerBody()?['upn']), triggerBody()?['aadObjectId'], triggerBody()?['upn']), triggerBody()?['displayName']), 100)}",
                  "item/ait_aadobjectid": "@triggerBody()?['aadObjectId']",
                  "item/ait_upn": "@triggerBody()?['upn']",
                  "item/ait_lookaheadmonths": "@int(outputs('Settings')?['ait_DefaultLookaheadMonths'])",
                  "item/ait_criticalwindowmonths": "@int(outputs('Settings')?['ait_DefaultCriticalWindowMonths'])",
                  "item/ait_frequency": 748120001,
                  "item/ait_weekday": 748120000,
                  "item/ait_ispaused": false,
                  "item/ait_sendemptydigest": "@contains(createArray('yes', 'true', '1'), toLower(string(outputs('Settings')?['ait_SendEmptyDigest'])))"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Set_new_subscriber": {
              "runAfter": {
                "Create_subscriber": [
                  "Succeeded"
                ]
              },
              "type": "SetVariable",
              "inputs": {
                "name": "Subscriber",
                "value": "@body('Create_subscriber')"
              }
            },
            "Set_is_new": {
              "runAfter": {
                "Set_new_subscriber": [
                  "Succeeded"
                ]
              },
              "type": "SetVariable",
              "inputs": {
                "name": "IsNewSubscriber",
                "value": true
              }
            }
          },
          "else": {
            "actions": {
              "Set_existing_subscriber": {
                "runAfter": {},
                "type": "SetVariable",
                "inputs": {
                  "name": "Subscriber",
                  "value": "@first(body('Find_subscriber')?['value'])"
                }
              }
            }
          }
        },
        "Followed_condition": {
          "runAfter": {
            "Check_subscriber": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "(ait_product_subscription/any(s: s/_ait_subscriberid_value eq @{variables('Subscriber')?['ait_subscriberid']}) or ait_pack_product/any(p: p/ait_isactive eq true and p/ait_pack_subscription/any(s: s/_ait_subscriberid_value eq @{variables('Subscriber')?['ait_subscriberid']})))"
        },
        "Init_match": {
          "runAfter": {
            "Candidates": [
              "Succeeded"
            ]
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "Targets",
                "type": "array",
                "value": []
              },
              {
                "name": "Unmatched",
                "type": "array",
                "value": []
              },
              {
                "name": "Ambiguous",
                "type": "array",
                "value": []
              },
              {
                "name": "Choices",
                "type": "string",
                "value": ""
              }
            ]
          }
        },
        "Token_list": {
          "runAfter": {
            "Init_match": [
              "Succeeded"
            ]
          },
          "type": "Select",
          "inputs": {
            "from": "@split(coalesce(triggerBody()?['args'], ''), ',')",
            "select": "@toLower(trim(item()))"
          }
        },
        "Tokens": {
          "runAfter": {
            "Token_list": [
              "Succeeded"
            ]
          },
          "type": "Query",
          "inputs": {
            "from": "@union(body('Token_list'), body('Token_list'))",
            "where": "@not(empty(item()))"
          }
        },
        "Each_token": {
          "runAfter": {
            "Tokens": [
              "Succeeded"
            ]
          },
          "type": "Foreach",
          "foreach": "@body('Tokens')",
          "runtimeConfiguration": {
            "concurrency": {
              "repetitions": 1
            }
          },
          "actions": {
            "Pack_hit": {
              "runAfter": {},
              "type": "Query",
              "inputs": {
                "from": "@outputs('Candidates')",
                "where": "@and(equals(item()?['kind'], 'pack'), equals(item()?['code'], items('Each_token')))"
              }
            },
            "Exact_hit": {
              "runAfter": {
                "Pack_hit": [
                  "Succeeded"
                ]
              },
              "type": "Query",
              "inputs": {
                "from": "@outputs('Candidates')",
                "where": "@and(equals(item()?['kind'], 'product'), or(equals(item()?['name'], items('Each_token')), equals(item()?['alt'], items('Each_token')), contains(item()?['aliases'], concat(',', items('Each_token'), ','))))"
              }
            },
            "Contains_hit": {
              "runAfter": {
                "Exact_hit": [
                  "Succeeded"
                ]
              },
              "type": "Query",
              "inputs": {
                "from": "@outputs('Candidates')",
                "where": "@and(equals(item()?['kind'], 'product'), or(contains(item()?['name'], items('Each_token')), contains(item()?['alt'], items('Each_token'))))"
              }
            },
            "Match": {
              "runAfter": {
                "Contains_hit": [
                  "Succeeded"
                ]
              },
              "type": "Compose",
              "inputs": "@if(greater(length(body('Pack_hit')), 0), first(body('Pack_hit')), if(greater(length(body('Exact_hit')), 0), first(body('Exact_hit')), if(equals(length(body('Contains_hit')), 1), first(body('Contains_hit')), json(concat('{\"kind\":\"', if(greater(length(body('Contains_hit')), 1), 'ambiguous', 'none'), '\"}')))))"
            },
            "Route_match": {
              "runAfter": {
                "Match": [
                  "Succeeded"
                ]
              },
              "type": "Switch",
              "expression": "@outputs('Match')?['kind']",
              "cases": {
                "Pack": {
                  "case": "pack",
                  "actions": {
                    "Append_pack": {
                      "runAfter": {},
                      "type": "AppendToArrayVariable",
                      "inputs": {
                        "name": "Targets",
                        "value": "@outputs('Match')"
                      }
                    }
                  }
                },
                "Product": {
                  "case": "product",
                  "actions": {
                    "Append_product": {
                      "runAfter": {},
                      "type": "AppendToArrayVariable",
                      "inputs": {
                        "name": "Targets",
                        "value": "@outputs('Match')"
                      }
                    }
                  }
                },
                "Several": {
                  "case": "ambiguous",
                  "actions": {
                    "Append_ambiguous": {
                      "runAfter": {},
                      "type": "AppendToArrayVariable",
                      "inputs": {
                        "name": "Ambiguous",
                        "value": "@items('Each_token')"
                      }
                    },
                    "Choice_names": {
                      "runAfter": {
                        "Append_ambiguous": [
                          "Succeeded"
                        ]
                      },
                      "type": "Select",
                      "inputs": {
                        "from": "@take(body('Contains_hit'), 10)",
                        "select": "@item()?['label']"
                      }
                    },
                    "Append_choices": {
                      "runAfter": {
                        "Choice_names": [
                          "Succeeded"
                        ]
                      },
                      "type": "AppendToStringVariable",
                      "inputs": {
                        "name": "Choices",
                        "value": "|@{join(body('Choice_names'), '|')}"
                      }
                    }
                  }
                }
              },
              "default": {
                "actions": {
                  "Append_unmatched": {
                    "runAfter": {},
                    "type": "AppendToArrayVariable",
                    "inputs": {
                      "name": "Unmatched",
                      "value": "@items('Each_token')"
                    }
                  }
                }
              }
            }
          }
        },
        "Choice_items": {
          "runAfter": {
            "Each_token": [
              "Succeeded"
            ]
          },
          "type": "Query",
          "inputs": {
            "from": "@union(split(variables('Choices'), '|'), json('[]'))",
            "where": "@not(empty(item()))"
          }
        },
        "Choice_list": {
          "runAfter": {
            "Choice_items": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@join(body('Choice_items'), '|')"
        },
        "Get_packs": {
          "runAfter": {
            "Followed_condition": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "ait_packs",
              "$select": "ait_packid,ait_code,ait_name",
              "$filter": "ait_isactive eq true"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Get_products": {
          "runAfter": {
            "Get_packs": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "ait_products",
              "$select": "ait_productid,ait_name,ait_displayname,ait_aliases",
              "$filter": "ait_isactive eq true"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Pack_candidates": {
          "runAfter": {
            "Get_products": [
              "Succeeded"
            ]
          },
          "type": "Select",
          "inputs": {
            "from": "@body('Get_packs')?['value']",
            "select": {
              "kind": "pack",
              "id": "@item()?['ait_packid']",
              "key": "@concat('pack:', item()?['ait_code'])",
              "label": "@concat('pack ', item()?['ait_code'], ' (', item()?['ait_name'], ')')",
              "code": "@toLower(item()?['ait_code'])",
              "name": "",
              "alt": "",
              "aliases": ""
            }
          }
        },
        "Product_candidates": {
          "runAfter": {
            "Pack_candidates": [
              "Succeeded"
            ]
          },
          "type": "Select",
          "inputs": {
            "from": "@body('Get_products')?['value']",
            "select": {
              "kind": "product",
              "id": "@item()?['ait_productid']",
              "key": "@concat('product:', item()?['ait_name'])",
              "label": "@item()?['ait_name']",
              "code": "",
              "name": "@toLower(item()?['ait_name'])",
              "alt": "@toLower(coalesce(item()?['ait_displayname'], item()?['ait_name']))",
              "aliases": "@concat(',', replace(replace(toLower(coalesce(item()?['ait_aliases'], '')), ' ,', ','), ', ', ','), ',')"
            }
          }
        },
        "Candidates": {
          "runAfter": {
            "Product_candidates": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@union(body('Pack_candidates'), body('Product_candidates'))"
        },
        "Get_subscriptions": {
          "runAfter": {
            "Choice_list": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "ait_subscriptions",
              "$select": "ait_targetkey",
              "$filter": "_ait_subscriberid_value eq @{variables('Subscriber')?['ait_subscriberid']}"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Existing_keys": {
          "runAfter": {
            "Get_subscriptions": [
              "Succeeded"
            ]
          },
          "type": "Select",
          "inputs": {
            "from": "@body('Get_subscriptions')?['value']",
            "select": "@item()?['ait_targetkey']"
          }
        },
        "New_targets": {
          "runAfter": {
            "Existing_keys": [
              "Succeeded"
            ]
          },
          "type": "Query",
          "inputs": {
            "from": "@union(variables('Targets'), variables('Targets'))",
            "where": "@not(contains(body('Existing_keys'), item()?['key']))"
          }
        },
        "Already_targets": {
          "runAfter": {
            "New_targets": [
              "Succeeded"
            ]
          },
          "type": "Query",
          "inputs": {
            "from": "@union(variables('Targets'), variables('Targets'))",
            "where": "@contains(body('Existing_keys'), item()?['key'])"
          }
        },
        "New_labels": {
          "runAfter": {
            "Already_targets": [
              "Succeeded"
            ]
          },
          "type": "Select",
          "inputs": {
            "from": "@body('New_targets')",
            "select": "@item()?['label']"
          }
        },
        "Already_labels": {
          "runAfter": {
            "New_labels": [
              "Succeeded"
            ]
          },
          "type": "Select",
          "inputs": {
            "from": "@body('Already_targets')",
            "select": "@item()?['label']"
          }
        },
        "New_conditions": {
          "runAfter": {
            "Already_labels": [
              "Succeeded"
            ]
          },
          "type": "Select",
          "inputs": {
            "from": "@body('New_targets')",
            "select": "@if(equals(item()?['kind'], 'pack'), concat('ait_pack_product/any(p: p/ait_packid eq ', item()?['id'], ')'), concat('ait_productid eq ', item()?['id']))"
          }
        },
        "Count_after": {
          "runAfter": {
            "New_conditions": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "ait_products",
              "$select": "ait_productid",
              "$filter": "ait_isactive eq true and (@{outputs('Followed_condition')}@{if(empty(body('New_conditions')), '', concat(' or ', join(body('New_conditions'), ' or ')))})"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Cap": {
          "runAfter": {
            "Count_after": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@int(coalesce(outputs('Settings')?['ait_MaxProductsPerUser'], '0'))"
        },
        "Over_cap": {
          "runAfter": {
            "Cap": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@and(greater(length(body('New_targets')), 0), greater(outputs('Cap'), 0), greater(length(body('Count_after')?['value']), outputs('Cap')))"
        },
        "Check_cap": {
          "runAfter": {
            "Over_cap": [
              "Succeeded"
            ]
          },
          "type": "If",
          "expression": "@not(outputs('Over_cap'))",
          "actions": {
            "Each_new_target": {
              "runAfter": {},
              "type": "Foreach",
              "foreach": "@body('New_targets')",
              "runtimeConfiguration": {
                "concurrency": {
                  "repetitions": 1
                }
              },
              "actions": {
                "Is_pack": {
                  "runAfter": {},
                  "type": "If",
                  "expression": "@equals(items('Each_new_target')?['kind'], 'pack')",
                  "actions": {
                    "Create_pack_subscription": {
                      "runAfter": {},
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "connectionName": "shared_commondataserviceforapps",
                          "operationId": "CreateRecord",
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                        },
                        "parameters": {
                          "entityName": "ait_subscriptions",
                          "item/ait_name": "@{take(concat(variables('Subscriber')?['ait_displayname'], ' · ', items('Each_new_target')?['key']), 100)}",
                          "item/ait_targetkey": "@items('Each_new_target')?['key']",
                          "item/ait_subscriberid@odata.bind": "/ait_subscribers(@{variables('Subscriber')?['ait_subscriberid']})",
                          "item/ait_packid@odata.bind": "/ait_packs(@{items('Each_new_target')?['id']})"
                        },
                        "authentication": "@parameters('$authentication')"
                      }
                    }
                  },
                  "else": {
                    "actions": {
                      "Create_product_subscription": {
                        "runAfter": {},
                        "type": "OpenApiConnection",
                        "inputs": {
                          "host": {
                            "connectionName": "shared_commondataserviceforapps",
                            "operationId": "CreateRecord",
                            "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                          },
                          "parameters": {
                            "entityName": "ait_subscriptions",
                            "item/ait_name": "@{take(concat(variables('Subscriber')?['ait_displayname'], ' · ', items('Each_new_target')?['key']), 100)}",
                            "item/ait_targetkey": "@items('Each_new_target')?['key']",
                            "item/ait_subscriberid@odata.bind": "/ait_subscribers(@{variables('Subscriber')?['ait_subscriberid']})",
                            "item/ait_productid@odata.bind": "/ait_products(@{items('Each_new_target')?['id']})"
                          },
                          "authentication": "@parameters('$authentication')"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "else": {
            "actions": {}
          }
        },
        "Count_now": {
          "runAfter": {
            "Check_cap": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "ait_products",
              "$select": "ait_productid",
              "$filter": "ait_isactive eq true and @{outputs('Followed_condition')}"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Lines": {
          "runAfter": {
            "Count_now": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": [
            "@{if(outputs('Over_cap'), concat('Not added: that would bring you to ', length(body('Count_after')?['value']), ' products, and the limit is ', outputs('Cap'), '. Remove some with /remove first, or add fewer.'), if(empty(body('New_labels')), '', concat('Added: ', join(body('New_labels'), ', '), '.')))}",
            "@{if(empty(body('Already_labels')), '', concat('Already following: ', join(body('Already_labels'), ', '), '.'))}",
            "@{if(empty(variables('Unmatched')), '', concat('No match for ''', join(variables('Unmatched'), ''', '''), '''. Try /products ', first(variables('Unmatched')), ' to search the catalog.'))}",
            "@{if(empty(variables('Ambiguous')), '', concat('More than one product matches ''', join(variables('Ambiguous'), ''', '''), '''. Pick one below.'))}",
            "@{concat('You follow ', length(body('Count_now')?['value']), ' products. Type /mysubs to see them.')}"
          ]
        },
        "Message_lines": {
          "runAfter": {
            "Lines": [
              "Succeeded"
            ]
          },
