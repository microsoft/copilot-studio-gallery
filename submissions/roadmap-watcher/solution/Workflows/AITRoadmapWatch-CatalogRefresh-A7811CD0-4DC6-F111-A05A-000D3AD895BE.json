{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "ait_Dataverse"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "type": "Object",
          "defaultValue": {}
        },
        "$authentication": {
          "type": "SecureObject",
          "defaultValue": {}
        }
      },
      "triggers": {
        "Recurrence": {
          "type": "Recurrence",
          "recurrence": {
            "frequency": "Week",
            "interval": 1,
            "schedule": {
              "weekDays": [
                "Monday"
              ],
              "hours": [
                "5"
              ],
              "minutes": [
                0
              ]
            },
            "timeZone": "UTC"
          },
          "runtimeConfiguration": {
            "concurrency": {
              "runs": 1
            }
          }
        }
      },
      "actions": {
        "Get_settings": {
          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "environmentvariabledefinitions",
              "$select": "schemaname,defaultvalue",
              "$filter": "startswith(schemaname, 'ait_')",
              "$expand": "environmentvariabledefinition_environmentvariablevalue($select=value)"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Select_settings": {
          "runAfter": {
            "Get_settings": [
              "Succeeded"
            ]
          },
          "type": "Select",
          "inputs": {
            "from": "@body('Get_settings')?['value']",
            "select": "@concat('\"', item()?['schemaname'], '\":\"', replace(replace(coalesce(first(item()?['environmentvariabledefinition_environmentvariablevalue'])?['value'], item()?['defaultvalue'], ''), '\\', '\\\\'), '\"', '\\\"'), '\"')"
          }
        },
        "Settings": {
          "runAfter": {
            "Select_settings": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@json(concat('{', join(body('Select_settings'), ','), '}'))"
        },
        "Create_run_log": {
          "runAfter": {
            "Settings": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "CreateRecord",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "ait_runlogs",
              "item/ait_name": "Catalog Refresh @{utcNow('yyyy-MM-dd HH:mm')} UTC",
              "item/ait_runtype": 748120001,
              "item/ait_runstatus": 748120000,
              "item/ait_startedon": "@utcNow()"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Try": {
          "runAfter": {
            "Create_run_log": [
              "Succeeded"
            ]
          },
          "type": "Scope",
          "actions": {
            "Call_catalog": {
              "runAfter": {},
              "type": "Http",
              "inputs": {
                "method": "POST",
                "uri": "@outputs('Settings')?['ait_McpServerUrl']",
                "headers": {
                  "Content-Type": "application/json",
                  "Accept": "application/json, text/event-stream"
                },
                "body": {
                  "jsonrpc": "2.0",
                  "id": 1,
                  "method": "tools/call",
                  "params": {
                    "name": "get_recent_m365_roadmaps",
                    "arguments": {
                      "filter": "modified ge @{formatDateTime(addDays(utcNow(), -365), 'yyyy-MM-ddTHH:mm:ssZ')}",
                      "include_facets": true,
                      "skip": 2000
                    }
                  }
                },
                "retryPolicy": {
                  "type": "exponential",
                  "count": 4,
                  "interval": "PT10S"
                }
              }
            },
            "Catalog": {
              "runAfter": {
                "Call_catalog": [
                  "Succeeded"
                ]
              },
              "type": "Compose",
              "inputs": "@json(json(trim(substring(string(body('Call_catalog')), add(indexOf(string(body('Call_catalog')), 'data:'), 5))))?['result']?['content'][0]?['text'])"
            },
            "Product_facet": {
              "runAfter": {
                "Catalog": [
                  "Succeeded"
                ]
              },
              "type": "Query",
              "inputs": {
                "from": "@coalesce(outputs('Catalog')?['facets'], json('[]'))",
                "where": "@equals(item()?['name'], 'Product')"
              }
            },
            "Facet_values": {
              "runAfter": {
                "Product_facet": [
                  "Succeeded"
                ]
              },
              "type": "Compose",
              "inputs": "@coalesce(first(body('Product_facet'))?['values'], json('[]'))"
            },
            "Check_facet": {
              "runAfter": {
                "Facet_values": [
                  "Succeeded"
                ]
              },
              "type": "If",
              "expression": "@equals(length(outputs('Facet_values')), 0)",
              "actions": {
                "No_products": {
                  "runAfter": {},
                  "type": "Compose",
                  "inputs": "@json('The MCP response had no Product facet values. Catalog left unchanged.')"
                }
              },
              "else": {
                "actions": {}
              }
            },
            "Get_products": {
              "runAfter": {
                "Check_facet": [
                  "Succeeded"
                ]
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "ListRecords",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "ait_products",
                  "$select": "ait_productid,ait_name"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Each_product": {
              "runAfter": {
                "Get_products": [
                  "Succeeded"
                ]
              },
              "type": "Foreach",
              "foreach": "@outputs('Facet_values')",
              "runtimeConfiguration": {
                "concurrency": {
                  "repetitions": 5
                }
              },
              "actions": {
                "Match": {
                  "runAfter": {},
                  "type": "Query",
                  "inputs": {
                    "from": "@body('Get_products')?['value']",
                    "where": "@equals(toLower(item()?['ait_name']), toLower(items('Each_product')?['value']))"
                  }
                },
                "Is_new": {
                  "runAfter": {
                    "Match": [
                      "Succeeded"
                    ]
                  },
                  "type": "If",
                  "expression": "@equals(length(body('Match')), 0)",
                  "actions": {
                    "Create_product": {
                      "runAfter": {},
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "connectionName": "shared_commondataserviceforapps",
                          "operationId": "CreateRecord",
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                        },
                        "parameters": {
                          "entityName": "ait_products",
                          "item/ait_name": "@{items('Each_product')?['value']}",
                          "item/ait_displayname": "@{items('Each_product')?['value']}",
                          "item/ait_lastseenon": "@utcNow()",
                          "item/ait_itemcount": "@items('Each_product')?['count']",
                          "item/ait_source": 748120000
                        },
                        "authentication": "@parameters('$authentication')"
                      }
                    }
                  },
                  "else": {
                    "actions": {
                      "Update_product": {
                        "runAfter": {},
                        "type": "OpenApiConnection",
                        "inputs": {
                          "host": {
                            "connectionName": "shared_commondataserviceforapps",
                            "operationId": "UpdateRecord",
                            "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                          },
                          "parameters": {
                            "entityName": "ait_products",
                            "recordId": "@{first(body('Match'))?['ait_productid']}",
                            "item/ait_lastseenon": "@utcNow()",
                            "item/ait_itemcount": "@items('Each_product')?['count']",
                            "item/ait_source": 748120000
                          },
                          "authentication": "@parameters('$authentication')"
                        }
                      }
                    }
                  }
                }
              }
            },
            "Azure_enabled": {
              "runAfter": {
                "Each_product": [
                  "Succeeded"
                ]
              },
              "type": "If",
              "expression": "@contains(createArray('yes', 'true', '1'), toLower(string(outputs('Settings')?['ait_HarvestAzure'])))",
              "actions": {
                "Call_azure_catalog": {
                  "runAfter": {},
                  "type": "Http",
                  "inputs": {
                    "method": "POST",
                    "uri": "@outputs('Settings')?['ait_McpServerUrl']",
                    "headers": {
                      "Content-Type": "application/json",
                      "Accept": "application/json, text/event-stream"
                    },
                    "body": {
                      "jsonrpc": "2.0",
                      "id": 1,
                      "method": "tools/call",
                      "params": {
                        "name": "get_recent_azure_updates",
                        "arguments": {
                          "filter": "modified ge @{formatDateTime(addDays(utcNow(), -365), 'yyyy-MM-ddTHH:mm:ssZ')}",
                          "include_facets": true,
                          "skip": 2000
                        }
                      }
                    },
                    "retryPolicy": {
                      "type": "exponential",
                      "count": 4,
                      "interval": "PT10S"
                    }
                  }
                },
                "Azure_catalog": {
                  "runAfter": {
                    "Call_azure_catalog": [
                      "Succeeded"
                    ]
                  },
                  "type": "Compose",
                  "inputs": "@json(json(trim(substring(string(body('Call_azure_catalog')), add(indexOf(string(body('Call_azure_catalog')), 'data:'), 5))))?['result']?['content'][0]?['text'])"
                },
                "Azure_product_facet": {
                  "runAfter": {
                    "Azure_catalog": [
                      "Succeeded"
                    ]
                  },
                  "type": "Query",
                  "inputs": {
                    "from": "@coalesce(outputs('Azure_catalog')?['facets'], json('[]'))",
                    "where": "@equals(item()?['name'], 'Product')"
                  }
                },
                "Azure_category_facet": {
                  "runAfter": {
                    "Azure_product_facet": [
                      "Succeeded"
                    ]
                  },
                  "type": "Query",
                  "inputs": {
                    "from": "@coalesce(outputs('Azure_catalog')?['facets'], json('[]'))",
                    "where": "@equals(item()?['name'], 'ProductCategory')"
                  }
                },
                "Azure_facet_values": {
                  "runAfter": {
                    "Azure_category_facet": [
                      "Succeeded"
                    ]
                  },
                  "type": "Compose",
                  "inputs": "@coalesce(first(body('Azure_product_facet'))?['values'], json('[]'))"
                },
                "Azure_categories": {
                  "runAfter": {
                    "Azure_facet_values": [
                      "Succeeded"
                    ]
                  },
                  "type": "Compose",
                  "inputs": "@coalesce(first(body('Azure_category_facet'))?['values'], json('[]'))"
                },
                "Check_azure_facet": {
                  "runAfter": {
                    "Azure_categories": [
                      "Succeeded"
                    ]
                  },
                  "type": "If",
                  "expression": "@equals(length(outputs('Azure_facet_values')), 0)",
                  "actions": {
                    "No_azure_products": {
                      "runAfter": {},
                      "type": "Compose",
                      "inputs": "@json('The MCP response had no Azure Product facet values. Azure catalog left unchanged.')"
                    }
                  },
                  "else": {
                    "actions": {}
                  }
                },
                "Get_azure_packs": {
                  "runAfter": {
                    "Check_azure_facet": [
                      "Succeeded"
                    ]
                  },
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "ListRecords",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "entityName": "ait_packs",
                      "$select": "ait_packid,ait_azurecategory",
                      "$filter": "ait_source eq 748120001 and ait_azurecategory ne null"
                    },
                    "authentication": "@parameters('$authentication')"
                  }
                },
                "Api_base": {
                  "runAfter": {
                    "Get_azure_packs": [
                      "Succeeded"
                    ]
                  },
                  "type": "Compose",
                  "inputs": "@{first(split(body('Get_azure_packs')?['@odata.context'], '$metadata'))}"
                },
                "Each_azure_product": {
                  "runAfter": {
                    "Api_base": [
                      "Succeeded"
                    ]
                  },
                  "type": "Foreach",
                  "foreach": "@outputs('Azure_facet_values')",
                  "runtimeConfiguration": {
                    "concurrency": {
                      "repetitions": 1
                    }
                  },
                  "actions": {
                    "Azure_match": {
                      "runAfter": {},
                      "type": "Query",
                      "inputs": {
                        "from": "@body('Get_products')?['value']",
                        "where": "@equals(toLower(item()?['ait_name']), toLower(items('Each_azure_product')?['value']))"
                      }
                    },
                    "Azure_is_new": {
                      "runAfter": {
                        "Azure_match": [
                          "Succeeded"
                        ]
                      },
                      "type": "If",
                      "expression": "@equals(length(body('Azure_match')), 0)",
                      "actions": {
                        "Create_azure_product": {
                          "runAfter": {},
                          "type": "OpenApiConnection",
                          "inputs": {
                            "host": {
                              "connectionName": "shared_commondataserviceforapps",
                              "operationId": "CreateRecord",
                              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                            },
                            "parameters": {
                              "entityName": "ait_products",
                              "item/ait_name": "@{items('Each_azure_product')?['value']}",
                              "item/ait_displayname": "@{items('Each_azure_product')?['value']}",
                              "item/ait_lastseenon": "@utcNow()",
                              "item/ait_itemcount": "@items('Each_azure_product')?['count']",
                              "item/ait_source": 748120001
                            },
                            "authentication": "@parameters('$authentication')"
                          }
                        },
                        "Product_categories": {
                          "runAfter": {
                            "Create_azure_product": [
                              "Succeeded"
                            ]
                          },
                          "type": "Query",
                          "inputs": {
                            "from": "@outputs('Azure_categories')",
                            "where": "@contains(string(coalesce(item()?['subFacets'], json('[]'))), concat('\"value\":\"', items('Each_azure_product')?['value'], '\"'))"
                          }
                        },
                        "Category_names": {
                          "runAfter": {
                            "Product_categories": [
                              "Succeeded"
                            ]
                          },
                          "type": "Select",
                          "inputs": {
                            "from": "@body('Product_categories')",
                            "select": "@toLower(item()?['value'])"
                          }
                        },
                        "Category_packs": {
                          "runAfter": {
                            "Category_names": [
                              "Succeeded"
                            ]
                          },
                          "type": "Query",
                          "inputs": {
                            "from": "@body('Get_azure_packs')?['value']",
                            "where": "@contains(body('Category_names'), toLower(item()?['ait_azurecategory']))"
                          }
                        },
                        "Each_category_pack": {
                          "runAfter": {
                            "Category_packs": [
                              "Succeeded"
                            ]
                          },
                          "type": "Foreach",
                          "foreach": "@body('Category_packs')",
                          "runtimeConfiguration": {
                            "concurrency": {
                              "repetitions": 1
                            }
                          },
                          "actions": {
                            "Link_product": {
                              "runAfter": {},
                              "type": "OpenApiConnection",
                              "inputs": {
                                "host": {
                                  "connectionName": "shared_commondataserviceforapps",
                                  "operationId": "AssociateEntities",
                                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                                },
                                "parameters": {
                                  "entityName": "ait_packs",
                                  "recordId": "@items('Each_category_pack')?['ait_packid']",
                                  "associationEntityRelationship": "ait_pack_product",
                                  "item/@odata.id": "@{outputs('Api_base')}ait_products(@{body('Create_azure_product')?['ait_productid']})"
                                },
                                "authentication": "@parameters('$authentication')"
                              }
                            }
                          }
                        }
                      },
                      "else": {
                        "actions": {
                          "Update_azure_product": {
                            "runAfter": {},
                            "type": "OpenApiConnection",
                            "inputs": {
                              "host": {
                                "connectionName": "shared_commondataserviceforapps",
                                "operationId": "UpdateRecord",
                                "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                              },
                              "parameters": {
                                "entityName": "ait_products",
                                "recordId": "@{first(body('Azure_match'))?['ait_productid']}",
                                "item/ait_lastseenon": "@utcNow()",
                                "item/ait_itemcount": "@items('Each_azure_product')?['count']",
                                "item/ait_source": 748120001
                              },
                              "authentication": "@parameters('$authentication')"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              },
              "else": {
                "actions": {}
              }
            },
            "Complete_run_log": {
              "runAfter": {
                "Azure_enabled": [
                  "Succeeded"
                ]
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "UpdateRecord",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "ait_runlogs",
                  "recordId": "@{body('Create_run_log')?['ait_runlogid']}",
                  "item/ait_runstatus": 748120001,
                  "item/ait_endedon": "@utcNow()",
                  "item/ait_itemcount": "@add(length(outputs('Facet_values')), if(equals(actions('Each_azure_product')?['status'], 'Succeeded'), length(outputs('Azure_facet_values')), 0))"
                },
                "authentication": "@parameters('$authentication')"
              }
            }
          }
        },
        "Catch": {
          "runAfter": {
            "Try": [
              "Failed",
              "TimedOut"
            ]
          },
          "type": "Scope",
          "actions": {
            "Failed_actions": {
              "runAfter": {},
              "type": "Query",
              "inputs": {
                "from": "@result('Try')",
                "where": "@equals(item()?['status'], 'Failed')"
              }
            },
            "Error_text": {
              "runAfter": {
                "Failed_actions": [
                  "Succeeded"
                ]
              },
              "type": "Select",
              "inputs": {
                "from": "@body('Failed_actions')",
                "select": "@concat(item()?['name'], ': ', coalesce(item()?['error']?['message'], string(item()?['outputs']?['body']), 'failed'))"
              }
            },
            "Fail_run_log": {
              "runAfter": {
                "Error_text": [
                  "Succeeded"
                ]
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "UpdateRecord",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "ait_runlogs",
                  "recordId": "@{body('Create_run_log')?['ait_runlogid']}",
                  "item/ait_runstatus": 748120002,
                  "item/ait_endedon": "@utcNow()",
                  "item/ait_error": "@{take(concat(join(body('Error_text'), ' | '), ' See the flow run history for details.'), 100000)}"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Stop_failed": {
              "runAfter": {
                "Fail_run_log": [
                  "Succeeded",
                  "Failed"
                ]
              },
              "type": "Terminate",
              "inputs": {
                "runStatus": "Failed",
                "runError": {
                  "code": "CatalogRefreshFailed",
                  "message": "Catalog Refresh failed. See ait_runlog."
                }
              }
            }
          }
        }
      }
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}