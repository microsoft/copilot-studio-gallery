{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "ait_Dataverse"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "type": "Object",
          "defaultValue": {}
        },
        "$authentication": {
          "type": "SecureObject",
          "defaultValue": {}
        }
      },
      "triggers": {
        "manual": {
          "type": "Request",
          "kind": "Skills",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "aadObjectId": {
                  "title": "aadObjectId",
                  "type": "string",
                  "description": "Entra object ID of the user (System.User.Id)",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                },
                "upn": {
                  "title": "upn",
                  "type": "string",
                  "description": "User principal name (System.User.PrincipalName)",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                },
                "displayName": {
                  "title": "displayName",
                  "type": "string",
                  "description": "Display name (System.User.DisplayName)",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                }
              },
              "required": [
                "aadObjectId"
              ]
            }
          }
        }
      },
      "actions": {
        "Get_settings": {
          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "environmentvariabledefinitions",
              "$select": "schemaname,defaultvalue",
              "$filter": "startswith(schemaname, 'ait_')",
              "$expand": "environmentvariabledefinition_environmentvariablevalue($select=value)"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Select_settings": {
          "runAfter": {
            "Get_settings": [
              "Succeeded"
            ]
          },
          "type": "Select",
          "inputs": {
            "from": "@body('Get_settings')?['value']",
            "select": "@concat('\"', item()?['schemaname'], '\":\"', replace(replace(coalesce(first(item()?['environmentvariabledefinition_environmentvariablevalue'])?['value'], item()?['defaultvalue'], ''), '\\', '\\\\'), '\"', '\\\"'), '\"')"
          }
        },
        "Settings": {
          "runAfter": {
            "Select_settings": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@json(concat('{', join(body('Select_settings'), ','), '}'))"
        },
        "Init_subscriber": {
          "runAfter": {
            "Settings": [
              "Succeeded"
            ]
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "Subscriber",
                "type": "object",
                "value": {}
              },
              {
                "name": "IsNewSubscriber",
                "type": "boolean",
                "value": false
              }
            ]
          }
        },
        "Find_subscriber": {
          "runAfter": {
            "Init_subscriber": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "ait_subscribers",
              "$filter": "ait_aadobjectid eq '@{replace(triggerBody()?['aadObjectId'], '''', '''''')}'",
              "$top": 1
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Check_subscriber": {
          "runAfter": {
            "Find_subscriber": [
              "Succeeded"
            ]
          },
          "type": "If",
          "expression": "@empty(body('Find_subscriber')?['value'])",
          "actions": {
            "Create_subscriber": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "CreateRecord",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "ait_subscribers",
                  "item/ait_displayname": "@{take(if(empty(triggerBody()?['displayName']), if(empty(triggerBody()?['upn']), triggerBody()?['aadObjectId'], triggerBody()?['upn']), triggerBody()?['displayName']), 100)}",
                  "item/ait_aadobjectid": "@triggerBody()?['aadObjectId']",
                  "item/ait_upn": "@triggerBody()?['upn']",
                  "item/ait_lookaheadmonths": "@int(outputs('Settings')?['ait_DefaultLookaheadMonths'])",
                  "item/ait_criticalwindowmonths": "@int(outputs('Settings')?['ait_DefaultCriticalWindowMonths'])",
                  "item/ait_frequency": 748120001,
                  "item/ait_weekday": 748120000,
                  "item/ait_ispaused": false,
                  "item/ait_sendemptydigest": "@contains(createArray('yes', 'true', '1'), toLower(string(outputs('Settings')?['ait_SendEmptyDigest'])))"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Set_new_subscriber": {
              "runAfter": {
                "Create_subscriber": [
                  "Succeeded"
                ]
              },
              "type": "SetVariable",
              "inputs": {
                "name": "Subscriber",
                "value": "@body('Create_subscriber')"
              }
            },
            "Set_is_new": {
              "runAfter": {
                "Set_new_subscriber": [
                  "Succeeded"
                ]
              },
              "type": "SetVariable",
              "inputs": {
                "name": "IsNewSubscriber",
                "value": true
              }
            }
          },
          "else": {
            "actions": {
              "Set_existing_subscriber": {
                "runAfter": {},
                "type": "SetVariable",
                "inputs": {
                  "name": "Subscriber",
                  "value": "@first(body('Find_subscriber')?['value'])"
                }
              }
            }
          }
        },
        "Followed_condition": {
          "runAfter": {
            "Check_subscriber": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "(ait_product_subscription/any(s: s/_ait_subscriberid_value eq @{variables('Subscriber')?['ait_subscriberid']}) or ait_pack_product/any(p: p/ait_isactive eq true and p/ait_pack_subscription/any(s: s/_ait_subscriberid_value eq @{variables('Subscriber')?['ait_subscriberid']})))"
        },
        "Get_pref_packs": {
          "runAfter": {
            "Followed_condition": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "ait_packs",
              "$select": "ait_packid,ait_code,ait_name,ait_source",
              "$filter": "ait_isactive eq true",
              "$orderby": "ait_name asc",
              "$expand": "ait_pack_product($select=ait_productid;$filter=ait_isactive eq true)"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Get_pref_products": {
          "runAfter": {
            "Get_pref_packs": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "ait_products",
              "$select": "ait_productid,ait_name,ait_displayname,ait_source",
              "$filter": "ait_isactive eq true",
              "$orderby": "ait_name asc"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Get_pref_subscriptions": {
          "runAfter": {
            "Get_pref_products": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "ait_subscriptions",
              "$select": "ait_subscriptionid,ait_targetkey,createdon",
              "$filter": "_ait_subscriberid_value eq @{variables('Subscriber')?['ait_subscriberid']}",
              "$orderby": "createdon desc"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Subscribed_keys": {
          "runAfter": {
            "Get_pref_subscriptions": [
              "Succeeded"
            ]
          },
          "type": "Select",
          "inputs": {
            "from": "@body('Get_pref_subscriptions')?['value']",
            "select": "@toLower(item()?['ait_targetkey'])"
          }
        },
        "Stamp": {
          "runAfter": {
            "Subscribed_keys": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@{variables('Subscriber')?['modifiedon']}|@{length(body('Subscribed_keys'))}|@{first(body('Get_pref_subscriptions')?['value'])?['createdon']}"
        },
        "Count_followed": {
          "runAfter": {
            "Stamp": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "ait_products",
              "$select": "ait_productid",
              "$filter": "ait_isactive eq true and @{outputs('Followed_condition')}"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "M365_packs": {
          "runAfter": {
            "Count_followed": [
              "Succeeded"
            ]
          },
          "type": "Query",
          "inputs": {
            "from": "@body('Get_pref_packs')?['value']",
            "where": "@not(equals(item()?['ait_source'], 748120001))"
          }
        },
        "Azure_packs": {
          "runAfter": {
            "M365_packs": [
              "Succeeded"
            ]
          },
          "type": "Query",
          "inputs": {
            "from": "@body('Get_pref_packs')?['value']",
            "where": "@equals(item()?['ait_source'], 748120001)"
          }
        },
        "Pack_choices": {
          "runAfter": {
            "Azure_packs": [
              "Succeeded"
            ]
          },
          "type": "Select",
          "inputs": {
            "from": "@body('M365_packs')",
            "select": {
              "title": "@{item()?['ait_name']} (@{length(coalesce(item()?['ait_pack_product'], json('[]')))} products)",
              "value": "@toLower(item()?['ait_code'])"
            }
          }
        },
        "Azure_pack_choices": {
          "runAfter": {
            "Pack_choices": [
              "Succeeded"
            ]
          },
          "type": "Select",
          "inputs": {
            "from": "@body('Azure_packs')",
            "select": {
              "title": "@{item()?['ait_name']} (@{length(coalesce(item()?['ait_pack_product'], json('[]')))} products)",
              "value": "@toLower(item()?['ait_code'])"
            }
          }
        },
        "Packs_followed": {
          "runAfter": {
            "Azure_pack_choices": [
              "Succeeded"
            ]
          },
          "type": "Query",
          "inputs": {
            "from": "@body('Pack_choices')",
            "where": "@contains(body('Subscribed_keys'), concat('pack:', item()?['value']))"
          }
        },
        "Azure_packs_followed": {
          "runAfter": {
            "Packs_followed": [
              "Succeeded"
            ]
          },
          "type": "Query",
          "inputs": {
            "from": "@body('Azure_pack_choices')",
            "where": "@contains(body('Subscribed_keys'), concat('pack:', item()?['value']))"
          }
        },
        "Pack_values": {
          "runAfter": {
            "Azure_packs_followed": [
              "Succeeded"
            ]
          },
          "type": "Select",
          "inputs": {
            "from": "@body('Packs_followed')",
            "select": "@item()?['value']"
          }
        },
        "Azure_pack_values": {
          "runAfter": {
            "Pack_values": [
              "Succeeded"
            ]
          },
          "type": "Select",
          "inputs": {
            "from": "@body('Azure_packs_followed')",
            "select": "@item()?['value']"
          }
        },
        "M365_products": {
          "runAfter": {
            "Azure_pack_values": [
              "Succeeded"
            ]
          },
          "type": "Query",
          "inputs": {
            "from": "@body('Get_pref_products')?['value']",
            "where": "@not(equals(item()?['ait_source'], 748120001))"
          }
        },
        "Azure_products": {
          "runAfter": {
            "M365_products": [
              "Succeeded"
            ]
          },
          "type": "Query",
          "inputs": {
            "from": "@body('Get_pref_products')?['value']",
            "where": "@equals(item()?['ait_source'], 748120001)"
          }
        },
        "Products_followed": {
          "runAfter": {
            "Azure_products": [
              "Succeeded"
            ]
          },
          "type": "Query",
          "inputs": {
            "from": "@body('M365_products')",
            "where": "@contains(body('Subscribed_keys'), toLower(concat('product:', item()?['ait_name'])))"
          }
        },
        "Azure_products_followed": {
          "runAfter": {
            "Products_followed": [
              "Succeeded"
            ]
          },
          "type": "Query",
          "inputs": {
            "from": "@body('Azure_products')",
            "where": "@contains(body('Subscribed_keys'), toLower(concat('product:', item()?['ait_name'])))"
          }
        },
        "Product_values": {
          "runAfter": {
            "Azure_products_followed": [
              "Succeeded"
            ]
          },
          "type": "Select",
          "inputs": {
            "from": "@body('Products_followed')",
            "select": "@item()?['ait_productid']"
          }
        },
        "Azure_product_values": {
          "runAfter": {
            "Product_values": [
              "Succeeded"
            ]
          },
          "type": "Select",
          "inputs": {
            "from": "@body('Azure_products_followed')",
            "select": "@item()?['ait_productid']"
          }
        },
        "Product_choices": {
          "runAfter": {
            "Azure_product_values": [
              "Succeeded"
            ]
          },
          "type": "Select",
          "inputs": {
            "from": "@body('M365_products')",
            "select": {
              "title": "@{coalesce(item()?['ait_displayname'], item()?['ait_name'])}",
              "value": "@item()?['ait_productid']"
            }
          }
        },
        "Azure_product_choices": {
          "runAfter": {
            "Product_choices": [
              "Succeeded"
            ]
          },
          "type": "Select",
          "inputs": {
            "from": "@body('Azure_products')",
            "select": {
              "title": "@{coalesce(item()?['ait_displayname'], item()?['ait_name'])}",
              "value": "@item()?['ait_productid']"
            }
          }
        },
        "Cap": {
          "runAfter": {
            "Azure_product_choices": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@int(coalesce(outputs('Settings')?['ait_MaxProductsPerUser'], '0'))"
        },
        "Summary": {
          "runAfter": {
            "Cap": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "You follow @{length(body('Count_followed')?['value'])} products@{if(greater(outputs('Cap'), 0), concat(' (limit ', outputs('Cap'), ')'), '')}. Next digest @{if(equals(variables('Subscriber')?['ait_ispaused'], true), 'paused', if(empty(variables('Subscriber')?['ait_nextdueon']), 'with the next daily run', concat(formatDateTime(coalesce(variables('Subscriber')?['ait_nextdueon'], '2000-01-01T00:00:00Z'), 'yyyy-MM-dd HH:mm'), ' UTC')))}; last digest @{if(empty(variables('Subscriber')?['ait_lastdigeston']), 'none yet', concat(formatDateTime(coalesce(variables('Subscriber')?['ait_lastdigeston'], '2000-01-01T00:00:00Z'), 'yyyy-MM-dd HH:mm'), ' UTC'))}."
        },
        "Card": {
          "runAfter": {
            "Summary": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": {
            "type": "AdaptiveCard",
            "version": "1.5",
            "body": [
              {
                "type": "TextBlock",
                "text": "My digest settings",
                "weight": "Bolder",
                "size": "Large",
                "wrap": true
              },
              {
                "type": "TextBlock",
                "text": "@{outputs('Summary')}",
                "isSubtle": true,
                "wrap": true
              },
              {
                "type": "Input.ChoiceSet",
                "id": "packs",
                "label": "Microsoft 365 packs",
                "isMultiSelect": true,
                "style": "expanded",
                "value": "@{join(body('Pack_values'), ',')}",
                "choices": "@body('Pack_choices')"
              },
              {
                "type": "Input.ChoiceSet",
                "id": "azurePacks",
                "label": "Azure packs",
                "isMultiSelect": true,
                "style": "compact",
                "placeholder": "Pick Azure packs",
                "value": "@{join(body('Azure_pack_values'), ',')}",
                "choices": "@body('Azure_pack_choices')"
              },
              {
                "type": "Input.ChoiceSet",
                "id": "products",
                "label": "Microsoft 365 products (besides those in your packs)",
                "isMultiSelect": true,
                "style": "compact",
                "placeholder": "Pick products",
                "value": "@{join(body('Product_values'), ',')}",
                "choices": "@body('Product_choices')"
              },
              {
                "type": "Input.ChoiceSet",
                "id": "azureProducts",
                "label": "Azure products (besides those in your packs)",
                "isMultiSelect": true,
                "style": "compact",
                "placeholder": "Pick Azure products",
                "value": "@{join(body('Azure_product_values'), ',')}",
                "choices": "@body('Azure_product_choices')"
              },
              {
                "type": "ColumnSet",
                "columns": [
                  {
                    "type": "Column",
                    "width": "stretch",
                    "items": [
                      {
                        "type": "Input.ChoiceSet",
                        "id": "frequency",
                        "label": "Frequency",
                        "value": "@{if(equals(variables('Subscriber')?['ait_frequency'], 748120000), 'Daily', if(equals(variables('Subscriber')?['ait_frequency'], 748120002), 'Monthly', 'Weekly'))}",
                        "choices": [
                          {
                            "title": "Daily",
                            "value": "Daily"
                          },
                          {
                            "title": "Weekly",
                            "value": "Weekly"
                          },
                          {
                            "title": "Monthly, on the 1st",
                            "value": "Monthly"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "Column",
                    "width": "stretch",
                    "items": [
                      {
                        "type": "Input.ChoiceSet",
                        "id": "weekday",
                        "label": "Day (weekly only)",
                        "value": "@{sub(coalesce(variables('Subscriber')?['ait_weekday'], 748120000), 748120000)}",
                        "choices": [
                          {
                            "title": "Monday",
                            "value": "0"
                          },
                          {
                            "title": "Tuesday",
                            "value": "1"
                          },
                          {
                            "title": "Wednesday",
                            "value": "2"
                          },
                          {
                            "title": "Thursday",
                            "value": "3"
                          },
                          {
                            "title": "Friday",
                            "value": "4"
                          },
                          {
                            "title": "Saturday",
                            "value": "5"
                          },
                          {
                            "title": "Sunday",
                            "value": "6"
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "type": "ColumnSet",
                "columns": [
                  {
                    "type": "Column",
                    "width": "stretch",
                    "items": [
                      {
                        "type": "Input.Number",
                        "id": "lookahead",
                        "label": "Look-ahead (months)",
                        "min": 1,
                        "max": 24,
                        "value": "@int(variables('Subscriber')?['ait_lookaheadmonths'])",
                        "isRequired": true,
                        "errorMessage": "Enter a whole number from 1 to 24."
                      }
                    ]
                  },
                  {
                    "type": "Column",
                    "width": "stretch",
                    "items": [
                      {
                        "type": "Input.Number",
                        "id": "critical",
                        "label": "Critical window (months)",
                        "min": 1,
                        "max": 24,
                        "value": "@int(variables('Subscriber')?['ait_criticalwindowmonths'])",
                        "isRequired": true,
                        "errorMessage": "Enter a whole number from 1 to 24."
                      }
                    ]
                  }
                ]
              },
              {
                "type": "Input.Toggle",
                "id": "sendEmpty",
                "title": "Send a digest even when there are no new items",
                "value": "@{if(equals(variables('Subscriber')?['ait_sendemptydigest'], true), 'true', 'false')}",
                "valueOn": "true",
                "valueOff": "false"
              },
              {
                "type": "Input.Toggle",
                "id": "paused",
                "title": "Pause my digests",
                "value": "@{if(equals(variables('Subscriber')?['ait_ispaused'], true), 'true', 'false')}",
                "valueOn": "true",
                "valueOff": "false"
              }
            ],
            "actions": [
              {
                "type": "Action.Submit",
                "title": "Save",
                "style": "positive",
                "data": {
                  "action": "savePreferences",
                  "stamp": "@{outputs('Stamp')}"
                }
              },
              {
                "type": "Action.Submit",
                "title": "Send digest now",
                "associatedInputs": "none",
                "data": {
                  "action": "digestNow"
                }
              }
            ]
          }
        },
        "Reply": {
          "runAfter": {
            "Card": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": {
            "card": "@{string(outputs('Card'))}",
            "message": ""
          }
        },
        "Respond_to_the_agent": {
          "runAfter": {
            "Reply": [
              "Succeeded"
            ]
          },
          "type": "Response",
          "kind": "Skills",
          "inputs": {
            "statusCode": 200,
            "schema": {
              "type": "object",
              "properties": {
                "card": {
                  "title": "card",
                  "description": "",
                  "type": "string",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                },
                "message": {
                  "title": "message",
                  "description": "",
                  "type": "string",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                }
              },
              "additionalProperties": {}
            },
            "body": {
              "card": "@{outputs('Reply')?['card']}",
              "message": "@{outputs('Reply')?['message']}"
            }
          }
        },
        "Respond_with_error": {
          "runAfter": {
            "Reply": [
              "Failed",
              "Skipped",
