{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "ait_Dataverse"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "type": "Object",
          "defaultValue": {}
        },
        "$authentication": {
          "type": "SecureObject",
          "defaultValue": {}
        }
      },
      "triggers": {
        "manual": {
          "type": "Request",
          "kind": "Skills",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "aadObjectId": {
                  "title": "aadObjectId",
                  "type": "string",
                  "description": "Entra object ID of the user (System.User.Id)",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                },
                "upn": {
                  "title": "upn",
                  "type": "string",
                  "description": "User principal name (System.User.PrincipalName)",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                },
                "displayName": {
                  "title": "displayName",
                  "type": "string",
                  "description": "Display name (System.User.DisplayName)",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                },
                "args": {
                  "title": "args",
                  "type": "string",
                  "description": "Comma-separated pack codes, product names or aliases, or 'all'",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                }
              },
              "required": [
                "aadObjectId",
                "args"
              ]
            }
          }
        }
      },
      "actions": {
        "Get_settings": {
          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "environmentvariabledefinitions",
              "$select": "schemaname,defaultvalue",
              "$filter": "startswith(schemaname, 'ait_')",
              "$expand": "environmentvariabledefinition_environmentvariablevalue($select=value)"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Select_settings": {
          "runAfter": {
            "Get_settings": [
              "Succeeded"
            ]
          },
          "type": "Select",
          "inputs": {
            "from": "@body('Get_settings')?['value']",
            "select": "@concat('\"', item()?['schemaname'], '\":\"', replace(replace(coalesce(first(item()?['environmentvariabledefinition_environmentvariablevalue'])?['value'], item()?['defaultvalue'], ''), '\\', '\\\\'), '\"', '\\\"'), '\"')"
          }
        },
        "Settings": {
          "runAfter": {
            "Select_settings": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@json(concat('{', join(body('Select_settings'), ','), '}'))"
        },
        "Init_subscriber": {
          "runAfter": {
            "Settings": [
              "Succeeded"
            ]
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "Subscriber",
                "type": "object",
                "value": {}
              },
              {
                "name": "IsNewSubscriber",
                "type": "boolean",
                "value": false
              }
            ]
          }
        },
        "Find_subscriber": {
          "runAfter": {
            "Init_subscriber": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "ait_subscribers",
              "$filter": "ait_aadobjectid eq '@{replace(triggerBody()?['aadObjectId'], '''', '''''')}'",
              "$top": 1
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Check_subscriber": {
          "runAfter": {
            "Find_subscriber": [
              "Succeeded"
            ]
          },
          "type": "If",
          "expression": "@empty(body('Find_subscriber')?['value'])",
          "actions": {
            "Create_subscriber": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "CreateRecord",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "ait_subscribers",
                  "item/ait_displayname": "@{take(if(empty(triggerBody()?['displayName']), if(empty(triggerBody()?['upn']), triggerBody()?['aadObjectId'], triggerBody()?['upn']), triggerBody()?['displayName']), 100)}",
                  "item/ait_aadobjectid": "@triggerBody()?['aadObjectId']",
                  "item/ait_upn": "@triggerBody()?['upn']",
                  "item/ait_lookaheadmonths": "@int(outputs('Settings')?['ait_DefaultLookaheadMonths'])",
                  "item/ait_criticalwindowmonths": "@int(outputs('Settings')?['ait_DefaultCriticalWindowMonths'])",
                  "item/ait_frequency": 748120001,
                  "item/ait_weekday": 748120000,
                  "item/ait_ispaused": false,
                  "item/ait_sendemptydigest": "@contains(createArray('yes', 'true', '1'), toLower(string(outputs('Settings')?['ait_SendEmptyDigest'])))"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Set_new_subscriber": {
              "runAfter": {
                "Create_subscriber": [
                  "Succeeded"
                ]
              },
              "type": "SetVariable",
              "inputs": {
                "name": "Subscriber",
                "value": "@body('Create_subscriber')"
              }
            },
            "Set_is_new": {
              "runAfter": {
                "Set_new_subscriber": [
                  "Succeeded"
                ]
              },
              "type": "SetVariable",
              "inputs": {
                "name": "IsNewSubscriber",
                "value": true
              }
            }
          },
          "else": {
            "actions": {
              "Set_existing_subscriber": {
                "runAfter": {},
                "type": "SetVariable",
                "inputs": {
                  "name": "Subscriber",
                  "value": "@first(body('Find_subscriber')?['value'])"
                }
              }
            }
          }
        },
        "Followed_condition": {
          "runAfter": {
            "Check_subscriber": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "(ait_product_subscription/any(s: s/_ait_subscriberid_value eq @{variables('Subscriber')?['ait_subscriberid']}) or ait_pack_product/any(p: p/ait_isactive eq true and p/ait_pack_subscription/any(s: s/_ait_subscriberid_value eq @{variables('Subscriber')?['ait_subscriberid']})))"
        },
        "Init_match": {
          "runAfter": {
            "Candidates": [
              "Succeeded"
            ]
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "Targets",
                "type": "array",
                "value": []
              },
              {
                "name": "Unmatched",
                "type": "array",
                "value": []
              },
              {
                "name": "Ambiguous",
                "type": "array",
                "value": []
              },
              {
                "name": "Choices",
                "type": "string",
                "value": ""
              }
            ]
          }
        },
        "Token_list": {
          "runAfter": {
            "Init_match": [
              "Succeeded"
            ]
          },
          "type": "Select",
          "inputs": {
            "from": "@split(coalesce(triggerBody()?['args'], ''), ',')",
            "select": "@toLower(trim(item()))"
          }
        },
        "Tokens": {
          "runAfter": {
            "Token_list": [
              "Succeeded"
            ]
          },
          "type": "Query",
          "inputs": {
            "from": "@union(body('Token_list'), body('Token_list'))",
            "where": "@not(empty(item()))"
          }
        },
        "Each_token": {
          "runAfter": {
            "Tokens": [
              "Succeeded"
            ]
          },
          "type": "Foreach",
          "foreach": "@body('Tokens')",
          "runtimeConfiguration": {
            "concurrency": {
              "repetitions": 1
            }
          },
          "actions": {
            "Pack_hit": {
              "runAfter": {},
              "type": "Query",
              "inputs": {
                "from": "@outputs('Candidates')",
                "where": "@and(equals(item()?['kind'], 'pack'), equals(item()?['code'], items('Each_token')))"
              }
            },
            "Exact_hit": {
              "runAfter": {
                "Pack_hit": [
                  "Succeeded"
                ]
              },
              "type": "Query",
              "inputs": {
                "from": "@outputs('Candidates')",
                "where": "@and(equals(item()?['kind'], 'product'), or(equals(item()?['name'], items('Each_token')), equals(item()?['alt'], items('Each_token')), contains(item()?['aliases'], concat(',', items('Each_token'), ','))))"
              }
            },
            "Contains_hit": {
              "runAfter": {
                "Exact_hit": [
                  "Succeeded"
                ]
              },
              "type": "Query",
              "inputs": {
                "from": "@outputs('Candidates')",
                "where": "@and(equals(item()?['kind'], 'product'), or(contains(item()?['name'], items('Each_token')), contains(item()?['alt'], items('Each_token'))))"
              }
            },
            "Match": {
              "runAfter": {
                "Contains_hit": [
                  "Succeeded"
                ]
              },
              "type": "Compose",
              "inputs": "@if(greater(length(body('Pack_hit')), 0), first(body('Pack_hit')), if(greater(length(body('Exact_hit')), 0), first(body('Exact_hit')), if(equals(length(body('Contains_hit')), 1), first(body('Contains_hit')), json(concat('{\"kind\":\"', if(greater(length(body('Contains_hit')), 1), 'ambiguous', 'none'), '\"}')))))"
            },
            "Route_match": {
              "runAfter": {
                "Match": [
                  "Succeeded"
                ]
              },
              "type": "Switch",
              "expression": "@outputs('Match')?['kind']",
              "cases": {
                "Pack": {
                  "case": "pack",
                  "actions": {
                    "Append_pack": {
                      "runAfter": {},
                      "type": "AppendToArrayVariable",
                      "inputs": {
                        "name": "Targets",
                        "value": "@outputs('Match')"
                      }
                    }
                  }
                },
                "Product": {
                  "case": "product",
                  "actions": {
                    "Append_product": {
                      "runAfter": {},
                      "type": "AppendToArrayVariable",
                      "inputs": {
                        "name": "Targets",
                        "value": "@outputs('Match')"
                      }
                    }
                  }
                },
                "Several": {
                  "case": "ambiguous",
                  "actions": {
                    "Append_ambiguous": {
                      "runAfter": {},
                      "type": "AppendToArrayVariable",
                      "inputs": {
                        "name": "Ambiguous",
                        "value": "@items('Each_token')"
                      }
                    },
                    "Choice_names": {
                      "runAfter": {
                        "Append_ambiguous": [
                          "Succeeded"
                        ]
                      },
                      "type": "Select",
                      "inputs": {
                        "from": "@take(body('Contains_hit'), 10)",
                        "select": "@item()?['label']"
                      }
                    },
                    "Append_choices": {
                      "runAfter": {
                        "Choice_names": [
                          "Succeeded"
                        ]
                      },
                      "type": "AppendToStringVariable",
                      "inputs": {
                        "name": "Choices",
                        "value": "|@{join(body('Choice_names'), '|')}"
                      }
                    }
                  }
                }
              },
              "default": {
                "actions": {
                  "Append_unmatched": {
                    "runAfter": {},
                    "type": "AppendToArrayVariable",
                    "inputs": {
                      "name": "Unmatched",
                      "value": "@items('Each_token')"
                    }
                  }
                }
              }
            }
          }
        },
        "Choice_items": {
          "runAfter": {
            "Each_token": [
              "Succeeded"
            ]
          },
          "type": "Query",
          "inputs": {
            "from": "@union(split(variables('Choices'), '|'), json('[]'))",
            "where": "@not(empty(item()))"
          }
        },
        "Choice_list": {
          "runAfter": {
            "Choice_items": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@join(body('Choice_items'), '|')"
        },
        "Get_subscriptions": {
          "runAfter": {
            "Followed_condition": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "ait_subscriptions",
              "$select": "ait_subscriptionid,ait_targetkey",
              "$filter": "_ait_subscriberid_value eq @{variables('Subscriber')?['ait_subscriberid']}",
              "$expand": "ait_productid($select=ait_name,ait_displayname,ait_aliases),ait_packid($select=ait_code,ait_name)"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Subscription_candidates": {
          "runAfter": {
            "Get_subscriptions": [
              "Succeeded"
            ]
          },
          "type": "Select",
          "inputs": {
            "from": "@body('Get_subscriptions')?['value']",
            "select": {
              "kind": "@if(empty(item()?['ait_packid']), 'product', 'pack')",
              "id": "@item()?['ait_subscriptionid']",
              "key": "@item()?['ait_targetkey']",
              "label": "@if(empty(item()?['ait_packid']), coalesce(item()?['ait_productid']?['ait_name'], item()?['ait_targetkey']), concat('pack ', item()?['ait_packid']?['ait_code'], ' (', item()?['ait_packid']?['ait_name'], ')'))",
              "code": "@toLower(coalesce(item()?['ait_packid']?['ait_code'], ''))",
              "name": "@toLower(coalesce(item()?['ait_productid']?['ait_name'], ''))",
              "alt": "@toLower(coalesce(item()?['ait_productid']?['ait_displayname'], item()?['ait_productid']?['ait_name'], ''))",
              "aliases": "@concat(',', replace(replace(toLower(coalesce(item()?['ait_productid']?['ait_aliases'], '')), ' ,', ','), ', ', ','), ',')"
            }
          }
        },
        "Candidates": {
          "runAfter": {
            "Subscription_candidates": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@body('Subscription_candidates')"
        },
        "Is_all": {
          "runAfter": {
            "Choice_list": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@equals(toLower(trim(coalesce(triggerBody()?['args'], ''))), 'all')"
        },
        "Removals": {
          "runAfter": {
            "Is_all": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@if(outputs('Is_all'), outputs('Candidates'), union(variables('Targets'), variables('Targets')))"
        },
        "Each_removal": {
          "runAfter": {
            "Removals": [
              "Succeeded"
            ]
          },
          "type": "Foreach",
          "foreach": "@outputs('Removals')",
          "runtimeConfiguration": {
            "concurrency": {
              "repetitions": 5
            }
          },
          "actions": {
            "Delete_subscription": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "DeleteRecord",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "ait_subscriptions",
                  "recordId": "@items('Each_removal')?['id']"
                },
                "authentication": "@parameters('$authentication')"
              }
            }
          }
        },
        "Removed_labels": {
          "runAfter": {
            "Each_removal": [
              "Succeeded"
            ]
          },
          "type": "Select",
          "inputs": {
            "from": "@outputs('Removals')",
            "select": "@item()?['label']"
          }
        },
        "Count_now": {
          "runAfter": {
            "Removed_labels": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "ait_products",
              "$select": "ait_productid",
              "$filter": "ait_isactive eq true and @{outputs('Followed_condition')}"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Lines": {
          "runAfter": {
            "Count_now": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": [
            "@{if(empty(body('Removed_labels')), if(outputs('Is_all'), 'You had no subscriptions.', ''), concat('Removed: ', join(body('Removed_labels'), ', '), '.'))}",
            "@{if(or(outputs('Is_all'), empty(variables('Unmatched'))), '', concat('You do not follow ''', join(variables('Unmatched'), ''', '''), ''' directly. A product that comes with a pack can only be removed with its pack. Type /mysubs to see what you follow.'))}",
            "@{if(empty(variables('Ambiguous')), '', concat('More than one of your subscriptions matches ''', join(variables('Ambiguous'), ''', '''), '''. Pick one below.'))}",
            "@{if(equals(length(body('Count_now')?['value']), 0), 'You follow no products now, so no digests will be sent. Type /packs or /products to start again.', concat('You follow ', length(body('Count_now')?['value']), ' products now.'))}"
          ]
        },
        "Message_lines": {
          "runAfter": {
            "Lines": [
              "Succeeded"
            ]
          },
          "type": "Query",
          "inputs": {
            "from": "@outputs('Lines')",
            "where": "@not(empty(item()))"
          }
        },
        "Reply": {
          "runAfter": {
            "Message_lines": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": {
            "message": "@{join(body('Message_lines'), decodeUriComponent('%0A%0A'))}",
            "choices": "@{if(outputs('Is_all'), '', outputs('Choice_list'))}"
          }
        },
        "Respond_to_the_agent": {
          "runAfter": {
            "Reply": [
              "Succeeded"
            ]
          },
          "type": "Response",
          "kind": "Skills",
          "inputs": {
            "statusCode": 200,
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "title": "message",
                  "description": "",
                  "type": "string",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                },
                "choices": {
                  "title": "choices",
                  "description": "",
                  "type": "string",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                }
              },
              "additionalProperties": {}
            },
            "body": {
              "message": "@{outputs('Reply')?['message']}",
              "choices": "@{outputs('Reply')?['choices']}"
            }
          }
        },
        "Respond_with_error": {
          "runAfter": {
            "Reply": [
              "Failed",
              "Skipped",
              "TimedOut"
            ]
          },
          "type": "Response",
          "kind": "Skills",
          "inputs": {
            "statusCode": 200,
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "title": "message",
                  "description": "",
                  "type": "string",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                },
                "choices": {
                  "title": "choices",
                  "description": "",
                  "type": "string",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                }
              },
              "additionalProperties": {}
            },
            "body": {
              "message": "Sorry, something went wrong on my side. Please try again in a few minutes.",
              "choices": ""
            }
          }
        }
      }
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}