{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "ait_Dataverse"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "type": "Object",
          "defaultValue": {}
        },
        "$authentication": {
          "type": "SecureObject",
          "defaultValue": {}
        }
      },
      "triggers": {
        "manual": {
          "type": "Request",
          "kind": "Skills",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "id": {
                  "title": "id",
                  "type": "string",
                  "description": "Microsoft 365 roadmap ID or Azure update ID, optionally as azure-<id> (the topic validates it)",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                }
              },
              "required": [
                "id"
              ]
            }
          }
        }
      },
      "actions": {
        "Get_settings": {
          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "environmentvariabledefinitions",
              "$select": "schemaname,defaultvalue",
              "$filter": "startswith(schemaname, 'ait_')",
              "$expand": "environmentvariabledefinition_environmentvariablevalue($select=value)"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Select_settings": {
          "runAfter": {
            "Get_settings": [
              "Succeeded"
            ]
          },
          "type": "Select",
          "inputs": {
            "from": "@body('Get_settings')?['value']",
            "select": "@concat('\"', item()?['schemaname'], '\":\"', replace(replace(coalesce(first(item()?['environmentvariabledefinition_environmentvariablevalue'])?['value'], item()?['defaultvalue'], ''), '\\', '\\\\'), '\"', '\\\"'), '\"')"
          }
        },
        "Settings": {
          "runAfter": {
            "Select_settings": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@json(concat('{', join(body('Select_settings'), ','), '}'))"
        },
        "Id": {
          "runAfter": {
            "Settings": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": {
            "azure": "@startsWith(toLower(trim(triggerBody()?['id'])), 'azure-')",
            "bare": "@if(startsWith(toLower(trim(triggerBody()?['id'])), 'azure-'), substring(trim(triggerBody()?['id']), 6), trim(triggerBody()?['id']))"
          }
        },
        "Call_item": {
          "runAfter": {
            "Id": [
              "Succeeded"
            ]
          },
          "type": "Http",
          "inputs": {
            "method": "POST",
            "uri": "@outputs('Settings')?['ait_McpServerUrl']",
            "headers": {
              "Content-Type": "application/json",
              "Accept": "application/json, text/event-stream"
            },
            "body": {
              "jsonrpc": "2.0",
              "id": 1,
              "method": "tools/call",
              "params": {
                "name": "@{if(outputs('Id')?['azure'], 'get_azure_update_by_id', 'get_m365_roadmap_by_id')}",
                "arguments": {
                  "id": "@{outputs('Id')?['bare']}"
                }
              }
            },
            "retryPolicy": {
              "type": "fixed",
              "count": 2,
              "interval": "PT5S"
            }
          }
        },
        "Envelope": {
          "runAfter": {
            "Call_item": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@json(trim(substring(string(body('Call_item')), add(indexOf(string(body('Call_item')), 'data:'), 5))))"
        },
        "Item_text": {
          "runAfter": {
            "Envelope": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@if(or(equals(outputs('Envelope')?['result']?['isError'], true), empty(outputs('Envelope')?['result']?['content'])), '{}', coalesce(first(outputs('Envelope')?['result']?['content'])?['text'], '{}'))"
        },
        "First_item": {
          "runAfter": {
            "Item_text": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@json(outputs('Item_text'))"
        },
        "Try_azure": {
          "runAfter": {
            "First_item": [
              "Succeeded"
            ]
          },
          "type": "If",
          "expression": "@and(empty(outputs('First_item')?['title']), not(outputs('Id')?['azure']))",
          "actions": {
            "Call_azure_item": {
              "runAfter": {},
              "type": "Http",
              "inputs": {
                "method": "POST",
                "uri": "@outputs('Settings')?['ait_McpServerUrl']",
                "headers": {
                  "Content-Type": "application/json",
                  "Accept": "application/json, text/event-stream"
                },
                "body": {
                  "jsonrpc": "2.0",
                  "id": 1,
                  "method": "tools/call",
                  "params": {
                    "name": "get_azure_update_by_id",
                    "arguments": {
                      "id": "@{outputs('Id')?['bare']}"
                    }
                  }
                },
                "retryPolicy": {
                  "type": "fixed",
                  "count": 2,
                  "interval": "PT5S"
                }
              }
            },
            "Azure_Envelope": {
              "runAfter": {
                "Call_azure_item": [
                  "Succeeded"
                ]
              },
              "type": "Compose",
              "inputs": "@json(trim(substring(string(body('Call_azure_item')), add(indexOf(string(body('Call_azure_item')), 'data:'), 5))))"
            },
            "Azure_Item_text": {
              "runAfter": {
                "Azure_Envelope": [
                  "Succeeded"
                ]
              },
              "type": "Compose",
              "inputs": "@if(or(equals(outputs('Azure_Envelope')?['result']?['isError'], true), empty(outputs('Azure_Envelope')?['result']?['content'])), '{}', coalesce(first(outputs('Azure_Envelope')?['result']?['content'])?['text'], '{}'))"
            }
          },
          "else": {
            "actions": {}
          }
        },
        "Is_azure": {
          "runAfter": {
            "Try_azure": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@or(outputs('Id')?['azure'], and(empty(outputs('First_item')?['title']), not(empty(json(coalesce(outputs('Azure_Item_text'), '{}'))?['title']))))"
        },
        "Item": {
          "runAfter": {
            "Is_azure": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@if(and(outputs('Is_azure'), not(outputs('Id')?['azure'])), json(coalesce(outputs('Azure_Item_text'), '{}')), outputs('First_item'))"
        },
        "Description": {
          "runAfter": {
            "Item": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@coalesce(outputs('Item')?['description'], '')"
        },
        "Reply": {
          "runAfter": {
            "Description": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": {
            "message": "@{if(empty(outputs('Item')?['title']), concat('I could not find item ', trim(triggerBody()?['id']), ' on the Microsoft 365 roadmap or in Azure Updates. Check the ID.'), join(createArray(concat('**', if(outputs('Is_azure'), 'Azure · ', ''), outputs('Item')?['title'], '**'), concat(join(coalesce(outputs('Item')?['products'], json('[]')), ', '), ' · ', coalesce(outputs('Item')?['status'], 'no status'), if(empty(outputs('Item')?['generalAvailabilityDate']), '', concat(' · GA ', outputs('Item')?['generalAvailabilityDate'])), if(empty(outputs('Item')?['previewAvailabilityDate']), '', concat(' · Preview ', outputs('Item')?['previewAvailabilityDate'])), ' · ', join(coalesce(outputs('Item')?['cloudInstances'], outputs('Item')?['tags'], json('[]')), ', ')), if(greater(length(outputs('Description')), 3000), concat(take(outputs('Description'), 3000), '…'), outputs('Description')), if(outputs('Is_azure'), concat('[Open in Azure Updates](https://azure.microsoft.com/updates?id=', encodeUriComponent(outputs('Id')?['bare']), ')'), concat('[Open in the Microsoft 365 roadmap](https://www.microsoft.com/microsoft-365/roadmap?id=', outputs('Id')?['bare'], ')'))), decodeUriComponent('%0A%0A')))}"
          }
        },
        "Respond_to_the_agent": {
          "runAfter": {
            "Reply": [
              "Succeeded"
            ]
          },
          "type": "Response",
          "kind": "Skills",
          "inputs": {
            "statusCode": 200,
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "title": "message",
                  "description": "",
                  "type": "string",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                }
              },
              "additionalProperties": {}
            },
            "body": {
              "message": "@{outputs('Reply')?['message']}"
            }
          }
        },
        "Respond_with_error": {
          "runAfter": {
            "Reply": [
              "Failed",
              "Skipped",
              "TimedOut"
            ]
          },
          "type": "Response",
          "kind": "Skills",
          "inputs": {
            "statusCode": 200,
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "title": "message",
                  "description": "",
                  "type": "string",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                }
              },
              "additionalProperties": {}
            },
            "body": {
              "message": "Sorry, something went wrong on my side. Please try again in a few minutes."
            }
          }
        }
      }
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}