---
import Layout from "../layouts/Layout.astro";
import { withBase } from "../lib/url";
---

<Layout title="Page not found">
  <div class="mx-auto grid min-h-[60vh] max-w-2xl place-items-center px-4 py-16 text-center sm:px-6">
    <div>
      <p class="font-mono text-xs font-bold uppercase tracking-[0.14em] text-accent">404 · Route ended</p>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight text-ink">This path is not in the graph.</h1>
      <p class="mt-4 text-muted">Return to the gallery to browse published solutions.</p>
      <a href={withBase("/")} class="mt-6 inline-flex rounded-[0.625rem] bg-accent px-4 py-2.5 text-sm font-semibold text-accent-fg hover:bg-accent-hover">Back to gallery</a>
    </div>
  </div>
</Layout>
