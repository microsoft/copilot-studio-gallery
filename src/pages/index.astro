---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import SolutionCard from "../components/SolutionCard.astro";
import { collectContributors, collectTags } from "../lib/catalog";
import { authorKey, solutionMakeup } from "../lib/schema";
import { withBase } from "../lib/url";

const solutions = (await getCollection("solutions")).sort(
  (a, b) => Number(b.data.featured) - Number(a.data.featured) || a.data.name.localeCompare(b.data.name),
);
const tags = collectTags(solutions);
const popularTags = tags.slice(0, 8);
const contributors = collectContributors(solutions);
const featuredSolutions = solutions.filter((solution) => solution.data.featured);
---

<Layout>
  <section class="studio-canvas border-b border-border">
    <div class="mx-auto w-full max-w-gallery px-4 py-10 sm:px-6 sm:py-12">
      <div class="mx-auto max-w-4xl text-center">
        <h1 class="text-4xl font-semibold leading-[1.08] tracking-[-0.045em] text-ink sm:text-5xl">
          The community gallery for Copilot Studio <span class="studio-gradient-text">agents and workflows</span>
        </h1>
        <p class="mx-auto mt-4 max-w-2xl text-base leading-7 text-muted sm:text-lg">
          Discover ideas from the community, learn from working examples, and submit your own.
        </p>
      </div>
    </div>
  </section>

  <section class="border-b border-border bg-elevated">
    <div class="mx-auto w-full max-w-gallery px-4 py-10 sm:px-6">
      <div class="flex items-end justify-between gap-4">
        <div>
          <p class="text-xs font-semibold text-accent">Featured</p>
          <h2 id="editor-picks-title" class="mt-1 text-2xl font-semibold tracking-[-0.02em] text-ink">Editor’s picks</h2>
        </div>
        <div class="flex gap-2" aria-label="Editor’s picks carousel controls">
          <button
            id="featured-previous"
            type="button"
            aria-label="Show previous editor’s picks"
            aria-controls="featured-carousel"
            class="grid h-10 w-10 place-items-center rounded-full border border-border bg-surface text-lg text-ink transition hover:border-accent hover:text-accent disabled:cursor-default disabled:opacity-35"
          >
            ←
          </button>
          <button
            id="featured-next"
            type="button"
            aria-label="Show next editor’s picks"
            aria-controls="featured-carousel"
            class="grid h-10 w-10 place-items-center rounded-full border border-border bg-surface text-lg text-ink transition hover:border-accent hover:text-accent disabled:cursor-default disabled:opacity-35"
          >
            →
          </button>
        </div>
      </div>
      <div
        id="featured-carousel"
        class="featured-carousel mt-5 flex snap-x snap-mandatory gap-4 overflow-x-auto pb-2"
        role="region"
        aria-labelledby="editor-picks-title"
        tabindex="0"
      >
        {featuredSolutions.map((solution) => (
          <div class="featured-slide snap-start">
            <SolutionCard solution={solution} compact />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="solution-catalog" class="scroll-mt-6 bg-page">
    <div class="mx-auto w-full max-w-gallery px-4 py-10 sm:px-6 sm:py-12">
      <div class="mb-6 flex items-end justify-between gap-4">
        <div>
          <p class="text-xs font-semibold text-accent">Community library</p>
          <h2 class="mt-1 text-3xl font-semibold tracking-[-0.03em] text-ink">All solutions</h2>
          <p class="mt-2 max-w-xl text-sm leading-6 text-muted">Filter the complete library by what it contains, who built it, or the work it helps with.</p>
        </div>
        <p id="result-count" class="shrink-0 pb-1 text-sm font-medium text-muted">{solutions.length} solutions</p>
      </div>
      <div class="rounded-2xl border border-border bg-surface p-3 card-shadow">
        <div class="grid gap-3 lg:grid-cols-[minmax(18rem,1fr)_auto_auto]">
          <label class="relative">
            <span class="sr-only">Search solutions</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="pointer-events-none absolute left-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-soft" aria-hidden="true">
              <circle cx="11" cy="11" r="7"></circle><path d="m20 20-4-4"></path>
            </svg>
            <input id="solution-search" type="search" autocomplete="off" placeholder="Search agents, workflows, use cases, or contributors…" class="h-11 w-full rounded-lg border border-border bg-elevated pl-10 pr-3 text-sm text-ink placeholder:text-soft" />
          </label>
          <label>
            <span class="sr-only">Filter by solution makeup</span>
            <select id="makeup-filter" class="h-11 w-full rounded-lg border border-border bg-elevated px-3 text-sm text-ink lg:w-48">
              <option value="">All solution types</option>
              <option>Agents + workflows</option>
              <option>Agents</option>
              <option>Workflows</option>
            </select>
          </label>
          <label>
            <span class="sr-only">Sort solutions</span>
            <select id="sort-select" class="h-11 w-full rounded-lg border border-border bg-elevated px-3 text-sm text-ink lg:w-36">
              <option value="newest">Newest</option>
              <option value="name">Name</option>
            </select>
          </label>
        </div>

        <div id="discovery-filters" class="relative mt-3 flex flex-nowrap items-center gap-2 overflow-x-auto border-t border-border pt-3 sm:flex-wrap sm:overflow-visible">
          <button type="button" data-tag-all aria-pressed="true" class="filter-pill shrink-0 rounded-full border border-accent bg-accent-soft px-3 py-1.5 text-sm font-medium text-accent">
            All tags
          </button>
          {popularTags.map(([tag, total], index) => (
            <button
              type="button"
              data-tag-inline
              data-tag={tag}
              aria-pressed="false"
              class:list={[
                "filter-pill shrink-0 rounded-full border border-border bg-elevated px-3 py-1.5 text-sm font-medium text-muted transition hover:border-accent hover:text-ink",
                index >= 3 && "hidden sm:inline-flex",
              ]}
            >
              {tag}<span class="ml-1.5 text-xs text-soft">{total}</span>
            </button>
          ))}

          <div id="tag-backdrop" class="fixed inset-0 z-40 hidden bg-black/40 sm:hidden" aria-hidden="true"></div>
          <div class="relative shrink-0">
            <button type="button" id="tag-more" aria-expanded="false" aria-haspopup="true" class="rounded-full border border-dashed border-border px-3 py-1.5 text-sm font-medium text-accent transition hover:border-accent">
              More tags <span id="tag-count"></span>▾
            </button>
            <div id="tag-panel" class="fixed inset-x-0 bottom-0 z-50 hidden max-h-[72vh] overflow-y-auto rounded-t-2xl border border-border bg-surface p-4 shadow-2xl sm:absolute sm:inset-x-auto sm:bottom-auto sm:left-0 sm:top-full sm:mt-2 sm:w-80 sm:rounded-xl">
              <div class="mb-3 flex items-center justify-between sm:hidden">
                <span class="font-semibold text-ink">Filter by tag</span>
                <button type="button" id="tag-sheet-close" class="grid h-8 w-8 place-items-center rounded-lg text-muted hover:bg-surface-soft" aria-label="Close tag filter">×</button>
              </div>
              <label for="tag-search" class="sr-only">Search tags</label>
              <input id="tag-search" type="search" placeholder="Search tags…" autocomplete="off" class="w-full rounded-lg border border-border bg-elevated px-3 py-2 text-sm text-ink placeholder:text-soft" />
              <div id="tag-list" class="mt-3 flex max-h-[52vh] flex-wrap gap-2 overflow-y-auto sm:max-h-64">
                {tags.map(([tag, total]) => (
                  <button type="button" data-tag-list data-tag={tag} aria-pressed="false" class="filter-pill rounded-full border border-border bg-elevated px-3 py-1.5 text-sm font-medium text-muted hover:border-accent hover:text-ink">
                    {tag}<span class="ml-1.5 text-xs text-soft">{total}</span>
                  </button>
                ))}
              </div>
            </div>
          </div>

          <span class="mx-1 hidden h-5 w-px shrink-0 bg-border sm:block" aria-hidden="true"></span>

          <div id="contributor-backdrop" class="fixed inset-0 z-40 hidden bg-black/40 sm:hidden" aria-hidden="true"></div>
          <div class="relative shrink-0">
            <button type="button" id="contributor-more" aria-expanded="false" aria-haspopup="true" class="inline-flex items-center gap-1.5 rounded-full border border-dashed border-border px-3 py-1.5 text-sm font-medium text-accent transition hover:border-accent">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-4 w-4" aria-hidden="true">
                <circle cx="12" cy="8" r="3.25"></circle><path d="M5.5 19.2a6.5 6.5 0 0 1 13 0"></path>
              </svg>
              Contributors <span id="contributor-count"></span>▾
            </button>
            <div id="contributor-panel" class="fixed inset-x-0 bottom-0 z-50 hidden max-h-[72vh] overflow-y-auto rounded-t-2xl border border-border bg-surface p-4 shadow-2xl sm:absolute sm:inset-x-auto sm:bottom-auto sm:left-0 sm:top-full sm:mt-2 sm:w-80 sm:rounded-xl">
              <div class="mb-3 flex items-center justify-between sm:hidden">
                <span class="font-semibold text-ink">Filter by contributor</span>
                <button type="button" id="contributor-sheet-close" class="grid h-8 w-8 place-items-center rounded-lg text-muted hover:bg-surface-soft" aria-label="Close contributor filter">×</button>
              </div>
              <label for="contributor-search" class="sr-only">Search contributors</label>
              <input id="contributor-search" type="search" placeholder="Search contributors…" autocomplete="off" class="w-full rounded-lg border border-border bg-elevated px-3 py-2 text-sm text-ink placeholder:text-soft" />
              <div id="contributor-list" class="mt-2 flex max-h-[52vh] flex-col gap-1 overflow-y-auto sm:max-h-72">
                {contributors.map((contributor) => (
                  <button
                    type="button"
                    data-contributor-item
                    data-key={contributor.key}
                    data-name={contributor.name}
                    data-github={contributor.github ?? ""}
                    aria-pressed="false"
                    class="contributor-item flex w-full items-center gap-2.5 rounded-lg px-2 py-2 text-left hover:bg-surface-soft"
                  >
                    <span class="grid h-7 w-7 shrink-0 place-items-center overflow-hidden rounded-full bg-accent-soft text-[10px] font-bold text-accent">
                      {contributor.github ? <img src={`https://github.com/${contributor.github}.png?size=56`} alt="" class="h-full w-full object-cover" loading="lazy" /> : contributor.name.slice(0, 2).toUpperCase()}
                    </span>
                    <span class="contributor-name min-w-0 flex-1 truncate text-sm font-medium text-ink">{contributor.name}</span>
                    <span class="text-xs text-soft">{contributor.count}</span>
                  </button>
                ))}
              </div>
              <a href={withBase("/contributors")} class="mt-3 flex items-center justify-center rounded-lg border border-border px-3 py-2 text-sm font-semibold text-ink hover:border-accent">Browse contributor directory</a>
            </div>
          </div>
        </div>

        <div id="active-filters" class="hidden flex-wrap items-center gap-2 border-t border-border pt-3">
          <span id="contributor-chips" class="contents"></span>
          <span id="tag-chips" class="contents"></span>
        </div>
      </div>
      <div id="gallery" class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-3">
      {
        solutions.map((solution) => (
          <article
            class="solution-item"
            data-name={solution.data.name.toLowerCase()}
            data-description={solution.data.description.toLowerCase()}
            data-tags={solution.data.tags.join(",").toLowerCase()}
            data-author={authorKey(solution.data.authorGithub, solution.data.author)}
            data-author-name={solution.data.author.toLowerCase()}
            data-agents={solution.data.agents.map((agent) => agent.name).join(" ").toLowerCase()}
            data-workflows={solution.data.workflows.map((workflow) => workflow.name).join(" ").toLowerCase()}
            data-makeup={solutionMakeup(solution.data.agentCount, solution.data.workflowCount)}
            data-featured={solution.data.featured ? "1" : "0"}
            data-updated={solution.data.updatedAt ?? solution.data.createdAt ?? ""}
          >
            <SolutionCard solution={solution} />
          </article>
        ))
      }
    </div>
    <div id="empty-state" class:list={["rounded-2xl border border-dashed border-border bg-elevated px-6 py-14 text-center", solutions.length ? "hidden" : ""]}>
      <p class="text-lg font-semibold text-ink">{solutions.length ? "No solutions match these filters" : "The first solution is on its way"}</p>
      <p class="mx-auto mt-2 max-w-lg text-sm leading-relaxed text-muted">
        {solutions.length ? "Clear one or more filters to widen the gallery." : "Contribute an exploded Copilot Studio solution to make its agents and workflows visible before import."}
      </p>
    </div>
    <div id="scroll-sentinel" class="flex h-16 items-end justify-center text-sm text-soft" aria-live="polite">
      <span id="load-status">Scroll to load more</span>
    </div>
    </div>
  </section>
</Layout>

<script>
  const featuredCarousel = document.getElementById("featured-carousel")!;
  const featuredPrevious = document.getElementById("featured-previous") as HTMLButtonElement;
  const featuredNext = document.getElementById("featured-next") as HTMLButtonElement;

  function updateFeaturedControls() {
    const maxScroll = featuredCarousel.scrollWidth - featuredCarousel.clientWidth;
    featuredPrevious.disabled = featuredCarousel.scrollLeft <= 1;
    featuredNext.disabled = featuredCarousel.scrollLeft >= maxScroll - 1;
  }

  function scrollFeatured(direction: -1 | 1) {
    const slide = featuredCarousel.querySelector<HTMLElement>(".featured-slide");
    if (!slide) return;
    const gap = Number.parseFloat(getComputedStyle(featuredCarousel).columnGap) || 16;
    featuredCarousel.scrollBy({
      left: direction * (slide.offsetWidth + gap),
      behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth",
    });
  }

  featuredPrevious.addEventListener("click", () => scrollFeatured(-1));
  featuredNext.addEventListener("click", () => scrollFeatured(1));
  featuredCarousel.addEventListener("keydown", (event) => {
    if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
    event.preventDefault();
    scrollFeatured(event.key === "ArrowLeft" ? -1 : 1);
  });
  featuredCarousel.addEventListener("scroll", updateFeaturedControls, { passive: true });
  new ResizeObserver(updateFeaturedControls).observe(featuredCarousel);
  updateFeaturedControls();

  const BATCH = 8;
  const gallery = document.getElementById("gallery")!;
  const items = Array.from(gallery.querySelectorAll<HTMLElement>(".solution-item"));
  const search = document.getElementById("solution-search") as HTMLInputElement;
  const makeup = document.getElementById("makeup-filter") as HTMLSelectElement;
  const sort = document.getElementById("sort-select") as HTMLSelectElement;
  const count = document.getElementById("result-count")!;
  const empty = document.getElementById("empty-state")!;
  const sentinel = document.getElementById("scroll-sentinel")!;
  const loadStatus = document.getElementById("load-status")!;
  const filters = document.getElementById("discovery-filters")!;
  const tagAll = filters.querySelector<HTMLButtonElement>("[data-tag-all]")!;
  const tagInline = Array.from(filters.querySelectorAll<HTMLButtonElement>("[data-tag-inline]"));
  const tagList = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-tag-list]"));
  const tagMore = document.getElementById("tag-more")!;
  const tagCount = document.getElementById("tag-count")!;
  const tagPanel = document.getElementById("tag-panel")!;
  const tagSearch = document.getElementById("tag-search") as HTMLInputElement;
  const tagBackdrop = document.getElementById("tag-backdrop")!;
  const tagSheetClose = document.getElementById("tag-sheet-close")!;
  const contributorMore = document.getElementById("contributor-more")!;
  const contributorCount = document.getElementById("contributor-count")!;
  const contributorPanel = document.getElementById("contributor-panel")!;
  const contributorSearch = document.getElementById("contributor-search") as HTMLInputElement;
  const contributorBackdrop = document.getElementById("contributor-backdrop")!;
  const contributorSheetClose = document.getElementById("contributor-sheet-close")!;
  const contributorItems = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-contributor-item]"));
  const activeFilters = document.getElementById("active-filters")!;
  const tagChips = document.getElementById("tag-chips")!;
  const contributorChips = document.getElementById("contributor-chips")!;
  const activeTags = new Set<string>();
  const activeAuthors = new Set<string>();
  let query = "";
  let shown = BATCH;
  let matched = items;

  function selectedValues(param: string): string[] {
    return (new URLSearchParams(location.search).get(param) ?? "")
      .split(",")
      .map((value) => value.trim())
      .filter(Boolean);
  }

  function syncUrl() {
    const params = new URLSearchParams();
    if (query) params.set("q", search.value.trim());
    if (makeup.value) params.set("makeup", makeup.value);
    if (activeTags.size) params.set("tag", [...activeTags].join(","));
    if (activeAuthors.size) params.set("author", [...activeAuthors].join(","));
    if (sort.value !== "newest") params.set("sort", sort.value);
    const next = `${location.pathname}${params.size ? `?${params}` : ""}`;
    history.replaceState(null, "", next);
  }

  function computeMatched(): HTMLElement[] {
    matched = items.filter((item) => {
      const text = `${item.dataset.name} ${item.dataset.description} ${item.dataset.tags} ${item.dataset.agents} ${item.dataset.workflows}`;
      const tags = (item.dataset.tags ?? "").split(",");
      return (!query || `${text} ${item.dataset.authorName ?? ""}`.includes(query))
        && (!makeup.value || item.dataset.makeup === makeup.value)
        && (activeTags.size === 0 || tags.some((tag) => activeTags.has(tag)))
        && (activeAuthors.size === 0 || activeAuthors.has(item.dataset.author ?? ""));
    });
    return matched.sort((a, b) => {
      if (sort.value === "name") return (a.dataset.name ?? "").localeCompare(b.dataset.name ?? "");
      return (b.dataset.updated ?? "").localeCompare(a.dataset.updated ?? "") || (a.dataset.name ?? "").localeCompare(b.dataset.name ?? "");
    });
  }

  function render() {
    const fragment = document.createDocumentFragment();
    matched.forEach((item) => fragment.appendChild(item));
    items.filter((item) => !matched.includes(item)).forEach((item) => fragment.appendChild(item));
    gallery.appendChild(fragment);
    items.forEach((item) => item.classList.add("hidden"));
    matched.slice(0, shown).forEach((item) => item.classList.remove("hidden"));
    count.textContent = `${matched.length} ${matched.length === 1 ? "solution" : "solutions"}`;
    loadStatus.textContent = matched.length === 0
      ? ""
      : shown < matched.length
        ? `Showing ${Math.min(shown, matched.length)} of ${matched.length} · scroll to load more`
        : `All ${matched.length} loaded`;
    empty.classList.toggle("hidden", matched.length > 0);
  }

  function refresh() {
    computeMatched();
    shown = BATCH;
    render();
    syncUrl();
  }

  function paintFilterButton(button: HTMLButtonElement, selected: boolean) {
    button.setAttribute("aria-pressed", String(selected));
    button.classList.toggle("border-accent", selected);
    button.classList.toggle("bg-accent-soft", selected);
    button.classList.toggle("text-accent", selected);
    button.classList.toggle("border-border", !selected);
    button.classList.toggle("bg-elevated", !selected);
    button.classList.toggle("text-muted", !selected);
  }

  function updateActiveFilterLayout() {
    const hasFilters = activeTags.size > 0 || activeAuthors.size > 0;
    activeFilters.classList.toggle("hidden", !hasFilters);
    activeFilters.classList.toggle("flex", hasFilters);
  }

  function removableChip(label: string, remove: () => void, avatar?: string): HTMLButtonElement {
    const chip = document.createElement("button");
    chip.type = "button";
    chip.className = "inline-flex max-w-full items-center gap-1.5 rounded-full border border-accent bg-accent-soft py-1 pl-2.5 pr-2 text-sm font-medium text-accent";
    chip.setAttribute("aria-label", `Remove filter: ${label}`);
    if (avatar) {
      const image = document.createElement("img");
      image.src = avatar;
      image.alt = "";
      image.className = "h-5 w-5 rounded-full object-cover";
      chip.appendChild(image);
    }
    const text = document.createElement("span");
    text.className = "max-w-52 truncate";
    text.textContent = label;
    chip.appendChild(text);
    const close = document.createElement("span");
    close.setAttribute("aria-hidden", "true");
    close.textContent = "×";
    chip.appendChild(close);
    chip.addEventListener("click", remove);
    return chip;
  }

  function paintTags() {
    paintFilterButton(tagAll, activeTags.size === 0);
    [...tagInline, ...tagList].forEach((button) => paintFilterButton(button, activeTags.has(button.dataset.tag ?? "")));
    tagCount.textContent = activeTags.size ? `${activeTags.size} ` : "";
    tagChips.replaceChildren();
    activeTags.forEach((tag) => tagChips.appendChild(removableChip(tag, () => toggleTag(tag))));
    updateActiveFilterLayout();
  }

  function toggleTag(tag: string) {
    if (!tag) return;
    if (activeTags.has(tag)) activeTags.delete(tag);
    else activeTags.add(tag);
    paintTags();
    refresh();
  }

  function contributorMeta(key: string) {
    const button = contributorItems.find((item) => item.dataset.key === key);
    return {
      name: button?.dataset.name ?? key,
      github: button?.dataset.github ?? "",
    };
  }

  function paintContributors() {
    contributorItems.forEach((button) => {
      const selected = activeAuthors.has(button.dataset.key ?? "");
      button.setAttribute("aria-pressed", String(selected));
      button.classList.toggle("bg-accent-soft", selected);
      button.querySelector(".contributor-name")?.classList.toggle("text-accent", selected);
    });
    contributorCount.textContent = activeAuthors.size ? `${activeAuthors.size} ` : "";
    contributorChips.replaceChildren();
    activeAuthors.forEach((key) => {
      const { name, github } = contributorMeta(key);
      const avatar = github ? `https://github.com/${github}.png?size=40` : undefined;
      contributorChips.appendChild(removableChip(name, () => toggleContributor(key), avatar));
    });
    updateActiveFilterLayout();
  }

  function toggleContributor(key: string) {
    if (!key) return;
    if (activeAuthors.has(key)) activeAuthors.delete(key);
    else activeAuthors.add(key);
    paintContributors();
    refresh();
  }

  function setPanel(type: "tag" | "contributor", open: boolean) {
    const panel = type === "tag" ? tagPanel : contributorPanel;
    const trigger = type === "tag" ? tagMore : contributorMore;
    const backdrop = type === "tag" ? tagBackdrop : contributorBackdrop;
    const otherPanel = type === "tag" ? contributorPanel : tagPanel;
    const otherTrigger = type === "tag" ? contributorMore : tagMore;
    const otherBackdrop = type === "tag" ? contributorBackdrop : tagBackdrop;
    otherPanel.classList.add("hidden");
    otherBackdrop.classList.add("hidden");
    otherTrigger.setAttribute("aria-expanded", "false");
    panel.classList.toggle("hidden", !open);
    backdrop.classList.toggle("hidden", !open);
    trigger.setAttribute("aria-expanded", String(open));
    if (open && matchMedia("(min-width: 640px)").matches) {
      (type === "tag" ? tagSearch : contributorSearch).focus();
    }
  }

  tagAll.addEventListener("click", () => {
    activeTags.clear();
    paintTags();
    refresh();
  });
  tagInline.forEach((button) => button.addEventListener("click", () => toggleTag(button.dataset.tag ?? "")));
  tagList.forEach((button) => button.addEventListener("click", () => toggleTag(button.dataset.tag ?? "")));
  contributorItems.forEach((button) => button.addEventListener("click", () => toggleContributor(button.dataset.key ?? "")));
  tagMore.addEventListener("click", (event) => {
    event.stopPropagation();
    setPanel("tag", tagPanel.classList.contains("hidden"));
  });
  contributorMore.addEventListener("click", (event) => {
    event.stopPropagation();
    setPanel("contributor", contributorPanel.classList.contains("hidden"));
  });
  tagSheetClose.addEventListener("click", () => setPanel("tag", false));
  contributorSheetClose.addEventListener("click", () => setPanel("contributor", false));
  tagBackdrop.addEventListener("click", () => setPanel("tag", false));
  contributorBackdrop.addEventListener("click", () => setPanel("contributor", false));
  tagSearch.addEventListener("input", () => {
    const term = tagSearch.value.trim().toLowerCase();
    tagList.forEach((button) => button.classList.toggle("hidden", !(button.dataset.tag ?? "").includes(term)));
  });
  contributorSearch.addEventListener("input", () => {
    const term = contributorSearch.value.trim().toLowerCase();
    contributorItems.forEach((button) => {
      const value = `${button.dataset.name ?? ""} ${button.dataset.github ?? ""}`.toLowerCase();
      button.classList.toggle("hidden", !value.includes(term));
    });
  });
  document.addEventListener("click", (event) => {
    const target = event.target as Node;
    if (!tagPanel.classList.contains("hidden") && !tagPanel.contains(target) && !tagMore.contains(target)) setPanel("tag", false);
    if (!contributorPanel.classList.contains("hidden") && !contributorPanel.contains(target) && !contributorMore.contains(target)) setPanel("contributor", false);
  });
  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    setPanel("tag", false);
    setPanel("contributor", false);
  });

  let timer: number | undefined;
  search.addEventListener("input", () => {
    clearTimeout(timer);
    timer = window.setTimeout(() => {
      query = search.value.trim().toLowerCase();
      refresh();
    }, 120);
  });
  for (const control of [makeup, sort]) {
    control.addEventListener("change", () => {
      refresh();
    });
  }
  new IntersectionObserver((entries) => {
    if (!entries[0]?.isIntersecting || shown >= matched.length) return;
    shown = Math.min(shown + BATCH, matched.length);
    render();
  }, { rootMargin: "400px" }).observe(sentinel);

  const params = new URLSearchParams(location.search);
  query = (params.get("q") ?? "").trim().toLowerCase();
  search.value = params.get("q") ?? "";
  makeup.value = params.get("makeup") ?? "";
  sort.value = params.get("sort") === "name" ? "name" : "newest";
  selectedValues("tag").forEach((tag) => activeTags.add(tag));
  selectedValues("author").map((author) => author.toLowerCase()).forEach((author) => activeAuthors.add(author));
  paintTags();
  paintContributors();
  computeMatched();
  render();
</script>
