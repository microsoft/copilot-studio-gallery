---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import MicrosoftBadge from "../components/MicrosoftBadge.astro";
import SolutionCard from "../components/SolutionCard.astro";
import { compareSolutions } from "../lib/catalog";
import { withBase } from "../lib/url";

const solutions = (await getCollection("solutions")).filter((solution) => solution.data.featured).sort(compareSolutions);
---

<Layout title="Built by Microsoft" description="Copilot Studio solutions built by Microsoft.">
  <main class="mx-auto w-full max-w-gallery px-4 py-10 sm:px-6">
    <a href={withBase("/")} class="inline-flex items-center gap-1.5 text-sm text-muted transition hover:text-accent">
      <span aria-hidden="true">←</span> All solutions
    </a>
    <div class="mt-7 flex flex-wrap items-end justify-between gap-4">
      <div>
        <MicrosoftBadge size="md" />
        <h1 class="mt-3 text-3xl font-semibold tracking-[-0.025em] text-ink sm:text-4xl">Solutions from Microsoft</h1>
        <p class="mt-2 max-w-2xl text-muted">
          Agents and workflows built by Microsoft teams. Review each solution before importing it into your environment.
        </p>
      </div>
      <p class="text-sm font-medium text-muted">{solutions.length} solution{solutions.length === 1 ? "" : "s"}</p>
    </div>
    {
      solutions.length > 0 ? (
        <div class="mt-7 grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-3">
          {solutions.map((solution) => <SolutionCard solution={solution} />)}
        </div>
      ) : (
        <div class="mt-7 rounded-2xl border border-dashed border-border bg-elevated px-6 py-14 text-center text-muted">
          No Microsoft-built solutions have been published yet.
        </div>
      )
    }
  </main>
</Layout>
