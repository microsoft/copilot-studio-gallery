---
import Layout from "../layouts/Layout.astro";
import SolutionGallery from "../components/SolutionGallery.astro";
import { withBase } from "../lib/url";
---

<Layout title="Built by Microsoft" description="Copilot Studio solutions built by Microsoft.">
  <section class="mx-auto w-full max-w-gallery px-4 py-10 sm:px-6" aria-labelledby="microsoft-heading">
    <a data-gallery-link href={withBase("/")} class="inline-flex items-center gap-1.5 text-sm text-muted transition hover:text-accent">
      <span aria-hidden="true">←</span> All solutions
    </a>
    <div class="mt-7">
      <h1 id="microsoft-heading" class="text-3xl font-semibold tracking-[-0.025em] text-ink sm:text-4xl">Built by Microsoft</h1>
      <p class="mt-2 max-w-2xl text-muted">
        Agents and workflows built by Microsoft teams. Review each solution before importing it into your environment.
      </p>
    </div>
  </section>
  <SolutionGallery scope="microsoft" />
</Layout>
