---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { collectContributors } from "../lib/catalog";
import { withBase } from "../lib/url";

const contributors = collectContributors(await getCollection("solutions"));
const solutionTotal = contributors.reduce((total, contributor) => total + contributor.count, 0);
const MAX_SOLUTIONS = 8;
---

<Layout title="Contributors">
  <main class="mx-auto w-full max-w-gallery px-4 py-10 sm:px-6">
    <header class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-xs font-semibold text-accent">Community</p>
        <h1 class="mt-1 text-3xl font-semibold tracking-[-0.025em] text-ink sm:text-4xl">Contributors</h1>
        <p class="mt-3 max-w-2xl text-muted">People and teams sharing complete Copilot Studio solutions with the community.</p>
        <p class="mt-2 text-sm text-soft">{contributors.length} contributors · {solutionTotal} solutions</p>
      </div>
      <label class="relative w-full sm:max-w-xs">
        <span class="sr-only">Search contributors</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="pointer-events-none absolute left-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-soft" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle><path d="m20 20-4-4"></path>
        </svg>
        <input id="directory-search" type="search" autocomplete="off" placeholder="Search contributors or solutions" class="h-11 w-full rounded-lg border border-border bg-surface pl-10 pr-3 text-sm text-ink placeholder:text-soft" />
      </label>
    </header>

    <div class="mt-8 flex items-baseline justify-between gap-3">
      <h2 class="text-lg font-semibold text-ink">All contributors</h2>
      <span id="directory-count" class="text-sm text-muted">{contributors.length} shown</span>
    </div>

    <ul id="contributor-directory" class="mt-4 grid grid-cols-1 items-stretch gap-4 sm:grid-cols-2 xl:grid-cols-[repeat(auto-fill,minmax(19rem,1fr))]" role="list">
      {contributors.map((contributor) => {
        const shown = contributor.solutions.slice(0, MAX_SOLUTIONS);
        const extra = contributor.solutions.length - shown.length;
        return (
          <li
            class="contributor-card product-card flex flex-col rounded-2xl border border-border bg-surface p-5"
            data-search={`${contributor.name} ${contributor.github ?? ""} ${contributor.solutions.map((solution) => solution.data.name).join(" ")}`.toLowerCase()}
          >
            <div class="flex items-center gap-3">
              <a href={withBase(`/contributors/${contributor.key}`)} class="shrink-0" aria-label={`View ${contributor.name}'s contributor profile`}>
                <span class="grid h-12 w-12 place-items-center overflow-hidden rounded-full border border-border bg-accent-soft text-sm font-bold text-accent">
                  {contributor.github
                    ? <img src={`https://github.com/${contributor.github}.png?size=96`} alt="" class="h-full w-full object-cover" loading="lazy" />
                    : contributor.name.slice(0, 2).toUpperCase()}
                </span>
              </a>
              <div class="min-w-0 flex-1">
                <a href={withBase(`/contributors/${contributor.key}`)} class="block truncate font-semibold text-ink hover:text-accent">{contributor.name}</a>
                {contributor.github && <a href={`https://github.com/${contributor.github}`} target="_blank" rel="noopener" class="mt-0.5 block truncate text-sm text-muted hover:text-accent">@{contributor.github}</a>}
              </div>
              <a href={withBase(`/contributors/${contributor.key}`)} class="shrink-0 text-right text-accent" aria-label={`View ${contributor.name}'s contributor profile`}>
                <span class="block text-xl font-semibold">{contributor.count}</span>
                <span class="block text-[11px] text-soft">solution{contributor.count === 1 ? "" : "s"}</span>
              </a>
            </div>

            <ul class="mt-4 flex flex-wrap gap-1.5" role="list">
              {shown.map((solution) => (
                <li>
                  <a href={withBase(`/solutions/${solution.id}`)} title={solution.data.name} class="inline-flex max-w-full items-center gap-1.5 rounded-full bg-surface-soft px-2.5 py-1 text-xs font-medium text-muted hover:text-accent">
                    {solution.data.featured && <span class="text-warning" aria-label="Featured">★</span>}
                    <span class="max-w-52 truncate">{solution.data.name}</span>
                  </a>
                </li>
              ))}
              {extra > 0 && <li class="rounded-full border border-dashed border-border px-2.5 py-1 text-xs text-soft">+{extra} more</li>}
            </ul>

            <div class="mt-auto flex flex-wrap gap-x-4 gap-y-1 border-t border-border pt-4 text-xs text-muted">
              <span>{contributor.agents} agents</span>
              <span>{contributor.workflows} workflows</span>
              {contributor.featured > 0 && <span>{contributor.featured} featured</span>}
            </div>
          </li>
        );
      })}
    </ul>

    <div id="directory-empty" class="mt-8 hidden rounded-2xl border border-dashed border-border bg-elevated px-6 py-14 text-center">
      <p class="font-semibold text-ink">No contributors match that search</p>
      <p class="mt-2 text-sm text-muted">Try a contributor name, GitHub handle, or solution title.</p>
    </div>
  </main>
</Layout>

<script>
  const search = document.getElementById("directory-search") as HTMLInputElement;
  const cards = Array.from(document.querySelectorAll<HTMLElement>(".contributor-card"));
  const count = document.getElementById("directory-count")!;
  const empty = document.getElementById("directory-empty")!;

  search.addEventListener("input", () => {
    const query = search.value.trim().toLowerCase();
    const matched = cards.filter((card) => (card.dataset.search ?? "").includes(query));
    cards.forEach((card) => card.classList.toggle("hidden", !matched.includes(card)));
    count.textContent = `${matched.length} shown`;
    empty.classList.toggle("hidden", matched.length > 0);
  });
</script>
