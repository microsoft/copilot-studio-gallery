---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import AgentMatrix from "../../components/AgentMatrix.astro";
import BuildingBlocks from "../../components/BuildingBlocks.astro";
import MicrosoftBadge from "../../components/MicrosoftBadge.astro";
import SolutionDownload from "../../components/SolutionDownload.astro";
import GraphCanvas from "../../components/graph/GraphCanvas";
import WorkflowExplorer from "../../components/graph/WorkflowExplorer";
import { agentProfiles, inventoryBlocks, solutionInventory } from "../../lib/inventory";
import { authorKey, solutionMakeup } from "../../lib/schema";
import { withBase } from "../../lib/url";
import { workflowConnectorNames, workflowMetadataNotice, workflowTriggerType } from "../../lib/workflowMetadata";

export async function getStaticPaths() {
  const solutions = await getCollection("solutions");
  return solutions.map((solution) => ({
    params: { slug: solution.id },
    props: { solution },
  }));
}

const { solution } = Astro.props;
const data = solution.data;
const guides = await getCollection("guides");
const guide = guides.find((entry) => entry.id === solution.id);
const GuideContent = guide ? (await render(guide)).Content : null;
const inventory = solutionInventory(data);
const profiles = agentProfiles(data);
const makeup = solutionMakeup(inventory.agents, inventory.workflows);
const contributorKey = authorKey(data.authorGithub, data.author);
const updated = data.updatedAt ?? data.createdAt;
const categoryCounts = new Map<string, number>();
for (const file of data.files) categoryCounts.set(file.category, (categoryCounts.get(file.category) ?? 0) + 1);
const categories = [...categoryCounts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
const heroWorkflow = data.workflows[0];
---

<Layout title={data.name} description={data.description}>
  <div class="mx-auto w-full max-w-gallery px-4 py-6 sm:px-6 sm:py-8">
    <a href={withBase("/")} class="inline-flex items-center gap-1.5 text-sm text-muted hover:text-accent">
      <span aria-hidden="true">←</span> Back to gallery
    </a>

    <section class="mt-5 overflow-hidden rounded-2xl border border-border bg-surface card-shadow">
      <div class="p-6 sm:p-8">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <p class="text-sm font-semibold text-accent">{makeup}</p>
          {data.featured && <MicrosoftBadge size="md" />}
        </div>
        <h1 class="mt-2 text-3xl font-semibold tracking-[-0.025em] text-ink sm:text-4xl">{data.name}</h1>
        <p class="mt-4 max-w-4xl text-lg leading-relaxed text-muted">{data.description}</p>
        <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-muted">
          <a href={withBase(`/contributors/${contributorKey}`)} class="font-semibold text-ink hover:text-accent">by {data.author}</a>
          <span>Version {data.version}</span>
          {updated && <span>Updated {updated}</span>}
        </div>
        <div data-download-compact class="mt-5 xl:hidden">
          <SolutionDownload solution={data} idPrefix="compact-download" compact />
        </div>
        <div class="mt-6 flex flex-wrap items-center gap-3">
          <span class="text-sm font-medium text-ink">What’s in the solution</span>
          <BuildingBlocks counts={inventoryBlocks(inventory)} size="md" />
        </div>
      </div>
      {
        heroWorkflow ? (
          <div class="solution-hero-preview relative hidden overflow-hidden border-t border-border bg-elevated text-muted sm:block">
            <GraphCanvas
              graph={heroWorkflow.graph}
              label={`${heroWorkflow.name} workflow preview`}
              agents={profiles}
              compact
              client:media="(min-width: 640px)"
            />
          </div>
        ) : (
          <div class="studio-canvas border-t border-border px-4 py-6 sm:px-8 sm:py-8">
            <AgentMatrix agents={profiles} compact />
          </div>
        )
      }
        <div class="flex flex-wrap items-center gap-2 border-t border-border px-6 py-4 sm:px-8">
          <a href={withBase(`/?category=${encodeURIComponent(data.category)}`)} class="rounded-full border border-accent/40 bg-accent-soft px-3 py-1 text-sm font-medium text-accent hover:border-accent">{data.category}</a>
          {data.tags.map((tag) => <a href={withBase(`/tags/${encodeURIComponent(tag)}`)} class="rounded-full border border-border bg-surface-soft px-3 py-1 text-sm text-muted hover:border-accent hover:text-ink">{tag}</a>)}
        </div>
    </section>

    <div class="mt-6 flex flex-col gap-6 xl:grid xl:grid-cols-[minmax(0,1fr)_18rem]">
      <div class="min-w-0">
        <div class="overflow-x-auto border-b border-border">
          <div id="detail-tabs" class="flex min-w-max gap-1" role="tablist" aria-label="Solution sections">
            <button type="button" role="tab" aria-selected="true" aria-controls="panel-overview" data-tab="overview" class="detail-tab border-b-2 border-accent px-4 py-3 text-sm font-semibold text-accent">Overview</button>
            <button type="button" role="tab" aria-selected="false" aria-controls="panel-agents" data-tab="agents" class="detail-tab border-b-2 border-border px-4 py-3 text-sm font-semibold text-muted hover:text-ink">Agents <span class="ml-1 text-xs text-soft">{inventory.agents}</span></button>
            <button type="button" role="tab" aria-selected="false" aria-controls="panel-workflows" data-tab="workflows" class="detail-tab border-b-2 border-border px-4 py-3 text-sm font-semibold text-muted hover:text-ink">Workflows <span class="ml-1 text-xs text-soft">{inventory.workflows}</span></button>
            <button type="button" role="tab" aria-selected="false" aria-controls="panel-files" data-tab="files" class="detail-tab border-b-2 border-border px-4 py-3 text-sm font-semibold text-muted hover:text-ink">Files <span class="ml-1 text-xs text-soft">{data.files.length}</span></button>
          </div>
        </div>

        <section id="panel-overview" role="tabpanel" data-panel="overview" class="pt-7">
          {
            GuideContent ? (
              <article class="prose max-w-none prose-headings:tracking-tight"><GuideContent /></article>
            ) : (
              <div class="rounded-2xl border border-border bg-surface p-6">
                <h2 class="text-xl font-semibold text-ink">Inside this solution</h2>
                <p class="mt-3 leading-relaxed text-muted">{data.description}</p>
                <p class="mt-3 text-sm text-muted">Explore the Agents and Workflows tabs to inspect the generated architecture and saved workflow canvases.</p>
              </div>
            )
          }
        </section>

        <section id="panel-agents" role="tabpanel" data-panel="agents" class="hidden pt-7">
          {
            profiles.length ? (
              <>
                <div class="mb-5">
                  <h2 class="text-xl font-semibold text-ink">Agents and their components</h2>
                  <p class="mt-1 text-sm text-muted">The MCP servers, tools, and skills each agent uses, and which agents hand off to others. Hover a component for its description.</p>
                </div>
                <AgentMatrix agents={profiles} />
              </>
            ) : (
              <div class="rounded-2xl border border-dashed border-border bg-elevated px-6 py-14 text-center text-muted">No agents are included in this solution.</div>
            )
          }
        </section>

        <section id="panel-workflows" role="tabpanel" data-panel="workflows" class="hidden pt-7">
          <div class="mb-4">
            <h2 class="text-xl font-semibold text-ink">Workflow canvases</h2>
            <p class="mt-1 text-sm text-muted">These positions and connections come from the saved designer graph in the exported solution. Hover or select an agent step to see its components.</p>
          </div>
          <div class="grid gap-3 sm:hidden">
            {
              data.workflows.map((workflow) => (
                <article class="rounded-2xl border border-border bg-surface p-4 card-shadow">
                  <h3 class="font-semibold text-ink">{workflow.name}</h3>
                  <div class="mt-3 flex flex-wrap gap-3 text-xs text-muted">
                    {workflow.trigger && <span>Trigger: {workflow.trigger}</span>}
                    {workflowTriggerType(workflow) && <span>Type: {workflowTriggerType(workflow)}</span>}
                    <span>{workflow.nodeCount} steps</span>
                    <span>{workflow.edgeCount} connections</span>
                  </div>
                  {workflowConnectorNames(workflow).length > 0 && <p class="mt-2 text-xs text-muted">Connectors: {workflowConnectorNames(workflow).join(", ")}</p>}
                  {workflowMetadataNotice(workflow) && <p class="mt-2 text-xs leading-relaxed text-muted">{workflowMetadataNotice(workflow)}</p>}
                </article>
              ))
            }
          </div>
          <div class="hidden sm:block">
            <WorkflowExplorer workflows={data.workflows} agents={profiles} client:media="(min-width: 640px)" />
          </div>
        </section>

        <section id="panel-files" role="tabpanel" data-panel="files" class="hidden pt-7">
          <div class="rounded-2xl border border-border bg-surface p-5 card-shadow">
            <h2 class="text-xl font-semibold text-ink">Exploded solution manifest</h2>
            <p class="mt-2 text-sm leading-relaxed text-muted">The download rebuilds these submitted files at the ZIP root. Gallery metadata and the human-facing README are excluded.</p>
            <dl data-package-details class="mt-5 grid grid-cols-2 gap-x-6 gap-y-3 text-sm md:grid-cols-4">
              <div><dt class="text-xs text-soft">Solution</dt><dd class="mt-1 break-all text-ink">{data.uniqueName}</dd></div>
              <div><dt class="text-xs text-soft">Publisher</dt><dd class="mt-1 break-words text-ink">{data.publisher ?? "Not specified"}</dd></div>
              <div><dt class="text-xs text-soft">Version</dt><dd class="mt-1 text-ink">{data.version}</dd></div>
              <div><dt class="text-xs text-soft">Files</dt><dd class="mt-1 text-ink">{data.files.length}</dd></div>
            </dl>
            <div class="mt-5 flex flex-wrap gap-2">
              {categories.map(([category, count]) => <span class="rounded-full border border-border bg-surface-soft px-3 py-1 text-xs font-medium text-muted">{category}: {count}</span>)}
            </div>
            <div class="mt-5 max-h-[32rem] overflow-auto rounded-[0.625rem] border border-border bg-elevated">
              <table class="w-full border-collapse text-left text-sm">
                <thead class="sticky top-0 bg-elevated text-xs text-soft">
                  <tr><th class="px-3 py-2 font-semibold">Path</th><th class="px-3 py-2 font-semibold">Type</th><th class="px-3 py-2 text-right font-semibold">Size</th></tr>
                </thead>
                <tbody>
                  {data.files.map((file) => (
                    <tr class="border-t border-border">
                      <td class="max-w-0 break-all px-3 py-2 font-mono text-xs text-ink">{file.path}</td>
                      <td class="px-3 py-2 text-muted">{file.category}</td>
                      <td class="whitespace-nowrap px-3 py-2 text-right text-muted">{file.size.toLocaleString("en-US")} B</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        </section>
      </div>

      <aside data-download-sidebar class="hidden xl:sticky xl:top-20 xl:block xl:self-start">
        <SolutionDownload solution={data} idPrefix="sidebar-download" />
      </aside>
    </div>
  </div>
</Layout>

<script>
  import { agentAnchor } from "../../lib/inventory";

  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>(".detail-tab"));
  const panels = Array.from(document.querySelectorAll<HTMLElement>("[data-panel]"));
  const names = new Set(tabs.map((tab) => tab.dataset.tab ?? ""));

  function activate(name: string, updateHash = true) {
    if (!names.has(name)) name = "overview";
    tabs.forEach((tab) => {
      const active = tab.dataset.tab === name;
      tab.setAttribute("aria-selected", String(active));
      tab.classList.toggle("border-accent", active);
      tab.classList.toggle("text-accent", active);
      tab.classList.toggle("border-border", !active);
      tab.classList.toggle("text-muted", !active);
    });
    panels.forEach((panel) => panel.classList.toggle("hidden", panel.dataset.panel !== name));
    if (updateHash) history.replaceState(null, "", name === "overview" ? location.pathname : `#${name}`);
  }
  tabs.forEach((tab) => tab.addEventListener("click", () => activate(tab.dataset.tab ?? "overview")));

  function highlightAgent(anchor: string) {
    document.querySelectorAll<HTMLElement>(".agent-matrix__row[id]").forEach((profile) => {
      profile.toggleAttribute("data-highlight", profile.id === anchor);
    });
  }

  function showAgent(anchor: string, scroll: boolean) {
    activate("agents", false);
    highlightAgent(anchor);
    if (scroll) document.getElementById(anchor)?.scrollIntoView({ behavior: "smooth", block: "start" });
  }

  function syncFromHash() {
    const hash = location.hash.slice(1);
    if (hash.startsWith("agent-") && document.getElementById(hash)) showAgent(hash, false);
    else activate(hash || "overview", false);
  }

  window.addEventListener("gallery:show-agent", (event) => {
    const anchor = agentAnchor((event as CustomEvent<{ schemaName: string }>).detail?.schemaName ?? "");
    history.replaceState(null, "", `#${anchor}`);
    showAgent(anchor, true);
  });
  window.addEventListener("hashchange", syncFromHash);
  syncFromHash();
</script>
