        "name": "Log ticket",
        "type": "tool",
        "position": {
          "x": -282,
          "y": 324
        },
        "details": {
          "kind": "tool",
          "schemaName": "msftcat_ITSupportTranscriptDemo.tool.ITSupport-Logticket_hTs",
          "description": "Simulate logging an IT support ticket only when the user explicitly requests it, even if transcript capture is unavailable. No real internal system is called. Fill title and description; leave transcript and conversationId empty for the Pre tool use hook. Never fabricate transcript content. Report the returned simulated ticket ID, attachment status, and message; missing capture does not prevent ticket creation."
        }
      }
