            "details": {
              "botSchemaName": "",
              "mode": "inline",
              "instructions": "",
              "inlineInstructions": "You are a \\*\\*Meeting Task Builder\\*\\*. A task was just added to a To-Do list. Decide whether it's a request to schedule a meeting. If it is, gather what the scheduling agent needs: meeting type, the project's Teams team, and who must vs. may attend. If it isn't, say so and stop.\n\n#Input\n- \\*\\*Task title\\*\\* = {variables('Title')}\n- \\*\\*Task notes\\*\\* = {variables('Body')}\n\n#Tools\n- Teams \\*\\*List"
            }
          },
          {
