      {
        "id": "skill:cr4bd_calendarassistant_Ap7ncd.skill.agenda-suggester_0Jy",
        "name": "agenda-suggester",
        "type": "skill",
        "position": {
          "x": 908,
          "y": 323.99999999999994
        },
        "details": {
          "kind": "skill",
          "schemaName": "cr4bd_calendarassistant_Ap7ncd.skill.agenda-suggester_0Jy",
          "description": "Use when the user wants a meeting agenda proposed or improved, says an upcoming meeting has no agenda, or asks how to keep a meeting more focused. Do NOT use for a meeting that already has a detailed agenda the user is satisfied with."
        }
      },
      {
        "id": "skill:cr4bd_calendarassistant_Ap7ncd.skill.cancelled-meeting-handler_KM",
        "name": "cancelled-meeting-handler",
        "type": "skill",
        "position": {
          "x": 568,
          "y": 323.99999999999994
        },
        "details": {
          "kind": "skill",
          "schemaName": "cr4bd_calendarassistant_Ap7ncd.skill.cancelled-meeting-handler_KM-",
          "description": "Use when a calendar meeting has been cancelled and the user wants participants notified, or wants a follow-up meeting/agenda proposed to replace it. Do NOT use for a meeting the user is actively cancelling right now with no notification or follow-up requested — in that case just cancel it."
        }
      },
      {
        "id": "skill:cr4bd_calendarassistant_Ap7ncd.skill.conflict-resolution_5Kq",
        "name": "conflict-resolution",
        "type": "skill",
        "position": {
          "x": 228,
          "y": 324
        },
        "details": {
          "kind": "skill",
          "schemaName": "cr4bd_calendarassistant_Ap7ncd.skill.conflict-resolution_5Kq",
          "description": "Use when the user asks about scheduling conflicts, double-booked or overlapping meetings, back-to-back meetings with no buffer, or wants help rescheduling a meeting to avoid a clash. Do NOT use for a simple request to move a single meeting to a specific, already-known new time with no conflict involved."
        }
      },
      {
        "id": "skill:cr4bd_calendarassistant_Ap7ncd.skill.rsvp-tracker_FlD",
        "name": "rsvp-tracker",
        "type": "skill",
        "position": {
          "x": -111.99999999999997,
          "y": 324
        },
        "details": {
          "kind": "skill",
          "schemaName": "cr4bd_calendarassistant_Ap7ncd.skill.rsvp-tracker_FlD",
          "description": "Use when the user asks which meetings they (or their invitees) haven't RSVP'd to yet, wants to see events with no response, or wants RSVP reminders sent to attendees who haven't responded. Do NOT use for a meeting where the user is simply asking to accept or decline it themselves right now with no listing or reminder involved."
        }
      },
      {
        "id": "skill:cr4bd_calendarassistant_Ap7ncd.skill.summarize-meetings_6u4",
        "name": "summarize-meetings",
        "type": "skill",
        "position": {
          "x": -452,
          "y": 324
        },
        "details": {
          "kind": "skill",
          "schemaName": "cr4bd_calendarassistant_Ap7ncd.skill.summarize-meetings_6u4",
          "description": "Use when the user asks to summarize a meeting or several meetings, wants the key decisions from a meeting, or wants a list of action items from a meeting. Do NOT use for a raw list of upcoming events with no summarization ask."
        }
      },
