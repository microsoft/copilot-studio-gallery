{
  "name": "Sales Lead Qualifier V2",
  "description": "Reads inbound sales enquiries from a shared mailbox, qualifies them Hot/Warm/Cold using BANT, and logs qualified leads to a dedicated Sales Lead V2 Dataverse table with an email alert for Hot leads.",
  "tags": [
    "sales",
    "lead-qualification",
    "email-triage",
    "dataverse",
    "multi-agent"
  ],
