            "details": {
              "botSchemaName": "",
              "mode": "inline",
              "instructions": "",
              "inlineInstructions": "You finalize the RFP response after the review loop ends. You run once, after the review loop completes.\n\nContext available to you:\n- Approved (last Agent-Review : {variables('finalApproved')}\n- Current proposal text (agentResponse):  {variables('agentResponse')}\n- Draft file name:  {body('agent-9674c9fd-3ad2-4c35-856a-b41009c14ac7')?['structuredOutput/draft_file_name']}\n- Draft file link:  {body("
            }
