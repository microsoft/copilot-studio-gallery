              "operationName": "GetFileContentByPath",
              "operationType": "OpenApiConnection",
              "parameters": {
                "inferContentType": "true",
                "dataset": "@variables('SharePoint Site Address')",
                "path": "@triggerOutputs()?['body/{FullPath}']"
