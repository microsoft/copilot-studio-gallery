            "details": {
              "botSchemaName": "",
              "mode": "inline",
              "instructions": "",
              "inlineInstructions": "You are the Drafting Agent for the RFP Response Manager. You run after the Extraction Agent and own both writing the proposal AND saving it to SharePoint yourself using your own tools - there is no separate file-creation step in this workflow.\n\nINPUT\nThe RFP document text extracted by the Extraction Agent is provided below. If it is empty or the Extraction Agent noted a failure reading the source "
            }
          },
          {
            "id": "variable-4ad6bd6b-5c7b-4f85-9851-877306c3cb98",
            "name": "Customisation Variables",
            "type": "variable",
            "position": {
              "x": 478,
              "y": 454.5
            },
            "details": {}
          },
          {
            "id": "variable-bb898e35-ad33-4bda-842d-b2d4bbc1988f",
            "name": "Workflow Variables",
            "type": "variable",
            "position": {
              "x": 761,
              "y": 454.5
            },
            "details": {}
          },
          {
            "id": "loop-1ad66f7a-ed59-46bb-a527-2dc60324015b",
            "name": "Loop",
            "type": "loop",
            "position": {
              "x": 2184,
              "y": 300
            },
            "details": {
              "expression": "@equals(variables('maxIterations'),variables('tempItr'))"
            }
          },
          {
            "id": "connector-e16d400b-b0a4-45be-b0ad-d25b2c73c1fd",
            "name": "Ask for human review",
            "type": "connector",
            "position": {
              "x": 60,
              "y": 80
            },
            "details": {
              "displayName": "Human review",
              "apiName": "shared_advancedapprovals",
              "operationName": "RequestForInformation",
              "operationType": "OpenApiConnectionWebhook",
              "parameters": {
                "RequestForInformationInput/channel": "Teams",
                "RequestForInformationInput/title": "Validate the draft proposal to @{triggerOutputs()?['body/{Name}']} \n",
                "RequestForInformationInput/message": "The draft proposal for  your request is ready for review. View it here: @{body('agent-9674c9fd-3ad2-4c35-856a-b41009c14ac7')?['structuredOutput/draft_file_link']} ",
                "RequestForInformationInput/assignedTo": "@variables('approverAlias')"
              }
            }
          },
          {
            "id": "canvasNote-3f8e3ac3-bd4a-4556-938e-bfad43cd7a28",
            "name": "Note",
            "type": "canvasNote",
            "position": {
              "x": 128.05566385757186,
              "y": 700.6300980465007
            },
            "details": {
              "markdown": "Gets triggered whenever a file is created in the specified SharePoint location",
              "color": "yellow"
            }
          },
          {
            "id": "canvasNote-bd609a2b-3343-46a0-998e-6ffc790c5787",
            "name": "Note 2",
            "type": "canvasNote",
            "position": {
              "x": 485.31163090145594,
              "y": 698.360157411663
            },
            "details": {
              "markdown": "Update these variables before running:\n1. Alias of the approver/reviewer\n\n2. SharePoint Folder draft: Folder to store draft proposals. Ex: /Shared Documents/RFP Response Manager/Proposal Draft\n\n3. SharePoint Folder Final: Folder to store final proposals. Ex: /Shared Documents/RFP Response Manager/Proposal Final\n\n4. maxIterations: Maximum number of iterations with the agent to refine the proposal d",
              "color": "yellow"
            }
          },
          {
            "id": "canvasNote-583985c1-b82e-4071-8033-c5beeb7d6886",
            "name": "Note 2 2",
            "type": "canvasNote",
            "position": {
