      {
        "id": "skill:crf9c_salesanalyser_WEs93i.skill.newsletter-style-email-composer_4LB",
        "name": "newsletter-style-email-composer",
        "type": "skill",
        "position": {
          "x": 568,
          "y": 323.99999999999994
        },
        "details": {
          "kind": "skill",
          "schemaName": "crf9c_salesanalyser_WEs93i.skill.newsletter-style-email-composer_4LB",
          "description": "Use when the user asks to email a report, findings, or metrics to someone as a polished, newsletter-style message. Builds an Outlook-safe HTML email from figures that already exist (headline, KPI tiles, up to two bar charts drawn with HTML table cells so they render in classic Outlook, Gmail and dark mode, short findings, data notes and the non-audit disclaimer) using the shared brand tokens, attaches the PDF report, and creates a draft for the user to review. Do NOT use for a short plain-text status update, or for building the underlying analysis, charts, or report itself -- this skill only composes the email."
        }
      },
      {
        "id": "skill:crf9c_salesanalyser_WEs93i.skill.polished-report-builder_TUr",
        "name": "polished-report-builder",
        "type": "skill",
        "position": {
          "x": 228,
          "y": 324
        },
        "details": {
          "kind": "skill",
          "schemaName": "crf9c_salesanalyser_WEs93i.skill.polished-report-builder_TUr",
          "description": "Use when the user asks to turn analysis results, metrics, or findings into a polished, presentation-ready report, one-pager, or executive summary -- especially when existing analysis (e.g. from the spreadsheet analysis skill) needs to become a document someone will actually read. Builds a branded PDF with reportlab from a short content file (headline, KPI tiles, one chart per point, data notes and the non-audit disclaimer) using the shared brand tokens, and runs a QA pass before delivery to catch walls of text, chart clutter, low-resolution charts, missing data notes or poor contrast. Do NOT use for a quick inline chat answer, a single ad-hoc chart with no report structure around it, a raw data export with no narrative, or to compute the figures themselves."
        }
      },
      {
        "id": "skill:crf9c_salesanalyser_WEs93i.skill.spreadsheet-data-analysis-reporting_dHq",
        "name": "spreadsheet-data-analysis-reporting",
        "type": "skill",
        "position": {
          "x": -111.99999999999997,
          "y": 324
        },
        "details": {
          "kind": "skill",
          "schemaName": "crf9c_salesanalyser_WEs93i.skill.spreadsheet-data-analysis-reporting_dHq",
          "description": "Use for any request that needs figures from the sales spreadsheets (Excel/CSV), even a single file or a single period - e.g. 'analyse Q4', 'how did sales do last month', 'compare regions', YoY/MoM/QoQ/YTD growth, top products, share of revenue, trends, outliers, currency-converted totals, or building/updating a consolidated master file. Finds and loads the relevant files, cleans and normalises them, computes metrics with standard definitions and edge-case handling, flags outliers and data issues, explains every transformation, and produces on-brand charts. Use this before the report or email skills whenever numbers must be computed. Do NOT use for questions that need no data (e.g. 'what does YoY mean') or for re-formatting results already computed in this conversation."
        }
      },
