            "details": {
              "markdown": "If ShouldNotify is True: gates purely on Lead Agent's own ShouldNotify field. Skips Notifier Agent entirely unless Tier was Hot — no AI call spent on Warm/Cold/Filtered leads.\n",
              "color": "yellow"
            }
          }
