            "details": {
              "markdown": "If Tier is not Filtered: gates purely on Classifier Agent's own Tier field. Skips Lead Agent entirely when Tier is Filtered — no second AI call, no record, no notification for non-genuine enquiries.\n",
              "color": "yellow"
            }
          },
          {
            "id": "canvasNote-adf1c3f1-32b1-4240-810c-09e06a517819",
