            },
            "details": {}
          },
          {
            "id": "connector-fe718f35-4320-45c4-a624-ddd4b4594be4",
            "name": "Add a new row",
            "type": "connector",
            "position": {
              "x": 1390.5218851954064,
              "y": 117.73741744722491
            },
            "details": {
              "displayName": "Microsoft Dataverse",
              "apiName": "shared_commondataserviceforapps",
              "operationName": "CreateRecord",
              "operationType": "OpenApiConnection",
              "parameters": {
                "entityName": "@variables('InvoiceTableName')",
                "item": "@json(concat('{\"a3p_amountdue\":', string(body('Ledger_Agent')?['structuredOutput/AmountDue']), ',\"a3p_attachmentname\":\"', body('Ledger_Agent')?['structuredOutput/AttachmentName'], '\",\"a3p_currency\":\"', body('Ledger_Agent')?['structuredOutput/Currency'], '\",\"a3p_duplicateof\":\"', if(equals(body('Ledger_Agent')?['structuredOutput/DuplicateOf'], 'null'), '', body('Ledger_Agent')?['structuredOutput/Dup"
              }
            }
          },
          {
            "id": "canvasNote-6bb65c2e-8112-4809-8a00-e295ecb27659",
            "name": "Note 7",
            "type": "canvasNote",
            "position": {
              "x": 1387.6299985505846,
              "y": 629.4732095133228
            },
            "details": {
              "markdown": "List rows: plain connector step - queries the configured table for existing rows matching this invoice's number, feeding Ledger Agent's duplicate check. ",
              "color": "yellow"
            }
          },
          {
            "id": "canvasNote-c65b7ca9-7179-47e6-8707-bf8b6a70ac48",
