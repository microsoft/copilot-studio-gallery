{
  "submissionType": "managed-app",
  "name": "Mind Map Monkey",
  "description": "Create, edit and share mind maps stored as Mermaid files in OneDrive for Business.",
  "tags": [
    "managed-app",
    "mind-mapping",
    "onedrive",
    "mermaid"
  ],
  "category": "Productivity & knowledge",
  "featured": false,
