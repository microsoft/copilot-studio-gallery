      "github": "scottdurow"
    }
  ],
  "version": "1.2.1",
  "app": {
    "prerequisites": [
      "Access to Copilot Managed Runtime app creation in an eligible environment. Tenant licensing and connector policies apply.",
      "A OneDrive for Business account with permission to list, read, create, update, move and delete files in the folders used by the app.",
      "Windows PowerShell 5.1+ or macOS Bash, Node.js 24.11 or later, npm, Git 2.27 or later, and Git Credential Manager."
    ],
    "connectors": [
      {
        "connector": "shared_onedriveforbusiness",
        "mode": "action",
        "dataSource": "onedriveforbusiness",
        "instructions": "Choose your own OneDrive for Business connection using the native CLI. The app lists folders and reads and writes Mermaid files. It also creates, moves and deletes temporary lock files beside maps when coordinating saves.",
        "columns": []
      }
    ]
  },
