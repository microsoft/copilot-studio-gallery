      {
        "id": "skill:cred7_inventoryforecastingagent2_bVSobs.skill.inventory-forecast_qZ_",
        "name": "inventory-forecast",
        "type": "skill",
        "position": {
          "x": 738,
          "y": 323.99999999999994
        },
        "details": {
          "kind": "skill",
          "schemaName": "cred7_inventoryforecastingagent2_bVSobs.skill.inventory-forecast_qZ_",
          "description": "Forecasts retail product demand by store, SKU, category, week or season from weather, upcoming local events, U.S. federal public holidays and historical sales boost, compares it with verified current stock, and recommends reorder quantities with unit cost, total cost, sales at risk and risk level. Produces a PDF report with charts and drafts or sends an HTML email. Use when a retail manager asks what stock to prepare for a weekend, week, holiday period or season, whether stock is enough, which items sold best in similar conditions, which events or holidays will affect demand, or wants a forecast, reorder, stock-gap or inventory report by store, item or category. Not for sales reporting with no forecast, and not for products outside the SKU catalog."
        }
      },
      {
        "id": "skill:cred7_inventoryforecastingagent2_bVSobs.skill.local-events-search_sU2",
        "name": "local-events-search",
        "type": "skill",
        "position": {
          "x": 398,
          "y": 323.99999999999994
        },
        "details": {
          "kind": "skill",
          "schemaName": "cred7_inventoryforecastingagent2_bVSobs.skill.local-events-search_sU2",
          "description": "Searches the web for upcoming sporting events, large concerts, local festivals and U.S. federal public holidays in a store's city for a forecast window, shows them with dates and sources, asks the user to confirm events, and passes confirmed events and the holidays to the forecast. Use at the start of an inventory forecast, or when a retail manager asks about upcoming events, games, concerts, holidays or what is happening near a store, because Event Data may be out of date and has no holiday information. Not for stock, prices, costs, baseline demand or sales boosts, which always come from Dataverse."
        }
      },
