---
interface Props {
  size?: "sm" | "md";
  class?: string;
}

const { size = "sm", class: className } = Astro.props;
---

<span
  class:list={[
    "inline-flex shrink-0 items-center gap-1.5 rounded-full border border-border bg-surface font-semibold text-ink",
    size === "sm" ? "px-2.5 py-1 text-[11px]" : "px-3 py-1.5 text-xs",
    className,
  ]}
  title="Built by Microsoft"
>
  <svg viewBox="0 0 23 23" class={size === "sm" ? "h-3 w-3" : "h-3.5 w-3.5"} aria-hidden="true">
    <path fill="#f25022" d="M1 1h10v10H1z"></path>
    <path fill="#7fba00" d="M12 1h10v10H12z"></path>
    <path fill="#00a4ef" d="M1 12h10v10H1z"></path>
    <path fill="#ffb900" d="M12 12h10v10H12z"></path>
  </svg>
  Built by Microsoft
</span>
