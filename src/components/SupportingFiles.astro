---
import type { SupportingFile } from "../lib/schema";
import { withBase } from "../lib/url";

interface Props { files: SupportingFile[] }
const { files } = Astro.props;
---

{files.length > 0 && (
  <section class="mt-7 rounded-xl border border-border bg-surface p-5" aria-label="Supporting files">
    <h2 class="text-lg font-semibold">Supporting files</h2>
    <ul class="mt-3 space-y-3">
      {files.map((file) => (
        <li class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
          <a href={withBase(`/${file.path}`)} download={file.filename} class="min-w-0 break-words text-sm font-semibold text-accent hover:underline">{file.label}</a>
          <span class="text-xs text-muted">{file.filename.split(".").at(-1)?.toUpperCase()} · {file.size.toLocaleString("en-US")} B</span>
        </li>
      ))}
    </ul>
  </section>
)}
